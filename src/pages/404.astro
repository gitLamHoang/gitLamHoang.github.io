---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Epigraph from '../components/Epigraph.astro';
import still from '../assets/harp/film-end.jpg';
---

<Base title="Page not found">
  <section class="lost" aria-labelledby="lost-title">
    <Image class="still" src={still} alt="" widths={[960, 1600]} sizes="100vw" loading="eager" />
    <div class="card">
      <h1 id="lost-title">No waypoint here.</h1>
      <p>This page does not exist. The link may be old or mistyped.</p>
      <Epigraph quote="notFound" />
      <a class="btn btn-primary" href="/">Back to the start</a>
    </div>
  </section>
</Base>

<style>
  .lost {
    position: relative;
    display: grid;
    min-height: calc(100svh - 64px);
    padding: clamp(32px, 6vw, 80px) var(--margin);
    overflow: hidden;
  }

  .still {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 50%;
  }

  .card {
    position: relative;
    align-self: end;
    display: grid;
    gap: 20px;
    justify-items: start;
    width: min(100%, 30rem);
    padding: clamp(24px, 3vw, 36px);
    background: var(--bg);
  }

  h1 {
    font-size: var(--step-head);
  }
</style>
