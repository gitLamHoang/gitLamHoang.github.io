---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Epigraph from '../components/Epigraph.astro';
import still from '../assets/harp/film-end.jpg';
---

<Base title="Page not found">
  <section class="lost" aria-labelledby="lost-title">
    <Image class="still" src={still} alt="" widths={[960, 1600]} sizes="100vw" loading="eager" />
    <div class="card panel">
      <h1 id="lost-title" class="heading-2 hero-gradient">No waypoint here.</h1>
      <p class="title-2 text-2">This page does not exist. The link may be old or mistyped.</p>
      <Epigraph quote="notFound" />
      <a class="btn btn-primary" href="/">Back to the start</a>
    </div>
  </section>
</Base>

<style>
  .lost {
    position: relative;
    display: grid;
    place-items: end start;
    min-height: 100dvh;
    padding: calc(var(--space-900) + var(--space-600)) var(--gutter) var(--gutter);
    overflow: hidden;
  }

  .still {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 50%;
    opacity: 0.55;
  }

  .card {
    position: relative;
    display: grid;
    gap: var(--space-300);
    justify-items: start;
    width: min(100%, 34rem);
    padding: var(--space-400);
  }
</style>
