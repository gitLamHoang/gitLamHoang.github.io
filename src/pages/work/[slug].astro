---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Marked from '../../components/Marked.astro';
import RouteField from '../../components/RouteField.astro';
import HeroVideo from '../../components/HeroVideo.astro';
import Pipeline from '../../components/Pipeline.astro';
import RunExplorer from '../../components/RunExplorer.astro';

export async function getStaticPaths() {
  const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: work[(i - 1 + work.length) % work.length],
      next: work[(i + 1) % work.length],
    },
  }));
}

interface Props {
  entry: CollectionEntry<'work'>;
  prev: CollectionEntry<'work'>;
  next: CollectionEntry<'work'>;
}

const { entry, prev, next } = Astro.props;
const { title, summary, org, role, dates, stack, overview, contribution, claim, result, highlight, limit, specs, links, figure, showcase } =
  entry.data;
const { Content } = await render(entry);
---

<Base title={title} description={summary}>
  <article class="project wrap">
    <p class="back ui"><a href="/#work">All work</a></p>

    <header class="row project-head">
      <div>
        <p class="kicker">{org}</p>
        <h1>{title}</h1>
        <p class="summary">{summary}</p>
      </div>
      <div class="facts ui">
        <p>{role}</p>
        <p class="quiet">{dates}</p>
        {stack && <p class="quiet stack">{stack.join(', ')}</p>}
      </div>
    </header>

    {
      showcase === 'harp' && (
        <div class="figure">
          <HeroVideo />
        </div>
      )
    }

    <div class="row intro-block">
      <div class="measure">
        <h2 class="h-sub">The project</h2>
        <p>{overview}</p>
        <h2 class="h-sub">My part</h2>
        <p>{contribution}</p>
      </div>
      {
        specs && (
          <dl class="specs side-specs">
            {specs.map((sp) => (
              <div>
                <dt>{sp.label}</dt>
                <dd>{sp.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>

    <div class="row ledger">
      <dl class="triple">
        <div>
          <dt>Claim</dt>
          <dd>{claim}</dd>
        </div>
        <div>
          <dt>Result</dt>
          <dd><Marked text={result} highlight={highlight} /></dd>
        </div>
      </dl>
      <p class="limit"><span class="limit-label">Limit</span>{' '}{limit}</p>
    </div>

    {
      links.length > 0 && (
        <ul class="link-row project-links">
          {links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))}
        </ul>
      )
    }

    {
      showcase === 'harp' && (
        <>
          <div class="figure">
            <h2 class="h-sub">How the controller decides</h2>
            <Pipeline />
          </div>
          <div class="figure">
            <h2 class="h-sub">Scrub the recorded run</h2>
            <RunExplorer />
          </div>
        </>
      )
    }

    {
      figure && (
        <figure class="figure shot">
          {figure.href ? (
            <a href={figure.href} class="shot-link">
              <Image src={figure.src} alt={figure.alt} widths={[640, 960, 1280]} sizes="(max-width: 1200px) 100vw, 1100px" />
            </a>
          ) : (
            <Image src={figure.src} alt={figure.alt} widths={[640, 960, 1280]} sizes="(max-width: 1200px) 100vw, 1100px" />
          )}
          <figcaption class="quiet">{figure.caption}</figcaption>
        </figure>
      )
    }

    <div class="prose">
      <Content />
    </div>

    {
      showcase === 'harp' && (
        <div class="figure">
          <h2 class="h-sub">Earlier work, in the browser: waypoint laps and takeover</h2>
          <p class="measure demo-note">
            A small browser model of the behavior from PRs #2, #5, and #6: repeated laps over a waypoint route, speed that ramps up and
            slows into each target, and a takeover that stops at once. Click the floor to add waypoints.
          </p>
          <RouteField id={`${entry.id}-route`} />
        </div>
      )
    }

    <nav class="pager ui" aria-label="More work">
      <a href={`/work/${prev.id}/`} rel="prev"><span class="quiet">Previous</span>{prev.data.title}</a>
      <a href={`/work/${next.id}/`} rel="next" class="next"><span class="quiet">Next</span>{next.data.title}</a>
    </nav>
  </article>
</Base>

<style>
  .project {
    padding-top: clamp(20px, 4vw, 40px);
  }

  .back {
    font-size: 1.0625rem;
    font-weight: 500;
  }

  .back a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .project-head {
    align-items: end;
    margin-top: 12px;
  }

  .project-head .kicker {
    margin-bottom: 10px;
  }

  .h-sub {
    margin: 0 0 12px;
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
  }

  .intro-block {
    margin-top: 40px;
    row-gap: 20px;
  }

  .intro-block p + .h-sub {
    margin-top: 28px;
  }

  .side-specs {
    grid-template-columns: minmax(0, 1fr);
    align-self: start;
  }

  .demo-note {
    margin-bottom: 16px;
    color: var(--ink-soft);
  }

  h1 {
    font-size: clamp(2.25rem, 5.6vw, 4rem);
    line-height: 0.98;
    letter-spacing: -0.015em;
  }

  .summary {
    margin-top: 16px;
    max-width: 52ch;
    font-size: clamp(1.1875rem, 2vw, 1.375rem);
    line-height: 1.45;
  }

  .facts {
    font-size: 1.0625rem;
    line-height: 1.45;
  }

  .stack {
    margin-top: 6px;
  }

  @media (max-width: 900px) {
    .facts {
      margin-top: 18px;
    }
  }

  .ledger {
    margin-top: 36px;
    padding: 24px 0;
    border-block: 1.5px solid var(--ink);
    row-gap: 16px;
  }

  .triple {
    display: grid;
    gap: 12px;
    max-width: 66ch;
  }

  .triple div {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 12px;
  }

  dt {
    padding-top: 0.2em;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 1rem;
    color: var(--graphite);
  }

  dd {
    margin: 0;
    font-size: 1.1875rem;
  }

  .project-links {
    margin-top: 12px;
  }

  .figure {
    margin-top: 40px;
  }

  .shot img {
    width: 100%;
    max-height: 760px;
    object-fit: cover;
    object-position: top;
    border: 1.5px solid var(--ink);
    border-radius: var(--radius);
    background: #fff;
  }

  .shot figcaption {
    margin-top: 10px;
    font-size: 0.9375rem;
  }

  .prose {
    max-width: 68ch;
    margin-top: 16px;
  }

  .prose :global(h2) {
    margin-top: 48px;
    font-size: clamp(1.5rem, 2.8vw, 2rem);
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(table) {
    margin-top: 14px;
  }

  .prose :global(ul) {
    padding-left: 1.2em;
  }

  .prose :global(li + li) {
    margin-top: 8px;
  }

  .prose :global(li::marker) {
    color: var(--graphite);
  }

  .prose :global(strong) {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 1.0625em;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 1rem;
    line-height: 1.45;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 10px 16px 10px 0;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--grid);
  }

  .prose :global(th) {
    font-family: var(--font-ui);
    font-weight: 600;
    color: var(--graphite);
    border-bottom: 1.5px solid var(--ink);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 72px;
    padding-top: 24px;
    border-top: 1.5px solid var(--ink);
    font-size: 1.125rem;
    font-weight: 600;
  }

  .pager a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    min-height: 44px;
  }

  .pager a:hover {
    text-decoration: underline;
  }

  .pager span {
    font-weight: 500;
    font-size: 1rem;
  }

  .pager .next {
    text-align: right;
  }

  @media (max-width: 640px) {
    /* Let wide tables scroll instead of crushing their columns. */
    .prose :global(table) {
      display: block;
      overflow-x: auto;
    }

    .prose :global(th),
    .prose :global(td) {
      min-width: 9rem;
    }
  }

  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
    }

    .pager .next {
      text-align: left;
    }

    .triple div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
  }
</style>
