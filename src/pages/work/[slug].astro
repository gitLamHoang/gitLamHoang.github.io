---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Marked from '../../components/Marked.astro';
import HeroVideo from '../../components/HeroVideo.astro';
import Pipeline from '../../components/Pipeline.astro';

export async function getStaticPaths() {
  const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: work[(i - 1 + work.length) % work.length],
      next: work[(i + 1) % work.length],
    },
  }));
}

interface Props {
  entry: CollectionEntry<'work'>;
  prev: CollectionEntry<'work'>;
  next: CollectionEntry<'work'>;
}

const { entry, prev, next } = Astro.props;
const { title, summary, org, role, dates, stack, overview, contribution, claim, result, highlight, limit, specs, links, figure, showcase } =
  entry.data;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
---

<Base title={title} description={summary} image={`/og/${entry.id}.png`}>
  <article class="project wrap">
    <p class="back"><a href="/#work">All work</a></p>

    <header class="project-head" data-enter>
      <h1 style={`view-transition-name: title-${entry.id}`}>{title}</h1>
      <p class="summary">{summary}</p>
      <p class="facts">
        {org}. {role}, {dates}{stack && <span class="stack">. {stack.join(', ')}</span>}
      </p>
    </header>

    {
      showcase === 'harp' && (
        <div class="figure">
          <HeroVideo />
        </div>
      )
    }

    {
      figure && (
        <figure class="figure shot" style={`view-transition-name: figure-${entry.id}`}>
          {figure.href ? (
            <a href={figure.href} class="shot-link">
              <Image src={figure.src} alt={figure.alt} widths={[640, 960, 1280, 1600]} sizes="(max-width: 1440px) 100vw, 1376px" />
            </a>
          ) : (
            <Image src={figure.src} alt={figure.alt} widths={[640, 960, 1280, 1600]} sizes="(max-width: 1440px) 100vw, 1376px" />
          )}
          <figcaption>{figure.caption}</figcaption>
        </figure>
      )
    }

    <div class="intro-block">
      <div class="measure" data-enter>
        <h2 class="h-sub">The project</h2>
        <p>{overview}</p>
        <h2 class="h-sub">My part</h2>
        <p>{contribution}</p>
      </div>
      {
        specs && (
          <dl class="specs side-specs" data-enter>
            {specs.map((sp) => (
              <div>
                <dt>{sp.label}</dt>
                <dd>{sp.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>

    <dl class="evidence" data-enter>
      <div>
        <dt>Claim</dt>
        <dd>{claim}</dd>
      </div>
      <div>
        <dt>Result</dt>
        <dd><Marked text={result} highlight={highlight} /></dd>
      </div>
      <div>
        <dt>Limit</dt>
        <dd>{limit}</dd>
      </div>
    </dl>

    {
      links.length > 0 && (
        <ul class="link-row project-links">
          {links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))}
        </ul>
      )
    }

    {
      showcase === 'harp' && (
        <div class="figure">
          <h2 class="h-sub">How the controller decides</h2>
          <Pipeline />
          <p class="lab-link"><a class="btn" href="/lab/">Open the crowd lab</a></p>
        </div>
      )
    }

    <div class="prose-grid">
      <div class="prose">
        <Content />
      </div>
      {
        toc.length > 1 && (
          <nav class="toc" aria-label="On this page" data-toc>
            <p class="toc-title">On this page</p>
            <ul>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>

    <nav class="pager" aria-label="More work">
      <a href={`/work/${prev.id}/`} rel="prev"><span>Previous</span>{prev.data.title}</a>
      <a href={`/work/${next.id}/`} rel="next" class="next"><span>Next</span>{next.data.title}</a>
    </nav>
  </article>
</Base>

<script>
  // Mark the section being read in the table of contents.
  const toc = document.querySelector('[data-toc]');
  if (toc) {
    const links = new Map(
      [...toc.querySelectorAll<HTMLAnchorElement>('a')].map((a) => [decodeURIComponent(a.hash.slice(1)), a]),
    );
    const heads = [...links.keys()].map((id) => document.getElementById(id)).filter((h): h is HTMLElement => !!h);
    const mark = () => {
      let current = heads[0];
      for (const h of heads) if (h.getBoundingClientRect().top < window.innerHeight * 0.35) current = h;
      for (const [id, a] of links) a.toggleAttribute('aria-current', id === current?.id);
    };
    let queued = false;
    window.addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          mark();
        });
      },
      { passive: true },
    );
    mark();
  }
</script>

<style>
  .project {
    padding-top: clamp(16px, 3vw, 32px);
  }

  .back {
    font-size: var(--step-small);
    font-weight: 500;
  }

  .back a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .project-head {
    display: grid;
    gap: 18px;
    margin-top: clamp(24px, 4vw, 56px);
  }

  h1 {
    max-width: 18ch;
    font-size: var(--step-head);
    line-height: 0.98;
  }

  .summary {
    max-width: 48ch;
    font-size: var(--step-lead);
    line-height: 1.3;
  }

  .facts {
    color: var(--muted);
    font-size: var(--step-small);
  }

  .figure {
    margin-top: clamp(48px, 6vw, 88px);
  }

  .shot img {
    width: 100%;
    max-height: 820px;
    object-fit: cover;
    object-position: top;
    background: #fff;
  }

  .shot figcaption {
    margin-top: 14px;
    color: var(--muted);
    font-size: var(--step-small);
  }

  .h-sub {
    margin: 0 0 14px;
    font-size: var(--step-lead);
    letter-spacing: -0.02em;
  }

  .intro-block {
    display: grid;
    grid-template-columns: minmax(0, 68ch) minmax(0, 22rem);
    justify-content: space-between;
    gap: 48px;
    margin-top: clamp(56px, 7vw, 104px);
  }

  .intro-block p + .h-sub {
    margin-top: 40px;
  }

  .side-specs {
    grid-template-columns: minmax(0, 1fr);
    align-self: start;
    padding: 24px;
    background: var(--surface);
  }

  .evidence {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px clamp(24px, 3vw, 48px);
    margin: clamp(48px, 6vw, 88px) 0 0;
    padding: clamp(24px, 3vw, 40px);
    background: var(--surface);
  }

  .evidence dt {
    color: var(--muted);
    font-size: var(--step-small);
    font-weight: 500;
  }

  .evidence dd {
    margin: 6px 0 0;
  }

  .project-links {
    margin-top: 16px;
  }

  .lab-link {
    margin-top: 20px;
  }

  @media (max-width: 1000px) {
    .intro-block,
    .evidence {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---------- the write-up and its contents ---------- */

  .prose-grid {
    display: grid;
    grid-template-columns: minmax(0, 68ch) minmax(0, 15rem);
    justify-content: space-between;
    gap: 48px;
    align-items: start;
    margin-top: clamp(40px, 5vw, 72px);
  }

  .prose {
    max-width: 68ch;
  }

  .prose :global(h2) {
    margin-top: 64px;
    font-size: var(--step-lead);
    letter-spacing: -0.02em;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(table) {
    margin-top: 16px;
  }

  .prose :global(ul) {
    padding-left: 1.2em;
  }

  .prose :global(li + li) {
    margin-top: 8px;
  }

  .prose :global(li::marker) {
    color: var(--muted);
  }

  .prose :global(strong) {
    font-weight: 600;
  }

  /* Real tables keep quiet row lines. */
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step-small);
    font-variant-numeric: lining-nums tabular-nums;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 12px 16px 12px 0;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--grid);
  }

  .prose :global(th) {
    color: var(--muted);
    font-weight: 500;
  }

  .toc {
    position: sticky;
    top: 96px;
  }

  .toc-title {
    color: var(--muted);
    font-size: var(--step-small);
    font-weight: 500;
  }

  .toc ul {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  .toc a {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
    font-size: var(--step-small);
    font-weight: 500;
    line-height: 1.3;
    text-decoration: none;
    transition: color var(--dur-ui) ease;
  }

  .toc a[aria-current] {
    color: var(--ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .toc a:hover {
      color: var(--ink);
    }
  }

  @media (max-width: 1000px) {
    .prose-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .toc {
      display: none;
    }
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: var(--section);
  }

  .pager a {
    display: grid;
    gap: 6px;
    padding: clamp(20px, 3vw, 36px);
    background: var(--surface);
    font-size: var(--step-lead);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    text-decoration: none;
    transition: background-color var(--dur-ui) ease;
  }

  .pager span {
    color: var(--muted);
    font-size: var(--step-small);
    font-weight: 500;
    letter-spacing: 0;
  }

  .pager .next {
    text-align: right;
  }

  @media (hover: hover) and (pointer: fine) {
    .pager a:hover {
      background: var(--surface-2);
    }
  }

  @media (max-width: 640px) {
    .prose :global(table) {
      display: block;
      overflow-x: auto;
    }

    .prose :global(th),
    .prose :global(td) {
      min-width: 9rem;
    }

    .pager {
      grid-template-columns: 1fr;
    }

    .pager .next {
      text-align: left;
    }
  }
</style>
