---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Marked from '../../components/Marked.astro';
import HeroVideo from '../../components/HeroVideo.astro';
import Icon from '../../components/Icon.astro';
import Pipeline from '../../components/Pipeline.astro';

export async function getStaticPaths() {
  const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: work[(i - 1 + work.length) % work.length],
      next: work[(i + 1) % work.length],
    },
  }));
}

interface Props {
  entry: CollectionEntry<'work'>;
  prev: CollectionEntry<'work'>;
  next: CollectionEntry<'work'>;
}

const { entry, prev, next } = Astro.props;
const { title, summary, org, role, dates, stack, overview, contribution, claim, result, highlight, stat, limit, specs, links, figure, showcase } =
  entry.data;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
---

<Base title={title} description={summary} image={`/og/${entry.id}.png`}>
  <article class="project wrap">
    <header class="project-head">
      <h1 class="heading-2 hero-gradient">{title}</h1>
      <p class="summary title-1 text-2">{summary}</p>
      <p class="facts caption-2 text-2">
        {org}. {role}, {dates}{stack && <span class="stack">. {stack.join(', ')}</span>}
      </p>
    </header>

    {
      showcase === 'harp' && (
        <div class="figure panel">
          <HeroVideo />
        </div>
      )
    }

    {
      figure && (
        <figure class="figure shot panel">
          {figure.href ? (
            <a href={figure.href} class="shot-link">
              <Image src={figure.src} alt={figure.alt} widths={[640, 960, 1280, 1600]} sizes="(max-width: 1440px) 100vw, 1376px" />
            </a>
          ) : (
            <Image src={figure.src} alt={figure.alt} widths={[640, 960, 1280, 1600]} sizes="(max-width: 1440px) 100vw, 1376px" />
          )}
          <figcaption class="caption-2 text-2">{figure.caption}</figcaption>
        </figure>
      )
    }

    <div class="intro-block">
      <div class="measure" data-reveal>
        <h2 class="heading-5">The project</h2>
        <p class="body-3">{overview}</p>
        <h2 class="heading-5">My part</h2>
        <p class="body-3">{contribution}</p>
      </div>
      {
        specs && (
          <dl class="specs side-specs panel" data-reveal>
            {specs.map((sp) => (
              <div>
                <dt>{sp.label}</dt>
                <dd class="body-6">{sp.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>

    <dl class="evidence panel" data-reveal>
      {
        stat && (
          <div class="stat">
            <dt class="heading-2 tnum">{stat.value}</dt>
            <dd class="body-6 text-2">{stat.label}</dd>
          </div>
        )
      }
      <div>
        <dt class="title-4 text-2">Claim</dt>
        <dd class="body-3">{claim}</dd>
      </div>
      <div>
        <dt class="title-4 text-2">Result</dt>
        <dd class="body-3"><Marked text={result} highlight={highlight} /></dd>
      </div>
      <div>
        <dt class="title-4 text-2">Limit</dt>
        <dd class="body-3">{limit}</dd>
      </div>
    </dl>

    {
      links.length > 0 && (
        <ul class="link-row project-links">
          {links.map((l) => (
            <li>
              <a href={l.href}>{l.label} <Icon name="arrowUpRight" /></a>
            </li>
          ))}
        </ul>
      )
    }

    {
      showcase === 'harp' && (
        <div class="figure">
          <h2 class="heading-5 h-sub">How the controller decides</h2>
          <Pipeline />
          <p class="lab-link"><a class="btn" href="/lab/">Open the crowd lab <Icon name="arrowRight" /></a></p>
        </div>
      )
    }

    <div class="prose-grid">
      <div class="prose">
        <Content />
      </div>
      {
        toc.length > 1 && (
          <nav class="toc" aria-label="On this page" data-toc>
            <p class="toc-title title-4 text-2">On this page</p>
            <ul>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>

    <nav class="pager" aria-label="More work">
      <a class="panel heading-6" href={`/work/${prev.id}/`} rel="prev"><span class="caption-1 text-2">Previous</span>{prev.data.title}</a>
      <a class="panel heading-6 next" href={`/work/${next.id}/`} rel="next"><span class="caption-1 text-2">Next</span>{next.data.title}</a>
    </nav>
  </article>
</Base>

<script>
  // Mark the section being read in the table of contents.
  const toc = document.querySelector('[data-toc]');
  if (toc) {
    const links = new Map(
      [...toc.querySelectorAll<HTMLAnchorElement>('a')].map((a) => [decodeURIComponent(a.hash.slice(1)), a]),
    );
    const heads = [...links.keys()].map((id) => document.getElementById(id)).filter((h): h is HTMLElement => !!h);
    const mark = () => {
      let current = heads[0];
      for (const h of heads) if (h.getBoundingClientRect().top < window.innerHeight * 0.35) current = h;
      for (const [id, a] of links) a.toggleAttribute('aria-current', id === current?.id);
    };
    let queued = false;
    window.addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          mark();
        });
      },
      { passive: true },
    );
    mark();
  }
</script>

<style>
  .project {
    padding-top: calc(var(--space-900) + var(--space-600));
  }

  .project-head {
    display: grid;
    gap: var(--space-300);
    max-width: 680px;
  }

  .figure {
    margin-top: var(--space-600);
  }

  .figure.panel,
  .shot {
    padding: var(--space-75);
  }

  .shot img {
    width: 100%;
    max-height: 820px;
    object-fit: cover;
    object-position: top;
    border-radius: var(--radius-lg);
    background: #ffffff;
  }

  .shot figcaption {
    padding: var(--space-100) var(--space-75) var(--space-50);
  }

  .intro-block {
    display: grid;
    grid-template-columns: minmax(0, 65ch) minmax(0, 22rem);
    justify-content: space-between;
    gap: var(--space-600);
    margin-top: var(--space-900);
  }

  .measure {
    display: grid;
    gap: var(--space-200);
    align-content: start;
  }

  .measure p + h2 {
    margin-top: var(--space-400);
  }

  .side-specs {
    align-self: start;
    padding: var(--space-300);
  }

  .evidence {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-300) var(--space-600);
    margin: var(--space-600) 0 0;
    padding: var(--space-400);
  }

  .evidence .stat {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--space-50);
  }

  .evidence .stat dt {
    color: var(--accent);
  }

  .evidence dd {
    margin-top: var(--space-50);
  }

  .project-links {
    margin-top: var(--space-200);
  }

  .project-links :global(.icon),
  .lab-link :global(.icon) {
    width: 16px;
    height: 16px;
  }

  .h-sub {
    margin-bottom: var(--space-300);
  }

  .lab-link {
    margin-top: var(--space-300);
  }

  @media (max-width: 1000px) {
    .intro-block,
    .evidence {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---------- the write-up and its contents ---------- */

  .prose-grid {
    display: grid;
    grid-template-columns: minmax(0, 65ch) minmax(0, 15rem);
    justify-content: space-between;
    gap: var(--space-600);
    align-items: start;
    margin-top: var(--space-800);
  }

  .prose :global(h2) {
    margin-top: var(--space-700);
    font-size: 1.5rem;
    line-height: 2rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(h3) {
    margin-top: var(--space-500);
    font-size: 1.25rem;
    line-height: 1.75rem;
    font-weight: 600;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(table) {
    margin-top: var(--space-200);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25em;
  }

  .prose :global(li + li) {
    margin-top: var(--space-75);
  }

  .prose :global(li::marker) {
    color: var(--text-3);
  }

  .prose :global(strong) {
    font-weight: 600;
  }

  /* Real tables keep their row lines. */
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-variant-numeric: tabular-nums;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: var(--space-100) var(--space-200) var(--space-100) 0;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--border);
  }

  .prose :global(th) {
    color: var(--text-2);
    font-weight: 500;
  }

  .toc {
    position: sticky;
    top: var(--space-900);
  }

  .toc ul {
    margin: var(--space-75) 0 0;
    padding: 0;
    list-style: none;
  }

  .toc a {
    display: flex;
    align-items: center;
    min-height: 40px;
    padding: var(--space-75) var(--space-100);
    border-radius: var(--radius-lg);
    color: var(--text-2);
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      color var(--dur-fade) var(--ease),
      background-color var(--dur-fade) var(--ease);
  }

  .toc a[aria-current] {
    color: var(--text);
    background: var(--surface-2);
  }

  @media (hover: hover) and (pointer: fine) {
    .toc a:hover {
      color: var(--text);
    }
  }

  @media (max-width: 1000px) {
    .prose-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .toc {
      display: none;
    }
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-300);
    margin-top: var(--space-900);
  }

  .pager a {
    display: grid;
    gap: var(--space-75);
    padding: var(--space-400) var(--space-300);
    text-decoration: none;
    transition:
      background-color var(--dur-fade) var(--ease),
      transform var(--dur-fade) var(--ease);
  }

  .pager .next {
    text-align: right;
  }

  @media (hover: hover) and (pointer: fine) {
    .pager a:hover {
      background: var(--surface-2);
      transform: translateY(-2px);
    }
  }

  .pager a:active {
    transform: scale(0.98);
  }

  @media (max-width: 640px) {
    .prose :global(table) {
      display: block;
      overflow-x: auto;
    }

    .prose :global(th),
    .prose :global(td) {
      min-width: 9rem;
    }

    .pager {
      grid-template-columns: 1fr;
    }

    .pager .next {
      text-align: left;
    }
  }
</style>
