---
// The crowd lab: the interactive pieces of the HARP work, moved off the home page so it stays short.
import Base from '../layouts/Base.astro';
import LabTabs from '../components/LabTabs.astro';
import RouteField from '../components/RouteField.astro';
---

<Base
  title="Crowd lab"
  description="Steer a browser model of predictive crowd avoidance, scrub a recorded HARP G1 run, and drive the earlier waypoint-lap behavior."
  image="/og/harp-crowd-navigation.png"
>
  <article class="lab wrap">
    <header class="head">
      <h1 class="heading-2 hero-gradient">Crowd lab</h1>
      <p class="lede title-1 text-2">
        The method behind the HARP work, running in your browser. It is a model written for this site to show the idea, not HARP's
        controller code.
      </p>
      <p><a class="btn" href="/work/harp-crowd-navigation/">Read the HARP write-up</a></p>
    </header>

    <section class="block panel" aria-labelledby="lab-crowd">
      <h2 id="lab-crowd" class="heading-5">Steer through a crowd, or scrub the recorded run</h2>
      <LabTabs id="lab-crowd" />
    </section>

    <section class="block panel" aria-labelledby="lab-route">
      <h2 id="lab-route" class="heading-5">Earlier work: waypoint laps and takeover</h2>
      <p class="note body-6 text-2">
        A small browser model of the behavior from PRs #2, #5, and #6: repeated laps over a waypoint route, speed that ramps up and
        slows into each target, and a takeover that stops at once. Click the floor to add waypoints.
      </p>
      <RouteField id="lab-route-field" />
    </section>
  </article>
</Base>

<style>
  .lab {
    padding-top: calc(var(--space-900) + var(--space-600));
  }

  .head {
    display: grid;
    gap: var(--space-300);
    justify-items: start;
    max-width: 680px;
  }

  .block {
    margin-top: var(--space-600);
    padding: var(--space-400) var(--space-300);
  }

  .block h2 {
    margin-bottom: var(--space-300);
  }

  .note {
    max-width: 65ch;
    margin-bottom: var(--space-300);
  }
</style>
