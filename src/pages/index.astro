---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Epigraph from '../components/Epigraph.astro';
import Film from '../components/Film.astro';
import Work from '../components/Work.astro';
import Marquee from '../components/Marquee.astro';
import BalancingMethod from '../components/BalancingMethod.astro';
import Certificates from '../components/Certificates.astro';
import People from '../components/People.astro';
import Marked from '../components/Marked.astro';
import { education, experience, honors, immc, papers, scores, tools } from '../data/profile';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const [balancing, macro] = papers;
const current = experience.filter((r) => r.dates.includes('Present'));
const past = experience.filter((r) => !r.dates.includes('Present'));

// schema.org records for the two papers, so search engines can cite them.
const scholarly = papers.map((p) => ({
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: p.title,
  author: p.authors.replace(/, and | and /g, ', ').split(', ').map((name) => ({ '@type': 'Person', name })),
  isPartOf: { '@type': 'Periodical', name: p.journal },
  datePublished: '2025',
  identifier: { '@type': 'PropertyValue', propertyID: 'DOI', value: p.doi },
  url: `https://doi.org/${p.doi}`,
}));
---

<Base structured={scholarly}>
  <Film />

  <section class="section wrap" id="work" aria-labelledby="work-title">
    <header class="section-head" data-enter>
      <h2 id="work-title">Work</h2>
      <p class="lede">What each project set out to do, my part in it, what was measured, and its main limit.</p>
      <Epigraph quote="work" />
    </header>
    <Work entries={work} />
  </section>

  <Marquee />

  <section class="section wrap" id="research" aria-labelledby="research-title">
    <header class="section-head" data-enter>
      <h2 id="research-title">Research</h2>
      <p class="lede">Two co-authored papers and an international modeling competition. These ones do play the odds.</p>
      <Epigraph quote="research" />
    </header>

    <article class="paper" aria-labelledby="paper-balancing">
      <div class="paper-text" data-enter>
        <h3 id="paper-balancing">Balancing numbers by the matrix method</h3>
        <p class="cite">{balancing.authors}. {balancing.journal}, {balancing.issue}.</p>
        <p><span class="label-ui">The question</span> {balancing.overview}</p>
        <p><span class="label-ui">What it shows</span> {balancing.findings}</p>
        <p class="doi"><span class="label-ui">{balancing.role}</span> <a href={`https://doi.org/${balancing.doi}`}>doi.org/{balancing.doi}</a></p>
      </div>
      <div class="paper-figure">
        <BalancingMethod />
      </div>
    </article>

    <article class="paper paper-flip" aria-labelledby="paper-macro">
      <div class="paper-text" data-enter>
        <h3 id="paper-macro">Deep learning against econometrics for inflation, GDP, and unemployment</h3>
        <p class="cite">Published as &ldquo;{macro.title}.&rdquo; {macro.authors}. {macro.journal}, {macro.issue}.</p>
        <p><span class="label-ui">The question</span> {macro.overview}</p>
      </div>
      <div class="paper-text" data-enter>
        <p><span class="label-ui">What it shows</span> <Marked text={macro.findings} highlight={macro.highlight} /></p>
        <p class="doi"><span class="label-ui">{macro.role}</span> <a href={`https://doi.org/${macro.doi}`}>doi.org/{macro.doi}</a></p>
      </div>
    </article>

    <article class="paper" aria-labelledby="immc-title">
      <div class="paper-text" data-enter>
        <h3 id="immc-title">{immc.title}</h3>
        <p class="cite">COMAP and NeoUnion ESC Organization. Hanoi-Amsterdam High School for the Gifted, representing Vietnam.</p>
        <p><span class="label-ui">The challenge</span> {immc.overview}</p>
        <p><span class="label-ui">Our work</span> {immc.work}</p>
        <p class="immc-result">{immc.result}</p>
      </div>
      <div class="paper-figure">
        <Certificates />
      </div>
    </article>
  </section>

  <section class="section wrap" id="experience" aria-labelledby="experience-title">
    <header class="section-head" data-enter>
      <h2 id="experience-title">Experience</h2>
      <p class="lede">Teams and organizations, most recent first.</p>
      <Epigraph quote="experience" />
    </header>
    <div class="legs">
      {
        [
          { label: 'Now', roles: current },
          { label: 'Before', roles: past },
        ].map((leg) => (
          <section class="leg" aria-labelledby={`leg-${leg.label}`}>
            <h3 id={`leg-${leg.label}`} class="leg-title">{leg.label}</h3>
            <ol class="roles" data-enter>
              {leg.roles.map((r) => (
                <li class="role">
                  <p class="role-dates tnum">{r.dates}</p>
                  <p class="org">{r.org}</p>
                  <p class="role-title">{r.title}</p>
                  {r.context && <p class="role-note">{r.context}</p>}
                  {r.detail && <p class="role-note">{r.detail}</p>}
                  {r.work && (
                    <p class="role-link">
                      <a href={`/work/${r.work}/`}>See the project</a>
                    </p>
                  )}
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </section>

  <section class="section wrap" id="people" aria-labelledby="people-title">
    <header class="section-head" data-enter>
      <h2 id="people-title">People I've met</h2>
      <p class="lede">Leaders in product and venture I have had the chance to meet.</p>
      <Epigraph quote="people" />
    </header>
    <People />
  </section>

  <section class="section wrap" id="education" aria-labelledby="education-title">
    <header class="section-head" data-enter>
      <h2 id="education-title">Education and honors</h2>
      <Epigraph quote="honors" />
    </header>
    <div class="facts" data-enter>
      <div>
        <h3>Education</h3>
        <ul>
          {
            education.map((e) => (
              <li>
                <strong>{e.school}</strong>
                <span>{e.detail}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h3>Honors and scores</h3>
        <ul>
          {honors.map((h) => <li>{h}</li>)}
          {scores.map((s) => <li>{s}</li>)}
        </ul>
      </div>
      <div>
        <h3>Tools</h3>
        <ul>
          {
            tools.map((t) => (
              <li>
                <strong>{t.group}</strong>
                <span>{t.items}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- research: figure beside its text, mirrored from Work ---------- */

  .paper {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(32px, 4vw, 72px);
    align-items: start;
  }

  .paper + .paper {
    margin-top: var(--section);
  }

  .paper .paper-figure {
    order: -1;
  }

  .paper-flip {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .paper-flip .paper-text + .paper-text {
    padding-top: clamp(0px, 8vw, 132px);
  }

  .paper-text {
    display: grid;
    gap: 16px;
  }

  .paper h3 {
    font-size: var(--step-lead);
    line-height: 1.12;
    letter-spacing: -0.025em;
    max-width: 26ch;
  }

  .cite {
    color: var(--muted);
    font-size: var(--step-small);
    margin-bottom: 12px;
  }

  .paper-text .label-ui {
    margin-right: 0.35em;
  }

  .doi {
    margin-top: 8px;
    font-size: var(--step-small);
  }

  .doi a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    overflow-wrap: anywhere;
  }

  .immc-result {
    font-weight: 500;
  }

  @media (max-width: 1000px) {
    .paper {
      grid-template-columns: minmax(0, 1fr);
    }

    .paper .paper-figure {
      order: 0;
    }
  }

  /* ---------- experience: now and before ---------- */

  .legs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(40px, 6vw, 112px);
  }

  .leg-title {
    font-size: var(--step-lead);
    letter-spacing: -0.02em;
    margin-bottom: 28px;
  }

  .roles {
    display: grid;
    gap: 36px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .role-dates {
    color: var(--muted);
    font-size: var(--step-small);
  }

  .org {
    margin-top: 6px;
    font-size: var(--step-lead);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .role-title {
    margin-top: 4px;
    font-weight: 500;
  }

  .role-note {
    margin-top: 6px;
    color: var(--muted);
  }

  .role-link {
    font-size: var(--step-small);
    font-weight: 500;
  }

  .role-link a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  @media (max-width: 760px) {
    .legs {
      grid-template-columns: minmax(0, 1fr);
    }
  }



  /* ---------- education and honors ---------- */

  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 48px clamp(32px, 4vw, 72px);
  }

  .facts h3 {
    font-size: var(--step-lead);
    letter-spacing: -0.02em;
    margin-bottom: 20px;
  }

  .facts ul {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .facts strong {
    display: block;
    font-weight: 500;
  }

  .facts span {
    display: block;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .facts {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
