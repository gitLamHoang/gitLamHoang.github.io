---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Epigraph from '../components/Epigraph.astro';
import Poster from '../components/Poster.astro';
import CaseFile from '../components/CaseFile.astro';
import Tagline from '../components/Tagline.astro';
import Icon from '../components/Icon.astro';
import BalancingMethod from '../components/BalancingMethod.astro';
import Certificates from '../components/Certificates.astro';
import People from '../components/People.astro';
import Marked from '../components/Marked.astro';
import { affiliations, education, experience, honors, immc, papers, scores, tools } from '../data/profile';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const [balancing, macro] = papers;
const current = experience.filter((r) => r.dates.includes('Present'));
const past = experience.filter((r) => !r.dates.includes('Present'));
const orgs = affiliations.map((a) => a.name.replace('International Mathematical Modeling Challenge', 'IM²C'));

// schema.org records for the two papers, so search engines can cite them.
const scholarly = papers.map((p) => ({
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: p.title,
  author: p.authors.replace(/, and | and /g, ', ').split(', ').map((name) => ({ '@type': 'Person', name })),
  isPartOf: { '@type': 'Periodical', name: p.journal },
  datePublished: '2025',
  identifier: { '@type': 'PropertyValue', propertyID: 'DOI', value: p.doi },
  url: `https://doi.org/${p.doi}`,
}));
---

<Base structured={scholarly}>
  <Poster />

  <CaseFile entries={work} />

  <section class="wrap orgs-band" aria-labelledby="orgs-title" data-reveal>
    <div class="orgs-row">
      <h2 id="orgs-title" class="title-4 text-2">Where I've worked, studied, and competed</h2>
      <ul class="orgs">
        {orgs.map((o) => <li class="title-2">{o}</li>)}
      </ul>
    </div>
  </section>

  <Tagline text="Every result on this site comes with how it was measured, and what it can't do yet." />

  <section class="section wrap" id="research" aria-labelledby="research-title">
    <header class="section-head" data-reveal>
      <div>
        <h2 id="research-title" class="heading-2">Research</h2>
        <p class="lede title-2">Two coauthored papers and an international modeling competition. These ones do play the odds.</p>
      </div>
      <Epigraph quote="research" />
    </header>

    <article class="panel paper" aria-labelledby="paper-balancing" data-reveal>
      <div class="paper-text">
        <h3 id="paper-balancing" class="heading-5">Balancing numbers by the matrix method</h3>
        <p class="body-6 text-2 byline">{balancing.authors}. {balancing.journal}, {balancing.issue}.</p>
        <div class="qa">
          <h4 class="title-4 text-2">The question</h4>
          <p class="body-3">{balancing.overview}</p>
        </div>
        <div class="qa">
          <h4 class="title-4 text-2">What it shows</h4>
          <p class="body-3">{balancing.findings}</p>
        </div>
        <ul class="link-row">
          <li><a href={`https://doi.org/${balancing.doi}`}>doi.org/{balancing.doi} <Icon name="arrowUpRight" /></a></li>
        </ul>
      </div>
      <div class="paper-figure">
        <BalancingMethod />
      </div>
    </article>

    <div class="pair">
      <article class="panel paper-small" aria-labelledby="paper-macro" data-reveal>
        <h3 id="paper-macro" class="heading-5">Deep learning against econometrics for inflation, GDP, and unemployment</h3>
        <p class="body-6 text-2 byline">Published as &ldquo;{macro.title}.&rdquo; {macro.authors}. {macro.journal}, {macro.issue}.</p>
        <div class="qa">
          <h4 class="title-4 text-2">The question</h4>
          <p class="body-3">{macro.overview}</p>
        </div>
        <div class="qa">
          <h4 class="title-4 text-2">What it shows</h4>
          <p class="body-3"><Marked text={macro.findings} highlight={macro.highlight} /></p>
        </div>
        <ul class="link-row">
          <li><a href={`https://doi.org/${macro.doi}`}>doi.org/{macro.doi} <Icon name="arrowUpRight" /></a></li>
        </ul>
      </article>

      <article class="panel paper-small" aria-labelledby="immc-title" data-reveal>
        <h3 id="immc-title" class="heading-5">{immc.title}</h3>
        <p class="body-6 text-2 byline">COMAP and NeoUnion ESC Organization. Hanoi-Amsterdam High School for the Gifted, representing Vietnam.</p>
        <div class="qa">
          <h4 class="title-4 text-2">The challenge</h4>
          <p class="body-3">{immc.overview}</p>
        </div>
        <div class="qa">
          <h4 class="title-4 text-2">Our work</h4>
          <p class="body-3">{immc.work}</p>
        </div>
        <p class="body-2">{immc.result}</p>
        <Certificates />
      </article>
    </div>
  </section>

  <section class="section wrap" id="experience" aria-labelledby="experience-title">
    <header class="section-head" data-reveal>
      <div>
        <h2 id="experience-title" class="heading-2">Experience</h2>
        <p class="lede title-2">Teams and organizations, most recent first.</p>
      </div>
      <Epigraph quote="experience" />
    </header>
    <div class="legs">
      {
        [
          { label: 'Now', roles: current },
          { label: 'Before', roles: past },
        ].map((leg) => (
          <section class="panel leg" aria-labelledby={`leg-${leg.label}`} data-reveal>
            <h3 id={`leg-${leg.label}`} class="title-2 text-2">{leg.label}</h3>
            <ol class="roles">
              {leg.roles.map((r) => (
                <li class="role">
                  <p class="caption-2 text-2 tnum">{r.dates}</p>
                  <p class="heading-6">{r.org}</p>
                  <p class="body-2">{r.title}</p>
                  {r.context && <p class="body-6 text-2">{r.context}</p>}
                  {r.detail && <p class="body-6 text-2">{r.detail}</p>}
                  {r.work && (
                    <p class="role-link">
                      <a href={`/#work-${r.work}`} class="body-5">
                        See the project <Icon name="arrowRight" />
                      </a>
                    </p>
                  )}
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </section>

  <section class="section wrap" id="people" aria-labelledby="people-title">
    <header class="section-head" data-reveal>
      <div>
        <h2 id="people-title" class="heading-2">People I've met</h2>
        <p class="lede title-2">Leaders in product and venture I have had the chance to meet.</p>
      </div>
      <Epigraph quote="people" />
    </header>
    <People />
  </section>

  <section class="section wrap" id="education" aria-labelledby="education-title">
    <header class="section-head" data-reveal>
      <div>
        <h2 id="education-title" class="heading-2">Education and honors</h2>
      </div>
      <Epigraph quote="honors" />
    </header>
    <div class="facts">
      <div class="panel fact-wide" data-reveal>
        <h3 class="title-2 text-2">Education</h3>
        <ul>
          {
            education.map((e) => (
              <li>
                <p class="heading-6">{e.school}</p>
                <p class="body-6 text-2">{e.detail}</p>
              </li>
            ))
          }
        </ul>
        <h3 class="title-2 text-2 tools-title">Tools</h3>
        <ul class="tools">
          {
            tools.map((t) => (
              <li>
                <p class="body-2">{t.group}</p>
                <p class="body-6 text-2">{t.items}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="panel" data-reveal>
        <h3 class="title-2 text-2">Honors and scores</h3>
        <ul>
          {honors.map((h) => <li class="body-3">{h}</li>)}
          {scores.map((s) => <li class="body-3">{s}</li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- the organizations: one composed row of names ---------- */

  .orgs-band {
    margin-top: var(--space-300);
  }

  .orgs-row {
    display: grid;
    gap: var(--space-100);
    padding: var(--space-300) var(--space-300) 0;
  }

  .orgs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-100) var(--space-400);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ---------- research ---------- */

  .paper {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-400);
    padding: var(--space-75);
  }

  .paper-text,
  .paper-small {
    display: grid;
    align-content: start;
    gap: var(--space-200);
  }

  .paper-text {
    padding: var(--space-300) var(--space-200) var(--space-200);
  }

  .paper-small {
    padding: var(--space-400) var(--space-300);
  }

  .qa {
    display: grid;
    gap: var(--space-50);
  }

  .byline {
    margin-top: calc(-1 * var(--space-75));
    margin-bottom: var(--space-75);
  }

  .pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-300);
    margin-top: var(--space-300);
    align-items: start;
  }

  .link-row :global(.icon) {
    width: 16px;
    height: 16px;
  }

  @media (max-width: 1000px) {
    .paper,
    .pair {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---------- experience ---------- */

  .legs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-300);
    align-items: start;
  }

  .leg {
    padding: var(--space-400) var(--space-300);
  }

  .roles {
    display: grid;
    gap: var(--space-400);
    margin: var(--space-300) 0 0;
    padding: 0;
    list-style: none;
  }

  .role {
    display: grid;
    gap: var(--space-50);
  }

  .role-link a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-50);
    min-height: 44px;
  }

  .role-link :global(.icon) {
    width: 16px;
    height: 16px;
  }

  @media (max-width: 760px) {
    .legs {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---------- education and honors: one wide panel, one narrow ---------- */

  .facts {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-300);
    align-items: start;
  }

  .facts .panel {
    padding: var(--space-400) var(--space-300);
  }

  .facts ul {
    display: grid;
    gap: var(--space-200);
    margin: var(--space-300) 0 0;
    padding: 0;
    list-style: none;
  }

  .tools {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .tools-title {
    margin-top: var(--space-600);
  }

  @media (max-width: 900px) {
    .facts,
    .tools {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
