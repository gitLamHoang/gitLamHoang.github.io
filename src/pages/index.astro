---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Epigraph from '../components/Epigraph.astro';
import Poster from '../components/Poster.astro';
import Spine from '../components/Spine.astro';
import SectionShot from '../components/SectionShot.astro';
import Projects from '../components/Projects.astro';
import Icon from '../components/Icon.astro';
import BalancingMethod from '../components/BalancingMethod.astro';
import Certificates from '../components/Certificates.astro';
import People from '../components/People.astro';
import Marked from '../components/Marked.astro';
import { education, experience, honors, immc, papers, scores, tools } from '../data/profile';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const [balancing, macro] = papers;
const current = experience.filter((r) => r.dates.includes('Present'));
const past = experience.filter((r) => !r.dates.includes('Present'));

// schema.org records for the two papers, so search engines can cite them.
const scholarly = papers.map((p) => ({
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: p.title,
  author: p.authors.replace(/, and | and /g, ', ').split(', ').map((name) => ({ '@type': 'Person', name })),
  isPartOf: { '@type': 'Periodical', name: p.journal },
  datePublished: '2025',
  identifier: { '@type': 'PropertyValue', propertyID: 'DOI', value: p.doi },
  url: `https://doi.org/${p.doi}`,
}));
---

<Base structured={scholarly}>
  <Poster />
  <Spine />

  <Projects entries={work} />

  <section class="section wrap" id="experience" aria-labelledby="experience-title">
    <SectionShot kind="palmdrive" />
    <header class="section-head" data-reveal>
      <div>
        <h2 id="experience-title" class="heading-2">Experience</h2>
        <p class="lede title-2">Teams and organizations, most recent first.</p>
      </div>
      <Epigraph quote="experience" />
    </header>
    <div class="legs">
      {
        [
          { label: 'Now', roles: current },
          { label: 'Before', roles: past },
        ].map((leg) => (
          <section class="leg" aria-labelledby={`leg-${leg.label}`} data-reveal>
            <h3 id={`leg-${leg.label}`} class="title-2 text-2">{leg.label}</h3>
            <ol class="roles">
              {leg.roles.map((r) => (
                <li class:list={['role', { 'is-current': leg.label === 'Now' }]}>
                  <span class="wp" aria-hidden="true" />
                  <div class="role-body">
                    <p class="caption-2 text-2 tnum">{r.dates}</p>
                    <p class="heading-6">{r.org}</p>
                    <p class="body-2">{r.title}</p>
                    {r.context && <p class="body-6 text-2">{r.context}</p>}
                    {r.detail && <p class="body-6 text-2">{r.detail}</p>}
                    {r.work && (
                      <p class="role-link">
                        <a href={`/#work-${r.work}`} class="body-5">
                          See the project <Icon name="arrowRight" />
                        </a>
                      </p>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </section>

  <section class="section wrap" id="people" aria-labelledby="people-title">
    <SectionShot kind="arcade" />
    <header class="section-head" data-reveal>
      <div>
        <h2 id="people-title" class="heading-2">People I've met</h2>
        <p class="lede title-2">Leaders in product and venture I have had the chance to meet.</p>
      </div>
      <Epigraph quote="people" />
    </header>
    <People />
  </section>

  <section class="section wrap" id="research" aria-labelledby="research-title">
    <SectionShot kind="library" />
    <header class="section-head" data-reveal>
      <div>
        <h2 id="research-title" class="heading-2">Research</h2>
        <p class="lede title-2">Two coauthored papers and an international modeling competition. These ones do play the odds.</p>
      </div>
      <Epigraph quote="research" />
    </header>

    <article class="panel paper" aria-labelledby="paper-balancing" data-reveal>
      <div class="paper-head">
        <h3 id="paper-balancing" class="heading-5">Balancing numbers by the matrix method</h3>
        <p class="body-6 text-2">{balancing.authors}. {balancing.journal}, {balancing.issue}.</p>
      </div>
      <div class="qa-pair">
        <div class="qa">
          <h4 class="title-4 text-2">The question</h4>
          <p class="body-3">{balancing.overview}</p>
        </div>
        <div class="qa">
          <h4 class="title-4 text-2">What it shows</h4>
          <p class="body-3">{balancing.findings}</p>
        </div>
      </div>
      <BalancingMethod />
      <ul class="link-row">
        <li><a href={`https://doi.org/${balancing.doi}`}>doi.org/{balancing.doi} <Icon name="arrowUpRight" /></a></li>
      </ul>
    </article>

    <article class="panel paper" aria-labelledby="paper-macro" data-reveal>
      <div class="paper-head">
        <h3 id="paper-macro" class="heading-5">Deep learning against econometrics for inflation, GDP, and unemployment</h3>
        <p class="body-6 text-2">Published as &ldquo;{macro.title}.&rdquo; {macro.authors}. {macro.journal}, {macro.issue}.</p>
      </div>
      <div class="qa-pair">
        <div class="qa">
          <h4 class="title-4 text-2">The question</h4>
          <p class="body-3">{macro.overview}</p>
        </div>
        <div class="qa">
          <h4 class="title-4 text-2">What it shows</h4>
          <p class="body-3"><Marked text={macro.findings} highlight={macro.highlight} /></p>
        </div>
      </div>
      <ul class="link-row">
        <li><a href={`https://doi.org/${macro.doi}`}>doi.org/{macro.doi} <Icon name="arrowUpRight" /></a></li>
      </ul>
    </article>

    <article class="panel paper immc" aria-labelledby="immc-title" data-reveal>
      <div class="immc-text">
        <div class="paper-head">
          <h3 id="immc-title" class="heading-5">{immc.title}</h3>
          <p class="body-6 text-2">COMAP and NeoUnion ESC Organization. Hanoi-Amsterdam High School for the Gifted, representing Vietnam.</p>
        </div>
        <div class="qa">
          <h4 class="title-4 text-2">The challenge</h4>
          <p class="body-3">{immc.overview}</p>
        </div>
        <div class="qa">
          <h4 class="title-4 text-2">Our work</h4>
          <p class="body-3">{immc.work}</p>
        </div>
        <p class="body-2">{immc.result}</p>
      </div>
      <Certificates />
    </article>
  </section>

  <section class="section wrap" id="education" aria-labelledby="education-title">
    <SectionShot kind="tower" />
    <header class="section-head" data-reveal>
      <div>
        <h2 id="education-title" class="heading-2">Education, skills, and awards</h2>
      </div>
      <Epigraph quote="honors" />
    </header>
    <div class="facts">
      <div class="panel" data-reveal>
        <h3 class="title-2 text-2">Education</h3>
        <ul>
          {
            education.map((e) => (
              <li>
                <p class="heading-6">{e.school}</p>
                <p class="body-6 text-2">{e.detail}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="panel" data-reveal>
        <h3 class="title-2 text-2">Skills</h3>
        <ul>
          {
            tools.map((t) => (
              <li>
                <p class="body-2">{t.group}</p>
                <p class="body-6 text-2">{t.items}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="panel" data-reveal>
        <h3 class="title-2 text-2">Awards and scores</h3>
        <ul>
          {honors.map((h) => <li class="body-3">{h}</li>)}
          {scores.map((s) => <li class="body-3">{s}</li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- research: each paper full width, its question and finding side by side ---------- */

  .paper {
    display: grid;
    gap: var(--space-300);
    padding-top: var(--space-300);
  }

  .paper + .paper {
    margin-top: var(--space-600);
  }

  .paper-head {
    display: grid;
    gap: var(--space-75);
    max-width: 62rem;
  }

  .qa-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-300) var(--space-600);
  }

  .qa {
    display: grid;
    align-content: start;
    gap: var(--space-50);
  }

  /* The competition: its story on the left, the two certificates on the right. */
  .immc {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-300) var(--space-600);
    align-items: start;
  }

  .immc-text {
    display: grid;
    gap: var(--space-200);
  }

  .link-row :global(.icon) {
    width: 16px;
    height: 16px;
  }

  @media (max-width: 1000px) {
    .qa-pair,
    .immc {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---------- experience: waypoints on a route, now and before side by side ---------- */

  .legs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--space-600);
    align-items: start;
    padding-top: var(--space-300);
    border-top: 2px solid var(--gold);
  }

  .roles {
    display: grid;
    margin: var(--space-200) 0 0;
    padding: 0;
    list-style: none;
  }

  /* Current roles get filled waypoints, earlier ones open rings, on one line per leg. */
  .role {
    position: relative;
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    gap: 0 var(--space-200);
    padding-bottom: var(--space-400);
  }

  .role::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 9px;
    width: 2px;
    background: rgb(239 227 198 / 0.22);
  }

  .role:first-child::before {
    top: 8px;
  }

  .role:last-child::before {
    bottom: var(--space-400);
  }

  .wp {
    position: relative;
    z-index: 1;
    width: 14px;
    height: 14px;
    margin: 3px 0 0 3px;
    border: 2px solid var(--text);
    border-radius: var(--radius-full);
    background: var(--bg);
  }

  .is-current .wp {
    background: var(--text);
  }

  .role-body {
    display: grid;
    gap: var(--space-50);
  }

  .role-link a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-50);
    min-height: 44px;
  }

  .role-link :global(.icon) {
    width: 16px;
    height: 16px;
  }

  @media (max-width: 1000px) {
    .legs {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---------- education, skills, and awards: three columns, as on the resume ---------- */

  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-300) var(--space-600);
    align-items: start;
  }

  .facts .panel {
    padding: var(--space-300) 0 0;
  }

  .facts ul {
    display: grid;
    gap: var(--space-200);
    margin: var(--space-300) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 1000px) {
    .facts {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
