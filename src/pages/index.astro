---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Epigraph from '../components/Epigraph.astro';
import HeroVideo from '../components/HeroVideo.astro';
import Affiliations from '../components/Affiliations.astro';
import FeatureProject from '../components/FeatureProject.astro';
import ProjectRow from '../components/ProjectRow.astro';
import BalancingMethod from '../components/BalancingMethod.astro';
import Certificates from '../components/Certificates.astro';
import People from '../components/People.astro';
import Marked from '../components/Marked.astro';
import { contact, education, experience, honors, immc, papers, person, scores, tools } from '../data/profile';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const featured = work.find((w) => w.data.showcase === 'harp')!;
const rest = work.filter((w) => w !== featured);
const [balancing, macro] = papers;
const current = experience.filter((r) => r.dates.includes('present'));
const past = experience.filter((r) => !r.dates.includes('present'));

// schema.org records for the two papers, so search engines can cite them.
const scholarly = papers.map((p) => ({
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: p.title,
  author: p.authors.replace(/, and | and /g, ', ').split(', ').map((name) => ({ '@type': 'Person', name })),
  isPartOf: { '@type': 'Periodical', name: p.journal },
  datePublished: '2025',
  identifier: { '@type': 'PropertyValue', propertyID: 'DOI', value: p.doi },
  url: `https://doi.org/${p.doi}`,
}));
---

<Base structured={scholarly}>
  <section class="hero wrap" aria-labelledby="hero-name">
    <div class="hero-grid">
      <div class="hero-text">
        <p class="now ui"><span class="dot" aria-hidden="true"></span>{person.now}</p>
        <h1 id="hero-name" class="name">{person.name}</h1>
        <p class="statement">{person.statement}</p>
        <p class="intro">{person.intro}</p>
        <div class="cta">
          <a class="btn btn-primary" href={contact.resume} download="Harvey_Phan_Resume.pdf">{contact.resumeLabel} (PDF)</a>
          <a class="btn" href={`mailto:${contact.email}`}>Email me</a>
          <a class="btn" href={contact.github}>GitHub</a>
        </div>
        <Epigraph quote="hero" class="hero-quote" />
      </div>
      <div class="hero-media">
        <HeroVideo />
      </div>
    </div>
  </section>

  <Affiliations />

  <section class="section wrap" id="work" aria-labelledby="work-title">
    <header class="row section-head">
      <div>
        <h2 id="work-title">Work</h2>
        <p class="lede">What each project set out to do, what I built, what was measured, and the main limit, stated plainly.</p>
      </div>
      <Epigraph quote="work" />
    </header>
    <FeatureProject entry={featured} />
    {rest.map((entry) => <ProjectRow entry={entry} />)}
  </section>

  <section class="section wrap" id="research" aria-labelledby="research-title">
    <header class="row section-head">
      <div>
        <h2 id="research-title">Research</h2>
        <p class="lede">Two co-authored papers and an international modeling competition. These ones do play the odds.</p>
      </div>
      <Epigraph quote="research" />
    </header>

    <article class="paper">
      <div class="row">
        <div class="paper-main">
          <p class="kicker">Hanoi National University of Education</p>
          <h3>{balancing.title}</h3>
          <p class="cite ui">{balancing.authors}</p>
          <p class="abstract"><span class="label-ui">The question.</span> {balancing.overview}</p>
          <p class="abstract"><span class="label-ui">What it shows.</span> {balancing.findings}</p>
        </div>
        <dl class="side-card">
          <div><dt>Published in</dt><dd>{balancing.journal}</dd></div>
          <div><dt>Issue</dt><dd>{balancing.issue}</dd></div>
          <div><dt>Role</dt><dd>{balancing.role}</dd></div>
          <div><dt>DOI</dt><dd><a href={`https://doi.org/${balancing.doi}`}>{balancing.doi}</a></dd></div>
        </dl>
      </div>
      <BalancingMethod />
    </article>

    <article class="paper row">
      <div class="paper-main">
        <p class="kicker">Journal of Basic and Applied Research International</p>
        <h3>{macro.title}</h3>
        <p class="cite ui">{macro.authors}</p>
        <p class="abstract"><span class="label-ui">The question.</span> {macro.overview}</p>
        <p class="abstract"><span class="label-ui">What it shows.</span> <Marked text={macro.findings} highlight={macro.highlight} /></p>
      </div>
      <dl class="side-card">
        <div><dt>Published in</dt><dd>{macro.journal}</dd></div>
        <div><dt>Issue</dt><dd>{macro.issue}</dd></div>
        <div><dt>Role</dt><dd>{macro.role}</dd></div>
        <div><dt>DOI</dt><dd><a href={`https://doi.org/${macro.doi}`}>{macro.doi}</a></dd></div>
      </dl>
    </article>

    <article class="paper immc" aria-labelledby="immc-title">
      <div class="row">
        <div class="paper-main">
          <p class="kicker">COMAP and NeoUnion, international</p>
          <h3 id="immc-title">{immc.title}</h3>
          <p class="abstract"><span class="label-ui">The challenge.</span> {immc.overview}</p>
          <p class="abstract"><span class="label-ui">Our work.</span> {immc.work}</p>
          <p class="abstract result"><strong>{immc.result}</strong></p>
        </div>
        <dl class="side-card">
          <div><dt>Team</dt><dd>Hanoi-Amsterdam High School for the Gifted</dd></div>
          <div><dt>Representing</dt><dd>Vietnam</dd></div>
          <div><dt>Result</dt><dd>Honorable Mention, 2024 and 2025</dd></div>
          <div><dt>Organizers</dt><dd>COMAP and NeoUnion ESC Organization</dd></div>
        </dl>
      </div>
      <Certificates />
    </article>
  </section>

  <section class="section wrap" id="experience" aria-labelledby="experience-title">
    <header class="row section-head">
      <div>
        <h2 id="experience-title">Experience</h2>
        <p class="lede">Teams and organizations, most recent first.</p>
      </div>
      <Epigraph quote="experience" />
    </header>
    <div class="route-roles">
      {
        [
          { label: 'Now', roles: current },
          { label: 'Before', roles: past },
        ].map((leg) => (
          <section class="leg" aria-label={leg.label === 'Now' ? 'Current roles' : 'Earlier roles'}>
            <h3 class="leg-title ui">{leg.label}</h3>
            <ol class="roles">
              {leg.roles.map((r) => (
                <li class:list={['role', { 'is-current': leg.label === 'Now' }]}>
                  <p class="ui role-dates">{r.dates}</p>
                  <span class="wp" aria-hidden="true" />
                  <div class="role-body">
                    <p class="org">{r.org}</p>
                    <p class="role-title">{r.title}</p>
                    {r.context && <p class="role-context">{r.context}</p>}
                    {r.detail && <p class="role-detail">{r.detail}</p>}
                    {r.work && (
                      <p class="role-link ui">
                        <a href={`/work/${r.work}/`}>See the project</a>
                      </p>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </section>

  <section class="section wrap" id="people" aria-labelledby="people-title">
    <header class="row section-head">
      <div>
        <h2 id="people-title">People I've met</h2>
        <p class="lede">Leaders in product and venture I have had the chance to meet.</p>
      </div>
      <Epigraph quote="people" />
    </header>
    <People />
  </section>

  <section class="section wrap" id="education" aria-labelledby="education-title">
    <header class="row section-head">
      <div>
        <h2 id="education-title">Education and honors</h2>
      </div>
      <Epigraph quote="honors" />
    </header>
    <div class="facts">
      <div>
        <h3>Education</h3>
        <ul>
          {
            education.map((e) => (
              <li>
                <strong>{e.school}</strong>
                <span>{e.detail}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h3>Honors and scores</h3>
        <ul>
          {honors.map((h) => <li>{h}</li>)}
          {scores.map((s) => <li>{s}</li>)}
        </ul>
      </div>
      <div>
        <h3>Tools</h3>
        <ul>
          {
            tools.map((t) => (
              <li>
                <strong>{t.group}</strong>
                <span>{t.items}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-top: clamp(20px, 4vw, 48px);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.25fr);
    gap: 32px clamp(32px, 4vw, 60px);
    align-items: start;
  }

  @media (max-width: 1100px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .now {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 12px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: var(--paper-raised);
    font-size: 0.96875rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .dot {
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--pen);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--pen) 22%, transparent);
    animation: live 2.4s ease-out infinite;
  }

  /* A slow live pulse on the current-work dot. Global reduced-motion rules stop it. */
  @keyframes live {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--pen) 45%, transparent);
    }
    70%,
    100% {
      box-shadow: 0 0 0 9px color-mix(in srgb, var(--pen) 0%, transparent);
    }
  }

  .name {
    margin-top: 22px;
    font-size: clamp(3.25rem, 7.5vw, 5.75rem);
    line-height: 0.92;
    letter-spacing: -0.02em;
  }

  .statement {
    margin-top: 18px;
    max-width: 32ch;
    font-size: clamp(1.375rem, 2.3vw, 1.75rem);
    line-height: 1.3;
    font-variation-settings: 'opsz' 40;
    text-wrap: balance;
  }

  .intro {
    margin-top: 14px;
    max-width: 56ch;
    color: var(--ink-soft);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }

  .hero-text :global(.hero-quote) {
    margin-top: 26px;
  }

  .hero-media {
    padding-top: 6px;
  }

  .paper {
    padding-block: 34px;
    border-bottom: 1px solid var(--grid);
  }

  .paper h3 {
    margin-top: 6px;
    font-size: clamp(1.375rem, 2.4vw, 1.75rem);
  }

  .paper-main {
    max-width: 74ch;
  }

  .cite {
    margin-top: 8px;
    font-size: 1rem;
    font-weight: 500;
    color: var(--graphite);
  }

  .abstract {
    margin-top: 12px;
  }

  .result strong {
    font-family: var(--font-ui);
    font-size: 1.125rem;
    font-weight: 600;
  }

  /* Citation card in the margin column of each research entry. */
  .side-card {
    align-self: start;
    margin: 4px 0 0;
    padding: 4px 16px;
    border: 1px solid var(--grid);
    border-left: 3px solid var(--pen);
    border-radius: var(--radius);
    background: var(--paper-raised);
  }

  .side-card div {
    padding: 9px 0;
  }

  .side-card div + div {
    border-top: 1px solid var(--grid);
  }

  .side-card dt {
    font-family: var(--font-ui);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--graphite);
  }

  .side-card dd {
    margin: 2px 0 0;
    font-size: 0.96875rem;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  @media (max-width: 900px) {
    .side-card {
      margin-top: 16px;
    }
  }

  /* Experience: waypoints on a route, in two legs (now and before), side by side on wide screens. */
  .route-roles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--col-gap);
  }

  @media (max-width: 1000px) {
    .route-roles {
      grid-template-columns: minmax(0, 1fr);
    }

    .leg + .leg {
      margin-top: 12px;
    }
  }

  .leg-title {
    padding-top: 22px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--graphite);
  }

  .roles {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .role {
    position: relative;
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    gap: 0 14px;
    padding-block: 10px 14px;
  }

  /* The route: a line through every waypoint. */
  .role::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 9px;
    width: 2px;
    background: var(--grid);
  }

  .wp {
    position: relative;
    z-index: 1;
    grid-row: 1;
    grid-column: 1;
    width: 14px;
    height: 14px;
    margin: 5px 0 0 3px;
    border: 2px solid var(--route);
    border-radius: 50%;
    background: var(--paper);
  }

  .is-current .wp {
    background: var(--route);
  }

  .role-body {
    grid-column: 2;
  }

  .org {
    font-family: var(--font-ui);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 600;
    line-height: 1.15;
  }

  .role-title {
    margin-top: 4px;
    font-weight: 600;
  }

  .role-context,
  .role-detail {
    margin-top: 2px;
    font-size: 1rem;
    color: var(--ink-soft);
  }

  .role-context {
    color: var(--graphite);
  }

  .role-link {
    font-size: 1rem;
    font-weight: 600;
  }

  .role-link a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .role-dates {
    grid-column: 2;
    font-size: 1rem;
    font-weight: 600;
    color: var(--graphite);
  }

  @media (max-width: 900px) {
    .role-dates {
      font-size: 0.9375rem;
    }
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 28px var(--col-gap);
    padding-top: 24px;
  }

  .facts h3 {
    font-size: 1.3125rem;
    padding-bottom: 8px;
    border-bottom: 1.5px solid var(--ink);
  }

  .facts ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .facts li {
    display: flex;
    flex-direction: column;
    padding-block: 10px;
    font-size: 1rem;
    line-height: 1.5;
    border-bottom: 1px solid var(--grid);
  }

  .facts li strong {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 1.0625rem;
  }

  .facts li span {
    color: var(--ink-soft);
  }
</style>
