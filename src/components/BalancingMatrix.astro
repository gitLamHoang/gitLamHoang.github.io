---
// Server-renders n = 1 so the widget reads correctly without JavaScript.
---

<div class="mx-widget" data-matrix>
  <div class="mx-top">
    <p class="ui mx-n">B<sup>n</sup> with n = <output data-mx-n>1</output></p>
    <div class="mx-controls" role="group" aria-label="Matrix power">
      <button type="button" class="btn btn-primary" data-mx="step">n + 1</button>
      <button type="button" class="btn" data-mx="reset">Reset</button>
    </div>
  </div>
  <div class="mx-body">
    <div class="mx mono" role="img" aria-label="B to the power 1 equals the matrix 6, 1; minus 1, 0" data-mx-grid>
      <span data-mx-cell>6</span><span data-mx-cell>1</span><span data-mx-cell>&minus;1</span><span data-mx-cell>0</span>
    </div>
    <p class="mx-read">
      Top row: B(n+1) and B(n). Bottom row: &minus;B(n) and &minus;B(n&minus;1). Every power has determinant 1.
    </p>
  </div>
  <p class="mx-seq">Balancing numbers so far: <span class="mono" data-mx-seq>1, 6</span></p>
  <p class="sr-only" aria-live="polite" data-mx-status></p>
</div>

<script>
  import { balancingNumbers, power } from '../lib/balancing.ts';

  const MAX_N = 30;
  // Group digits with thin spaces so thousands never collide with the commas between terms.
  const group = (v: bigint) => String(v).replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
  const fmt = (v: bigint) => (v < 0n ? `−${group(-v)}` : group(v));
  const spoken = (v: bigint) => (v < 0n ? `minus ${-v}` : String(v));

  for (const root of document.querySelectorAll<HTMLElement>('[data-matrix]')) {
    let n = 1;
    const nOut = root.querySelector('[data-mx-n]')!;
    const grid = root.querySelector('[data-mx-grid]')!;
    const cells = [...root.querySelectorAll<HTMLElement>('[data-mx-cell]')];
    const seq = root.querySelector('[data-mx-seq]')!;
    const status = root.querySelector('[data-mx-status]')!;
    const stepButton = root.querySelector<HTMLButtonElement>('[data-mx="step"]')!;

    const draw = () => {
      const m = power(n);
      const values = [m[0][0], m[0][1], m[1][0], m[1][1]];
      values.forEach((v, i) => (cells[i].textContent = fmt(v)));
      nOut.textContent = String(n);
      grid.setAttribute(
        'aria-label',
        `B to the power ${n} equals the matrix ${spoken(values[0])}, ${spoken(values[1])}; ${spoken(values[2])}, ${spoken(values[3])}`,
      );
      seq.textContent = balancingNumbers(n + 2).slice(1).map(fmt).join(', ');
      stepButton.disabled = n >= MAX_N;
      status.textContent = n >= MAX_N ? `n = ${MAX_N}, the last step here.` : `n = ${n}. B(${n + 1}) is ${values[0]}.`;
    };

    stepButton.addEventListener('click', () => {
      if (n < MAX_N) n += 1;
      draw();
    });
    root.querySelector('[data-mx="reset"]')?.addEventListener('click', () => {
      n = 1;
      draw();
    });
  }
</script>

<style>
  .mx-widget {
    margin-top: 20px;
    padding: 18px 20px 20px;
    border: 1.5px solid var(--ink);
    border-radius: var(--radius);
    background: var(--paper-raised);
  }

  .mx-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 16px;
  }

  .mx-n {
    font-size: 1.125rem;
    font-weight: 500;
  }

  .mx-n output {
    font-family: var(--font-mono);
  }

  .mx-controls {
    display: flex;
    gap: 8px;
  }

  .mx-body {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 28px;
    margin-top: 16px;
  }

  /* Bracketed 2x2 matrix */
  .mx {
    position: relative;
    display: inline-grid;
    grid-template-columns: auto auto;
    gap: 6px 22px;
    padding: 8px 16px;
    font-size: 1.0625rem;
    text-align: right;
    max-width: 100%;
  }

  .mx::before,
  .mx::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 8px;
    border: 2px solid var(--ink);
  }

  .mx::before {
    left: 0;
    border-right: 0;
  }

  .mx::after {
    right: 0;
    border-left: 0;
  }

  .mx span {
    overflow-wrap: anywhere;
  }

  .mx-read {
    flex: 1 1 18rem;
    font-size: 1rem;
    color: var(--graphite);
  }

  .mx-seq {
    margin-top: 14px;
    font-size: 1rem;
  }

  .mx-seq .mono {
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }
</style>
