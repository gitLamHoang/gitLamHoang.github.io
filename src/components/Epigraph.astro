---
import { quotes, type QuoteKey } from '../data/quotes';

interface Props {
  quote: QuoteKey;
  class?: string;
}

const { quote, class: className } = Astro.props;
const { text, episode } = quotes[quote];
---

<figure class:list={['epigraph', className]}>
  <blockquote>
    <p class="body-3">&ldquo;{text}&rdquo;</p>
  </blockquote>
  <figcaption class="caption-4 text-3">Harvey Specter, <cite>Suits</cite>, {episode}</figcaption>
</figure>

<style>
  .epigraph {
    max-width: 22rem;
  }

  blockquote {
    margin: 0;
  }

  blockquote p {
    color: var(--ink-soft);
  }

  figcaption {
    margin-top: var(--space-50);
  }
</style>
