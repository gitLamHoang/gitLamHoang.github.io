---
import { quotes, type QuoteKey } from '../data/quotes';

interface Props {
  quote: QuoteKey;
  class?: string;
}

const { quote, class: className } = Astro.props;
const { text, episode } = quotes[quote];
---

<figure class:list={['epigraph', className]}>
  <blockquote>
    <p>&ldquo;{text}&rdquo;</p>
  </blockquote>
  <figcaption>Harvey Specter, <cite>Suits</cite>, {episode}</figcaption>
</figure>

<style>
  .epigraph {
    max-width: 36ch;
  }

  blockquote {
    margin: 0;
  }

  blockquote p {
    font-style: italic;
    font-size: var(--step-body);
    line-height: 1.4;
    text-indent: -0.4em;
    color: var(--ink-soft);
  }

  figcaption {
    margin-top: 6px;
    font-size: var(--step-small);
    color: var(--muted);
  }

  cite {
    font-style: italic;
  }
</style>
