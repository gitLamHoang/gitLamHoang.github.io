---
// A project on the home page: the whole project first, then my part, then claim, result, and limit,
// with its evidence image beside it.
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Marked from './Marked.astro';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { title, org, role, dates, overview, contribution, claim, result, highlight, limit, links, figure } = entry.data;
const href = `/work/${entry.id}/`;
---

<article class="project" aria-labelledby={`p-${entry.id}`}>
  <div class="text">
    <p class="kicker">{org}</p>
    <h3 id={`p-${entry.id}`}><a href={href}>{title}</a></h3>
    <p class="meta ui">{role}, {dates}</p>
    <p class="overview">{overview}</p>
    <p class="contribution"><span class="label-ui">My part.</span> {contribution}</p>
    <dl class="triple">
      <div><dt>Claim</dt><dd>{claim}</dd></div>
      <div><dt>Result</dt><dd><Marked text={result} highlight={highlight} /></dd></div>
    </dl>
    <p class="limit"><span class="limit-label">Limit</span>{' '}{limit}</p>
    <ul class="link-row">
      <li><a href={href}>Full write-up</a></li>
      {links.slice(0, 2).map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </div>
  {
    figure && (
      <a class:list={['media frame', `fit-${figure.fit}`]} href={href} tabindex="-1" aria-hidden="true">
        <Image src={figure.src} alt="" widths={[480, 720, 960]} sizes="(max-width: 900px) 100vw, 520px" />
      </a>
    )
  }
</article>

<style>
  .project {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 24px clamp(28px, 4vw, 56px);
    align-items: start;
    padding-block: 40px;
    border-bottom: 1px solid var(--grid);
  }

  h3 {
    margin-top: 6px;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }

  h3 a {
    text-decoration: none;
  }

  h3 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.14em;
  }

  .meta {
    margin-top: 6px;
    font-size: 1rem;
    font-weight: 500;
    color: var(--graphite);
  }

  .overview {
    margin-top: 14px;
  }

  .contribution {
    margin-top: 10px;
    color: var(--ink-soft);
  }

  .triple {
    display: grid;
    gap: 8px;
    margin: 16px 0 0;
    padding-top: 14px;
    border-top: 1px dashed var(--grid);
  }

  .triple div {
    display: grid;
    grid-template-columns: 4.25rem minmax(0, 1fr);
    gap: 12px;
  }

  dt {
    padding-top: 0.2em;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 1rem;
    color: var(--graphite);
  }

  dd {
    margin: 0;
  }

  .limit {
    margin-top: 14px;
  }

  .link-row {
    margin-top: 8px;
  }

  .media {
    display: block;
    position: sticky;
    top: 24px;
  }

  .media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: top left;
    background: #fff;
    transition: transform 400ms ease;
  }

  .media:hover img {
    transform: scale(1.02);
  }

  .fit-contain img {
    object-fit: contain;
    object-position: center;
    padding: 12px;
  }

  @media (max-width: 900px) {
    .project {
      grid-template-columns: minmax(0, 1fr);
    }

    .media {
      position: static;
      order: -1;
    }

    .media img {
      aspect-ratio: 16 / 9;
    }
  }

  @media (max-width: 480px) {
    .triple div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
  }
</style>
