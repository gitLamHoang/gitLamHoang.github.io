---
// The recorded HARP crowd run as a figure: the graphite replay with a readout of simulation time,
// planner mode, and distance to goal, read frame by frame from the run's own log. Plays once, then
// offers Replay. Without JavaScript the video keeps native controls and the readout stays hidden.
import poster from '../assets/harp/film-poster.jpg';
import run from '../data/harp-crowd-run.json';

interface Props {
  /** Caption shown under the video. */
  caption?: boolean;
}

const { caption = true } = Astro.props;
const duration = run.frames[run.frames.length - 1].t;
const people = run.frames[0].p.length;
---

<figure class="replay" data-replay>
  <div class="replay-frame">
    <video
      data-replay-video
      muted
      playsinline
      controls
      preload="metadata"
      poster={poster.src}
      width="1600"
      height="900"
      aria-label={`Replay of a recorded simulation: HARP's Unitree G1 humanoid walks through a building past ${people} moving pedestrians to a goal marker, its path drawn in yellow.`}
    >
      <source src="/media/film-720x900.mp4" type="video/mp4" media="(max-width: 700px)" />
      <source src="/media/film-1600.mp4" type="video/mp4" />
    </video>

    <div class="readout tnum" data-ui>
      <dl aria-hidden="true">
        <div><dt>Sim time</dt><dd><span data-hud="time">0.0</span> / {duration.toFixed(1)} s</dd></div>
        <div><dt>Planner</dt><dd data-hud="mode">Follow</dd></div>
        <div><dt>To goal</dt><dd><span data-hud="goal">9.00</span> m</dd></div>
      </dl>
      <button type="button" class="replay-toggle" data-replay-toggle>Pause</button>
    </div>
  </div>
  {
    caption && (
      <figcaption class="replay-caption">
        <strong>Recorded run, replayed.</strong> A native MuJoCo Unitree G1 on HARP's GR00T walking policy, steered by the earlier
        sampling planner through a building with {people} moving pedestrians, recorded on Nov 1 before the rework. It reached the goal
        with {run.summary.contacts} contacts in {run.summary.seconds.toFixed(1)} s. The controller sees only its LiDAR tracks, drawn as
        pale discs; the robot's path is yellow. The readout is the run's log. Walls are cut to 0.9 m for visibility, and playback runs
        at 2.5×.
      </figcaption>
    )
  }
</figure>

<script>
  import run from '../data/harp-crowd-run.json';

  const SPEED = 2.5; // playback speed the video was rendered at
  const LABEL: Record<string, string> = { follow: 'Follow', evade: 'Evade', yield: 'Yield', blocked: 'Blocked', idle: 'Idle' };
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const frames = run.frames;

  for (const root of document.querySelectorAll<HTMLElement>('[data-replay]')) {
    const video = root.querySelector<HTMLVideoElement>('[data-replay-video]')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-replay-toggle]')!;
    const time = root.querySelector('[data-hud="time"]')!;
    const mode = root.querySelector('[data-hud="mode"]')!;
    const goal = root.querySelector('[data-hud="goal"]')!;
    let userPaused = reduce.matches;
    let last = -1;

    video.controls = false;
    root.dataset.live = '';

    const draw = () => {
      const i = Math.max(0, Math.min(frames.length - 1, Math.round(video.currentTime * SPEED * run.hz)));
      if (i === last) return;
      last = i;
      const f = frames[i];
      time.textContent = f.t.toFixed(1);
      goal.textContent = Math.hypot(run.goal[0] - f.r[0], run.goal[1] - f.r[1]).toFixed(2);
      mode.textContent = LABEL[f.m] ?? f.m;
    };
    const rvfc = 'requestVideoFrameCallback' in HTMLVideoElement.prototype;
    const tick = () => {
      draw();
      if (video.paused) return;
      if (rvfc) video.requestVideoFrameCallback(tick);
      else requestAnimationFrame(tick);
    };
    const sync = () => {
      toggle.textContent = video.ended ? 'Replay' : video.paused ? 'Play' : 'Pause';
    };

    toggle.addEventListener('click', () => {
      if (video.paused) {
        userPaused = false;
        if (video.ended) video.currentTime = 0;
        video.play().catch(sync);
      } else {
        userPaused = true;
        video.pause();
      }
    });
    video.addEventListener('play', () => {
      sync();
      tick();
    });
    video.addEventListener('pause', sync);
    video.addEventListener('ended', sync);
    video.addEventListener('seeked', draw);
    video.addEventListener('loadeddata', draw);

    // Plays once while on screen; never on its own under reduced motion.
    new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) {
          if (!userPaused && !video.ended) video.play().catch(sync);
        } else video.pause();
      },
      { threshold: 0.4 },
    ).observe(video);
    sync();
  }
</script>

<style>
  .replay {
    margin: 0;
  }

  .replay-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--surface);
  }

  video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .readout {
    display: none;
  }

  [data-live] .readout {
    position: absolute;
    top: var(--margin);
    right: var(--margin);
    display: grid;
    justify-items: end;
    gap: 12px;
    padding: 14px 16px 16px;
    background: rgb(21 24 29 / 0.9);
    font-size: var(--step-small);
  }

  dl {
    display: grid;
    grid-template-columns: auto auto;
    gap: 2px 16px;
    margin: 0;
    text-align: right;
  }

  dl div {
    display: contents;
  }

  dt {
    color: var(--muted);
  }

  dd {
    margin: 0;
    min-width: 7.5ch;
  }

  .replay-toggle {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border: 0;
    background: var(--surface-2);
    font-size: var(--step-small);
    font-weight: 500;
    cursor: pointer;
    transition: transform var(--dur-press) var(--ease-out), background-color var(--dur-ui) ease;
  }

  .replay-toggle:active {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    .replay-toggle:hover {
      background: #2a2f37;
    }
  }

  .replay-caption {
    margin-top: 14px;
    max-width: 78ch;
    color: var(--muted);
    font-size: var(--step-small);
  }

  .replay-caption strong {
    color: var(--ink);
    font-weight: 500;
  }

  @media (max-width: 700px) {
    .replay-frame {
      aspect-ratio: 4 / 5;
    }

    [data-live] .readout {
      top: 12px;
      right: 12px;
      padding: 10px 12px 12px;
    }
  }
</style>
