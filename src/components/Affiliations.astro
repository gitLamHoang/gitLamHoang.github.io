---
import { affiliations } from '../data/profile';
---

<section class="affiliations wrap" aria-labelledby="affiliations-title">
  <h2 id="affiliations-title" class="label-ui">Where I've worked, studied, and competed</h2>
  <ul>
    {
      affiliations.map((a) => (
        <li>
          <span class="org">{a.name}</span>
          <span class="note">{a.note}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .affiliations {
    padding-top: clamp(36px, 5vw, 56px);
  }

  h2 {
    font-size: 1rem;
    margin-bottom: 12px;
  }

  /* An even 3 by 3 grid: every cell the same width, every row the same height. */
  ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1.5px solid var(--ink);
    border-left: 1px solid var(--grid);
  }

  li {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    min-height: 92px;
    padding: 16px 20px;
    border-right: 1px solid var(--grid);
    border-bottom: 1px solid var(--grid);
    background: color-mix(in srgb, var(--paper-raised) 70%, transparent);
  }

  .org {
    font-family: var(--font-ui);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.005em;
  }

  .note {
    font-family: var(--font-ui);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--graphite);
  }

  li:first-child .org {
    color: var(--pen);
  }

  @media (max-width: 760px) {
    ul {
      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: auto;
    }

    li {
      min-height: 0;
      padding: 12px 16px;
    }
  }
</style>
