---
// The home page's first screen: a screen-printed night poster of Stanford. The headline sits in the
// sky, the side tabs lead to the work and the letter, and the strip along the bottom is Harvey's
// route from Hanoi to HARP. The scene plays once: windows light, the plan draws, the robot walks it.
import NightScene from './NightScene.astro';
import { contact } from '../data/profile';

const route = [
  { label: 'HUST', year: '2024', href: '/#experience' },
  { label: 'HNUE', year: '2025', href: '/#experience' },
  { label: 'Brown', year: '2025', href: '/#experience' },
  { label: 'Pfizer', year: '2026', href: '/#work-pharma-document-processing' },
  { label: 'Stanford', year: '2026', href: '/#education' },
  { label: 'HARP', year: 'now', href: '/#work-harp-crowd-navigation', current: true },
];
---

<section class="poster" aria-labelledby="hero-title" data-poster>
  <NightScene />

  <div class="copy">
    <h1 id="hero-title" class="display">
      <span class="l1">Harvey Phan</span>
      <span class="l2">steers robots through crowds</span>
    </h1>
    <p class="lede">Stanford CS. I lead navigation on HARP's Unitree G1 humanoid, and I write down what it can't do yet.</p>
    <div class="acts">
      <a class="pill" href={contact.resume} download="Harvey_Phan_Resume.pdf">Download my resume</a>
      <a class="write" href={`mailto:${contact.email}`}>or write to me</a>
    </div>
  </div>

  <a class="tab tab-left" href="#work"><span>Work</span></a>
  <a class="tab tab-right" href="#contact"><span>Write to me</span></a>

  <nav class="route" aria-label="My route so far">
    <ol>
      {
        route.map((r) => (
          <li>
            <a href={r.href} aria-current={r.current ? 'step' : undefined}>
              {r.label} <span class="yr">{r.year}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</section>
<div data-poster-end aria-hidden="true"></div>

<script>
  const root = document.querySelector<HTMLElement>('[data-poster]');
  const scene = root?.querySelector<SVGSVGElement>('[data-scene]');
  if (root && scene) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wins = [...scene.querySelectorAll<SVGElement>('.win')];
    wins.forEach((w, i) => w.style.setProperty('--w', String(i % 24)));

    const route = scene.querySelector<SVGPathElement>('[data-route]')!;
    const reveal = scene.querySelector<SVGPathElement>('[data-route-reveal]')!;
    const robot = scene.querySelector<SVGGElement>('[data-robot]')!;
    const walkers = [...scene.querySelectorAll<SVGGElement>('.walker')].map((g) => {
      const [, x, y] = /translate\(([-\d.]+) ([-\d.]+)\)/.exec(g.getAttribute('transform')!)!.map(Number);
      return { g, x, y, d: Number(g.dataset.drift) };
    });
    const L = route.getTotalLength();
    reveal.style.strokeDasharray = `${L}`;

    const place = (p: number, q: number) => {
      // p: how much of the plan is drawn; q: how far the robot has walked along it.
      reveal.style.strokeDashoffset = `${L * (1 - p)}`;
      const pt = route.getPointAtLength(L * q);
      robot.setAttribute('transform', `translate(${pt.x.toFixed(1)} ${pt.y.toFixed(1)})`);
      for (const w of walkers) w.g.setAttribute('transform', `translate(${(w.x + w.d * q).toFixed(1)} ${w.y})`);
    };

    if (reduce) {
      scene.classList.add('is-lit');
      place(1, 1);
    } else {
      place(0, 0);
      const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);
      const DRAW = 1600;
      const WALK = 13000;
      let t0 = 0;
      const frame = (now: number) => {
        if (!t0) t0 = now;
        const t = now - t0;
        const p = Math.min(1, t / DRAW);
        const q = Math.min(1, Math.max(0, (t - DRAW * 0.6) / WALK));
        place(ease(p), ease(q));
        if (q > 0 && q < 1) scene.classList.add('is-walking');
        if (q >= 1) scene.classList.remove('is-walking');
        else requestAnimationFrame(frame);
      };
      requestAnimationFrame(() => {
        scene.classList.add('is-lit');
        requestAnimationFrame(frame);
      });

      // The layers drift apart as the poster scrolls away: far ones slow, near ones fast.
      const layers = [...scene.querySelectorAll<SVGGElement>('[data-layer]')].map((g) => ({ g, k: Number(g.dataset.layer) }));
      let queued = false;
      const drift = () => {
        queued = false;
        const y = Math.min(scrollY, innerHeight);
        for (const l of layers) l.g.style.transform = `translateY(${(y * l.k * 0.55).toFixed(1)}px)`;
      };
      addEventListener('scroll', () => {
        if (queued || scrollY > innerHeight * 1.2) return;
        queued = true;
        requestAnimationFrame(drift);
      }, { passive: true });
    }
  }
</script>

<style>
  .poster {
    position: relative;
    min-height: 100dvh;
    overflow: hidden;
    background: #091127;
    isolation: isolate;
  }

  /* ---------- headline in the sky ---------- */

  .copy {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: var(--space-300);
    padding: calc(var(--space-900) + var(--space-900)) var(--gutter) 0;
    text-align: center;
  }

  h1 {
    display: grid;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 0.92;
    letter-spacing: 0.005em;
    text-wrap: balance;
  }

  .l1 {
    color: var(--text);
    font-size: clamp(3.25rem, 9vw, 8rem);
  }

  .l2 {
    color: var(--accent);
    font-size: clamp(2.25rem, 6.2vw, 5.75rem);
  }

  .lede {
    max-width: 36rem;
    color: var(--text);
    font-size: 1.125rem;
    line-height: 1.75rem;
    text-shadow: 0 1px 12px rgb(9 17 39 / 0.8);
  }

  .acts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-200) var(--space-300);
  }

  /* The vermilion pill with a cream ring, as on a printed ticket. */
  .pill {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: var(--space-100) var(--space-400);
    border-radius: var(--radius-full);
    background: var(--accent);
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
    box-shadow:
      inset 0 0 0 2px #e4502f,
      inset 0 0 0 4px #f3c9a3;
    transition:
      transform var(--dur-fade) var(--ease),
      background-color var(--dur-fade) var(--ease);
  }

  .pill:active {
    transform: scale(0.98);
  }

  .write {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text);
    font-family: var(--font-serif);
  }

  @media (hover: hover) and (pointer: fine) {
    .pill:hover {
      background: #ef5d3b;
      transform: translateY(-2px);
    }
  }

  /* ---------- the side tabs, gold outlined, set vertically ---------- */

  .tab {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-300) var(--space-75);
    border: 1.5px solid var(--gold);
    color: var(--text);
    font-family: var(--font-serif);
    font-size: 0.875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    writing-mode: vertical-rl;
    transition:
      background-color var(--dur-fade) var(--ease),
      transform var(--dur-fade) var(--ease);
  }

  .tab::before,
  .tab::after {
    content: '';
    width: 6px;
    height: 6px;
    margin: var(--space-75) 0;
    border: 1.5px solid var(--gold);
    border-radius: var(--radius-full);
  }

  .tab-left {
    left: 0;
    border-left: 0;
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    transform: translateY(-50%) rotate(180deg);
  }

  .tab-right {
    right: 0;
    border-right: 0;
    border-radius: var(--radius-lg) 0 0 var(--radius-lg);
    transform: translateY(-50%);
  }

  @media (hover: hover) and (pointer: fine) {
    .tab:hover {
      background: rgb(217 164 65 / 0.14);
    }
  }

  /* ---------- the route strip along the bottom ---------- */

  .route {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: var(--space-300);
    z-index: 2;
    padding-top: var(--space-200);
    border-top: 1px solid rgb(239 227 198 / 0.28);
  }

  .route ol {
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: var(--space-75) var(--space-300);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .route a {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-75);
    min-height: 44px;
    align-items: center;
    color: var(--text);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color var(--dur-fade) var(--ease);
  }

  .yr {
    color: var(--text-2);
    font-weight: 500;
  }

  .route a[aria-current] {
    color: var(--accent);
  }

  .route a[aria-current] .yr {
    color: var(--accent);
  }

  @media (hover: hover) and (pointer: fine) {
    .route a:hover {
      color: var(--gold);
    }
  }

  @media (max-width: 760px) {
    .copy {
      padding-top: calc(var(--space-900) + var(--space-400));
    }

    .lede {
      font-size: 1rem;
      line-height: 1.5rem;
    }

    .tab {
      display: none;
    }

    .route ol {
      justify-content: flex-start;
      gap: 0 var(--space-200);
    }

    .route a {
      min-height: 36px;
      font-size: 0.75rem;
      letter-spacing: 0.12em;
    }
  }
</style>
