---
// The home page's first screen: a screen-printed night poster of Stanford. The headline sits in the
// sky, the side tabs lead to the work and the letter, and the strip along the bottom is Harvey's
// route from Hanoi to HARP. The scene plays once: windows light, the plan draws, the robot walks it.
import NightScene from './NightScene.astro';
import Fronds from './Fronds.astro';
import { contact } from '../data/profile';

const route = [
  { label: 'HUST', year: '2024', href: '/#experience' },
  { label: 'HNUE', year: '2025', href: '/#experience' },
  { label: 'Brown', year: '2025', href: '/#experience' },
  { label: 'Pfizer', year: '2026', href: '/#work-pharma-document-processing' },
  { label: 'Stanford', year: '2026', href: '/#education' },
  { label: 'HARP', year: 'now', href: '/#work-harp-crowd-navigation', current: true },
];
---

<section class="poster" aria-labelledby="hero-title" data-poster>
  <NightScene />
  <Fronds corner="tl" />
  <Fronds corner="tr" />
  <Fronds corner="bl" />
  <Fronds corner="br" />

  <div class="copy">
    <h1 id="hero-title" class="display">
      <span class="l1">Harvey’s Hub</span>
      <span class="l2">Robots, research, and receipts</span>
    </h1>
    <p class="lede">I'm Harvey Phan, Stanford CS. I lead navigation on HARP's Unitree G1 humanoid, and I write down what it can't do yet.</p>
    <div class="acts">
      <a class="pill" href={contact.resume} download="Harvey_Phan_Resume.pdf">Download my resume</a>
      <a class="write" href={`mailto:${contact.email}`}>or write to me</a>
    </div>
  </div>

  <a class="tab tab-left" href="#work"><span>Work</span></a>
  <a class="tab tab-right" href="#contact"><span>Write to me</span></a>

  <nav class="route" aria-label="My route so far">
    <ol>
      {
        route.map((r) => (
          <li>
            <a href={r.href} aria-current={r.current ? 'step' : undefined}>
              {r.label} <span class="yr">{r.year}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</section>
<div data-poster-end aria-hidden="true"></div>

<script>
  const root = document.querySelector<HTMLElement>('[data-poster]');
  const scene = root?.querySelector<SVGSVGElement>('[data-scene]');
  if (root && scene) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wins = [...scene.querySelectorAll<SVGElement>('.win')];
    wins.forEach((w, i) => w.style.setProperty('--w', String(i % 24)));

    const route = scene.querySelector<SVGPathElement>('[data-route]')!;
    const reveal = scene.querySelector<SVGPathElement>('[data-route-reveal]')!;
    const robot = scene.querySelector<SVGGElement>('[data-robot]')!;
    const walkers = [...scene.querySelectorAll<SVGGElement>('.walker')].map((g, i) => {
      const [, x, y] = /translate\(([-\d.]+) ([-\d.]+)\)/.exec(g.getAttribute('transform')!)!.map(Number);
      return { g, x, y, d: Number(g.dataset.drift), phase: i * 0.9 };
    });
    const L = route.getTotalLength();
    reveal.style.strokeDasharray = `${L}`;

    const drawPlan = (p: number) => (reveal.style.strokeDashoffset = `${L * (1 - p)}`);
    const placeRobot = (q: number) => {
      const pt = route.getPointAtLength(L * q);
      robot.setAttribute('transform', `translate(${pt.x.toFixed(1)} ${pt.y.toFixed(1)})`);
    };
    // People keep crossing back and forth slowly, each on its own beat.
    const placeWalkers = (t: number) => {
      for (const w of walkers) {
        const k = Math.sin(t / 7000 + w.phase);
        w.g.setAttribute('transform', `translate(${(w.x + w.d * k).toFixed(1)} ${w.y})`);
      }
    };

    // Depth: every layer, the near fronds included, drifts with the scroll (a slow crane up) and,
    // with a mouse, leans away from the pointer, eased so it settles like a camera on a head.
    const layers = [...root.querySelectorAll<HTMLElement | SVGGElement>('[data-layer]')].map((g) => ({ g, k: Number(g.dataset.layer) }));
    let px = 0;
    let py = 0;
    let tx = 0;
    let ty = 0;
    if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
      root.addEventListener('pointermove', (e) => {
        tx = (e.clientX / innerWidth) * 2 - 1;
        ty = (e.clientY / innerHeight) * 2 - 1;
      });
      root.addEventListener('pointerleave', () => {
        tx = 0;
        ty = 0;
      });
    }
    const placeLayers = () => {
      px += (tx - px) * 0.05;
      py += (ty - py) * 0.05;
      const y = Math.min(scrollY, innerHeight);
      for (const l of layers) {
        l.g.style.transform = `translate(${(-px * l.k * 26).toFixed(2)}px, ${(y * l.k * 0.55 - py * l.k * 12).toFixed(2)}px)`;
      }
    };

    if (reduce) {
      scene.classList.add('is-lit', 'is-arrived');
      drawPlan(1);
      placeRobot(1);
    } else {
      const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);
      const DRAW = 1600;
      const WALK = 13000;
      let start = 0;
      let running = false;
      let visible = true;

      const frame = (now: number) => {
        if (!start) start = now;
        const t = now - start;
        drawPlan(ease(Math.min(1, t / DRAW)));
        const q = Math.min(1, Math.max(0, (t - DRAW * 0.6) / WALK));
        placeRobot(ease(q));
        scene.classList.toggle('is-walking', q > 0 && q < 1);
        scene.classList.toggle('is-arrived', q >= 1);
        placeWalkers(now);
        placeLayers();
        if (visible) requestAnimationFrame(frame);
        else running = false;
      };
      const run = (restart: boolean) => {
        if (restart) start = 0;
        if (running) return;
        running = true;
        requestAnimationFrame(frame);
      };

      requestAnimationFrame(() => scene.classList.add('is-lit'));
      // While the poster is on screen it lives; when it comes back, the robot walks its route again.
      let left = false;
      new IntersectionObserver(([e]) => {
        visible = e.isIntersecting;
        scene.classList.toggle('is-live', visible);
        if (visible) {
          run(left);
          left = false;
        } else left = true;
      }, { threshold: 0.15 }).observe(root);

    }
  }
</script>

<style>
  .poster {
    position: relative;
    min-height: 100dvh;
    overflow: hidden;
    background: #091127;
    isolation: isolate;
  }

  /* A lens: the corners fall off, and the top darkens under the nav. */
  .poster::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(130% 95% at 50% 44%, transparent 56%, rgb(3 6 18 / 0.6) 100%),
      linear-gradient(to bottom, rgb(3 6 18 / 0.4), transparent 16%);
  }

  /* The opening shot: the camera settles in while the title rises like a card. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .poster :global(.scene) {
      transform-origin: 50% 78%;
      will-change: transform;
      animation: push-in 3.8s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    :global(html.js) .l1,
    :global(html.js) .l2 {
      animation: title-in 1.4s var(--ease) both;
    }

    :global(html.js) .l1 {
      animation-delay: 200ms;
    }

    :global(html.js) .l2 {
      animation-delay: 420ms;
    }

    :global(html.js) .lede {
      animation: fade-up 1s var(--ease) 800ms both;
    }

    :global(html.js) .acts {
      animation: fade-up 1s var(--ease) 950ms both;
    }
  }

  @keyframes push-in {
    from {
      opacity: 0.35;
      transform: scale(1.09);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes title-in {
    from {
      opacity: 0;
      transform: translateY(0.3em);
      filter: blur(8px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ---------- headline in the sky ---------- */

  .copy {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: var(--space-300);
    padding: calc(var(--space-900) + var(--space-900)) var(--gutter) 0;
    text-align: center;
  }

  h1 {
    display: grid;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 0.92;
    letter-spacing: 0.005em;
    text-wrap: balance;
  }

  .l1 {
    color: var(--text);
    font-size: clamp(3.25rem, 9vw, 8rem);
  }

  .l2 {
    color: var(--accent);
    font-size: clamp(2.25rem, 6.2vw, 5.75rem);
  }

  .lede {
    max-width: 36rem;
    color: var(--text);
    font-size: 1.125rem;
    line-height: 1.75rem;
    text-shadow: 0 1px 12px rgb(9 17 39 / 0.8);
  }

  .acts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-200) var(--space-300);
  }

  /* The vermilion pill with a cream ring, as on a printed ticket. */
  .pill {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: var(--space-100) var(--space-400);
    border-radius: var(--radius-full);
    background: var(--accent);
    color: var(--bg);
    font-weight: 600;
    text-decoration: none;
    box-shadow:
      inset 0 0 0 2px #e4502f,
      inset 0 0 0 4px #f3c9a3;
    transition:
      transform var(--dur-fade) var(--ease),
      background-color var(--dur-fade) var(--ease);
  }

  .pill:active {
    transform: scale(0.98);
  }

  .write {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text);
    font-family: var(--font-serif);
  }

  @media (hover: hover) and (pointer: fine) {
    .pill:hover {
      background: #ef5d3b;
      transform: translateY(-2px);
    }
  }

  /* ---------- the side tabs, gold outlined, set vertically ---------- */

  .tab {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-300) var(--space-75);
    border: 1.5px solid var(--gold);
    color: var(--text);
    font-family: var(--font-serif);
    font-size: 0.875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    writing-mode: vertical-rl;
    transition:
      background-color var(--dur-fade) var(--ease),
      transform var(--dur-fade) var(--ease);
  }

  .tab::before,
  .tab::after {
    content: '';
    width: 6px;
    height: 6px;
    margin: var(--space-75) 0;
    border: 1.5px solid var(--gold);
    border-radius: var(--radius-full);
  }

  .tab-left {
    left: 0;
    border-left: 0;
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    transform: translateY(-50%) rotate(180deg);
  }

  .tab-right {
    right: 0;
    border-right: 0;
    border-radius: var(--radius-lg) 0 0 var(--radius-lg);
    transform: translateY(-50%);
  }

  @media (hover: hover) and (pointer: fine) {
    .tab:hover {
      background: rgb(217 164 65 / 0.14);
    }
  }

  /* ---------- the route strip along the bottom ---------- */

  .route {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: var(--space-300);
    z-index: 2;
    padding-top: var(--space-200);
    border-top: 1px solid rgb(239 227 198 / 0.28);
  }

  .route ol {
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: var(--space-75) var(--space-300);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .route a {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-75);
    min-height: 44px;
    align-items: center;
    color: var(--text);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color var(--dur-fade) var(--ease);
  }

  .yr {
    color: var(--text-2);
    font-weight: 500;
  }

  .route a[aria-current] {
    color: var(--accent);
  }

  .route a[aria-current] .yr {
    color: var(--accent);
  }

  @media (hover: hover) and (pointer: fine) {
    .route a:hover {
      color: var(--gold);
    }
  }

  @media (max-width: 760px) {
    .copy {
      padding-top: calc(var(--space-900) + var(--space-400));
    }

    .lede {
      font-size: 1rem;
      line-height: 1.5rem;
    }

    .tab {
      display: none;
    }

    /* One row on phones, scrolled sideways, so the strip never climbs onto the plaza. */
    .route {
      bottom: var(--space-100);
    }

    .route ol {
      flex-wrap: nowrap;
      justify-content: flex-start;
      gap: 0 var(--space-300);
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .route ol::-webkit-scrollbar {
      display: none;
    }

    .route li {
      flex: none;
    }

    .route a {
      min-height: 36px;
      font-size: 0.75rem;
      letter-spacing: 0.12em;
    }
  }
</style>
