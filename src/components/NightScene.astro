---
// Stanford at night, screen-printed: Hoover Tower, the Main Quad arcade and Memorial Church, Palm
// Drive's palms, oaks on the hills, a full moon, and the plaza where a small G1 walks its waypoints
// between people. Flat ink layers with halftone where light falls, slightly misregistered, so it
// reads as a print. Each layer can move on its own: the windows light, the plan draws, the robot
// walks it, the stars and lamps keep breathing, and the layers drift apart as the page scrolls.

// Deterministic stars, so every build draws the same sky.
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const stars = Array.from({ length: 90 }, () => ({
  x: Math.round(rand() * 1440),
  y: Math.round(rand() * 480),
  r: +(0.6 + rand() * 1.4).toFixed(2),
  o: +(0.3 + rand() * 0.6).toFixed(2),
  d: +(rand() * 6).toFixed(2),
}));

// The brightest stars get a four-point sparkle.
const sparkles = [
  [118, 128, 7], [362, 112, 6], [612, 156, 5], [858, 118, 8], [1100, 300, 5], [1396, 300, 6], [1090, 92, 4], [60, 330, 5],
];

// Long, thin cloud bands drifting under the moon: y, x start, length, thickness.
const clouds = [
  [236, 1040, 380, 10],
  [262, 1060, 360, 6],
  [404, 1040, 400, 8],
  [120, 40, 380, 7],
];

// Arcade openings along the Main Quad, leaving room for the church.
const arches = Array.from({ length: 15 }, (_, i) => 540 + i * 62).filter((x) => x < 860 || x > 1130);

// Oaks on the foothills: x, y, radius.
const oaks = [
  [380, 620, 26], [430, 612, 34], [720, 598, 30], [770, 604, 24], [1180, 596, 32], [1235, 606, 26], [1300, 600, 30], [1390, 610, 34],
];

// Palm Drive: x, base, top, scale (near palms large, far ones small).
const palms = [
  [470, 690, 400, 1], [604, 640, 430, 0.9], [1216, 640, 386, 1], [1378, 650, 418, 0.95],
  [1290, 600, 470, 0.55], [1335, 600, 482, 0.5], [1160, 598, 488, 0.45], [680, 600, 476, 0.5],
];

// Frond tips, shared by every palm crown.
const fronds = [
  [-74, 18], [76, 16], [-66, -36], [68, -32], [22, -62], [-54, 46], [56, 46],
];

// Painted brush strokes: long tapered marks across the sky and the plaza, each a lens shape.
const stroke = (x: number, y: number, len: number, w: number, bend: number) =>
  `M${x} ${y} Q ${x + len / 2} ${y - w - bend} ${x + len} ${y} Q ${x + len / 2} ${y + w * 0.6 - bend} ${x} ${y} Z`;
const skyStrokes = Array.from({ length: 46 }, () => ({
  d: stroke(Math.round(rand() * 1500 - 80), Math.round(40 + rand() * 470), 120 + rand() * 360, 1.5 + rand() * 4, rand() * 6 - 3),
  c: rand() > 0.5 ? '#1b2b5a' : '#0a1330',
  o: +(0.25 + rand() * 0.45).toFixed(2),
}));
const groundStrokes = Array.from({ length: 34 }, () => ({
  d: stroke(Math.round(rand() * 1500 - 80), Math.round(712 + rand() * 108), 80 + rand() * 260, 1 + rand() * 2.5, rand() * 2 - 1),
  c: rand() > 0.55 ? '#1e3060' : '#0a1330',
  o: +(0.3 + rand() * 0.4).toFixed(2),
}));

// Lights of houses up in the foothills.
const townLights = Array.from({ length: 34 }, () => ({
  x: Math.round(rand() * 1440),
  y: Math.round(588 + rand() * 40),
  r: +(0.8 + rand() * 0.9).toFixed(2),
}));

// The Quad's upper floor, behind the arcade: window x positions, a few left dark.
const upper = Array.from({ length: 29 }, (_, i) => 530 + i * 31).filter((x) => x < 872 || x > 1140);

// Planner rollouts fanning out ahead of the robot: end point of each candidate path.
const rollouts = [
  [62, -30], [70, -20], [76, -10], [80, 0], [78, 10], [72, 20], [64, 28],
];

// People crossing the plaza: x, y (feet), height, drift distance.
const walkers = [
  { x: 430, y: 796, h: 44, d: 70 },
  { x: 575, y: 752, h: 34, d: -50 },
  { x: 640, y: 808, h: 46, d: 60 },
  { x: 770, y: 770, h: 38, d: -60 },
  { x: 845, y: 804, h: 44, d: 50 },
  { x: 945, y: 744, h: 30, d: 40 },
  { x: 1125, y: 784, h: 40, d: -70 },
  { x: 1230, y: 806, h: 46, d: 50 },
  { x: 1330, y: 758, h: 34, d: -40 },
];

// The robot's planned route: start, three waypoints, the church steps.
const route = 'M 214 812 C 320 806, 400 782, 500 788 S 616 808, 700 786 S 806 744, 892 752 S 984 734, 1010 714';
const waypoints = [
  [500, 788],
  [700, 786],
  [892, 752],
  [1010, 714],
];
const lamps = [
  [400, 744],
  [880, 728],
  [1186, 748],
];
---

<svg
  class="scene"
  viewBox="0 0 1440 900"
  preserveAspectRatio="xMidYMax slice"
  role="img"
  aria-label="Illustration: Stanford at night. Hoover Tower and the Main Quad with Memorial Church stand under a full moon; on the plaza a small humanoid robot walks a dotted route between people."
  data-scene
>
  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#091127" />
      <stop offset="0.72" stop-color="#121f45" />
      <stop offset="1" stop-color="#1a2b55" />
    </linearGradient>
    <linearGradient id="plaza" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#16244a" />
      <stop offset="1" stop-color="#0a1229" />
    </linearGradient>

    <!-- Halftone screens: cream for moonlight, gold for lamplight. -->
    <pattern id="dots" width="5" height="5" patternUnits="userSpaceOnUse">
      <circle cx="2.5" cy="2.5" r="1.15" fill="#efe3c6" />
    </pattern>
    <pattern id="dotsFine" width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(30)">
      <circle cx="2" cy="2" r="0.9" fill="#efe3c6" />
    </pattern>
    <pattern id="dotsGold" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(15)">
      <circle cx="2.5" cy="2.5" r="1.3" fill="#f0b860" />
    </pattern>
    <!-- Line screens for engraved detail: roof tiles, stone courses, mosaic tesserae. -->
    <pattern id="tiles" width="6" height="18" patternUnits="userSpaceOnUse">
      <path d="M0.5 0 L0.5 18" stroke="#3e1a22" stroke-width="1.4" />
      <path d="M3.5 0 L3.5 18" stroke="#b4664a" stroke-width="0.7" stroke-opacity="0.6" />
    </pattern>
    <pattern id="courses" width="12" height="9" patternUnits="userSpaceOnUse">
      <path d="M0 8.5 L12 8.5" stroke="#0f1a39" stroke-width="1" />
      <path d="M6 0 L6 8.5" stroke="#0f1a39" stroke-width="0.6" stroke-opacity="0.6" />
    </pattern>
    <pattern id="hatch" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(-38)">
      <path d="M0 2.5 L5 2.5" stroke="#081029" stroke-width="1.1" />
    </pattern>
    <pattern id="tesserae" width="4" height="4" patternUnits="userSpaceOnUse">
      <rect width="3.2" height="3.2" fill="#d6a94e" />
      <rect x="0.6" y="0.6" width="1.2" height="1.2" fill="#f1cf80" />
    </pattern>

    <!-- Masks that fade a screen out from its light source. -->
    <radialGradient id="fadeRound">
      <stop offset="0" stop-color="#fff" stop-opacity="1" />
      <stop offset="0.55" stop-color="#fff" stop-opacity="0.35" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="litRight" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0.35" stop-color="#fff" stop-opacity="0" />
      <stop offset="1" stop-color="#fff" stop-opacity="0.9" />
    </linearGradient>
    <linearGradient id="litTop" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity="0.85" />
      <stop offset="0.7" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
    <radialGradient id="litMoon" cx="0.68" cy="0.32" r="0.75">
      <stop offset="0" stop-color="#fff" stop-opacity="0.85" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </radialGradient>
    <mask id="mGlow" maskUnits="userSpaceOnUse" x="900" y="0" width="540" height="480">
      <circle cx="1238" cy="158" r="250" fill="url(#fadeRound)" />
      <circle cx="1238" cy="158" r="60" fill="#000" />
    </mask>
    <linearGradient id="hazeFade" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity="0" />
      <stop offset="0.6" stop-color="#fff" stop-opacity="0.9" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
    <mask id="mHaze" maskUnits="userSpaceOnUse" x="0" y="560" width="1440" height="90"><rect x="0" y="560" width="1440" height="90" fill="url(#hazeFade)" /></mask>
    <linearGradient id="streakFade" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity="0.95" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
    <mask id="mStreak" maskUnits="userSpaceOnUse" x="0" y="700" width="1440" height="140">
      {[[400, 744], [880, 728], [1186, 748]].map(([x, y]) => <rect x={x - 4} y={y + 48} width="8" height="58" fill="url(#streakFade)" />)}
    </mask>
    <mask id="mTower"><rect x="200" y="190" width="100" height="520" fill="url(#litRight)" /></mask>
    <mask id="mQuad"><rect x="520" y="470" width="920" height="240" fill="url(#litTop)" /></mask>
    <mask id="mMoon"><circle cx="1238" cy="158" r="56" fill="url(#litMoon)" /></mask>
    <mask id="mLamp" maskUnits="userSpaceOnUse" x="0" y="640" width="1440" height="220">
      {lamps.map(([x, y]) => <ellipse cx={x} cy={y + 46} rx="110" ry="30" fill="url(#fadeRound)" />)}
    </mask>
    <mask id="mHalo" maskUnits="userSpaceOnUse" x="0" y="640" width="1440" height="220">
      {lamps.map(([x, y]) => <circle cx={x} cy={y - 8} r="28" fill="url(#fadeRound)" />)}
    </mask>
    <clipPath id="cTower">
      <path d="M207 700 L215 330 L285 330 L293 700 Z" />
      <rect x="209" y="290" width="82" height="40" />
      <path d="M214 282 C 214 246, 236 230, 250 230 C 264 230, 286 246, 286 282 Z" />
    </clipPath>
    <clipPath id="cQuad">
      <rect x="520" y="596" width="920" height="108" />
      <path d="M884 704 L884 560 L1010 470 L1136 560 L1136 704 Z" />
    </clipPath>
    <!-- The plan draws itself ahead of the robot: a solid copy of the route reveals the dotted one. -->
    <mask id="mRoute" maskUnits="userSpaceOnUse" x="0" y="600" width="1440" height="300">
      <path d={route} fill="none" stroke="#fff" stroke-width="34" stroke-linecap="round" data-route-reveal />
    </mask>
  </defs>

  <!-- sky, stars, the moon and its halftone glow -->
  <g data-layer="0.08">
    <rect width="1440" height="900" fill="url(#sky)" />
    <g class="brush">{skyStrokes.map((b) => <path d={b.d} fill={b.c} opacity={b.o} />)}</g>
    <rect x="900" y="0" width="540" height="480" fill="url(#dotsFine)" mask="url(#mGlow)" opacity="0.55" class="glow" />
    {stars.map((s) => <circle class="star" cx={s.x} cy={s.y} r={s.r} fill="#efe3c6" opacity={s.o} style={`--d:${s.d}s;--o:${s.o}`} />)}
    <g class="sparkles" stroke="#efe3c6" stroke-linecap="round">
      {sparkles.map(([x, y, r], i) => (
        <g class="star" style={`--d:${i * 0.7}s;--o:0.9`}>
          <path d={`M${x - r} ${y} L${x + r} ${y} M${x} ${y - r} L${x} ${y + r}`} stroke-width="1.2" />
          <path d={`M${x - r * 0.4} ${y - r * 0.4} L${x + r * 0.4} ${y + r * 0.4} M${x - r * 0.4} ${y + r * 0.4} L${x + r * 0.4} ${y - r * 0.4}`} stroke-width="0.8" stroke-opacity="0.6" />
          <circle cx={x} cy={y} r="1.4" fill="#efe3c6" stroke="none" />
        </g>
      ))}
    </g>
    <g class="moon">
      <circle cx="1241" cy="161" r="56" fill="#b9a983" opacity="0.5" />
      <circle cx="1238" cy="158" r="56" fill="#e9dcbc" />
      <circle cx="1238" cy="158" r="56" fill="url(#dots)" mask="url(#mMoon)" opacity="0.6" />
      <g fill="#cdbd98" opacity="0.75">
        <circle cx="1222" cy="140" r="11" />
        <circle cx="1255" cy="172" r="8" />
        <circle cx="1230" cy="182" r="5" />
        <circle cx="1260" cy="135" r="4" />
        <circle cx="1210" cy="166" r="3.5" />
      </g>
      <g fill="none" stroke="#b8a77f" stroke-width="1.2">
        <path d="M1213 136 A11 11 0 0 1 1231 133" />
        <path d="M1249 168 A8 8 0 0 1 1262 167" />
        <path d="M1226 179 A5 5 0 0 1 1234 178" />
      </g>
      <path d="M1186 170 A56 56 0 0 0 1270 205" fill="none" stroke="#c9b991" stroke-width="2" stroke-opacity="0.6" />
      <circle cx="1238" cy="158" r="56" fill="none" stroke="#f5ecd5" stroke-width="1.2" stroke-opacity="0.7" />
    </g>
    <!-- clouds: halftone bands with a moonlit upper edge -->
    <g class="clouds">
      {clouds.map(([y, x, len, t]) => (
        <g>
          <path d={`M${x} ${y} C ${x + len * 0.2} ${y - t * 1.6}, ${x + len * 0.5} ${y - t * 1.2}, ${x + len * 0.62} ${y - t * 0.4} S ${x + len * 0.9} ${y - t * 1.1}, ${x + len} ${y} Z`} fill="#1b2b56" />
          <path d={`M${x} ${y} C ${x + len * 0.2} ${y - t * 1.6}, ${x + len * 0.5} ${y - t * 1.2}, ${x + len * 0.62} ${y - t * 0.4} S ${x + len * 0.9} ${y - t * 1.1}, ${x + len} ${y} Z`} fill="url(#dotsFine)" opacity="0.3" />
          <path d={`M${x + len * 0.08} ${y - t * 0.8} C ${x + len * 0.25} ${y - t * 1.7}, ${x + len * 0.45} ${y - t * 1.3}, ${x + len * 0.6} ${y - t * 0.6}`} fill="none" stroke="#efe3c6" stroke-opacity="0.4" stroke-width="1.2" />
          <path d={`M${x + len * 0.05} ${y + 3} L${x + len * 0.95} ${y + 3}`} stroke="#0d1838" stroke-width="2" />
        </g>
      ))}
    </g>
    <path class="meteor" d="M380 70 L470 110" stroke="#efe3c6" stroke-width="1.6" stroke-linecap="round" />
    <!-- night birds crossing the moon -->
    <g class="birds" fill="none" stroke="#0a1229" stroke-width="1.8" stroke-linecap="round">
      <path d="M1176 120 q 6 -6 12 0 q 6 -6 12 0" />
      <path d="M1212 98 q 4 -4 8 0 q 4 -4 8 0" />
      <path d="M1150 150 q 5 -5 10 0 q 5 -5 10 0" />
    </g>
  </g>

  <!-- the foothills, with oaks -->
  <g data-layer="0.14">
    <path d="M0 610 C 160 560, 300 575, 430 590 S 700 540, 860 566 S 1150 548, 1300 572 S 1420 586, 1440 590 L1440 700 L0 700 Z" fill="#13214a" />
    <path d="M0 610 C 160 560, 300 575, 430 590 S 700 540, 860 566 S 1150 548, 1300 572 S 1420 586, 1440 590" fill="none" stroke="#24376b" stroke-width="1.6" />
    <path d="M0 626 C 180 600, 330 612, 470 618 S 760 586, 900 600 S 1170 588, 1320 604" fill="none" stroke="#1a2a55" stroke-width="1" stroke-dasharray="3 5" />
    {
      oaks.map(([x, y, r]) => (
        <g>
          <g fill="#0f1b3d">
            <circle cx={x} cy={y} r={r} />
            <circle cx={x + r * 0.7} cy={y + 4} r={r * 0.7} />
            <circle cx={x - r * 0.7} cy={y + 6} r={r * 0.6} />
          </g>
          <g fill="url(#dotsFine)" opacity="0.14">
            <circle cx={x} cy={y} r={r} />
            <circle cx={x + r * 0.7} cy={y + 4} r={r * 0.7} />
          </g>
          <path d={`M${x - r * 0.2} ${y - r * 0.98} A ${r} ${r} 0 0 1 ${x + r * 0.9} ${y - r * 0.35}`} fill="none" stroke="#efe3c6" stroke-opacity="0.22" stroke-width="1.4" />
          <path d={`M${x + r * 0.2} ${y - r * 0.4} q 6 -6 12 0 M${x - r * 0.5} ${y - r * 0.2} q 5 -5 10 0`} fill="none" stroke="#17275a" stroke-width="1.2" />
        </g>
      ))
    }
    <g class="town" fill="#f0b860">
      {townLights.map((l, i) => <circle cx={l.x} cy={l.y} r={l.r} opacity={i % 3 ? 0.55 : 0.9} style={`--d:${(i % 7) * 0.8}s;--o:${i % 3 ? 0.55 : 0.9}`} class="star" />)}
    </g>
    <path d="M0 640 C 220 610, 420 628, 600 620 S 980 600, 1180 618 S 1380 630, 1440 626 L1440 700 L0 700 Z" fill="#101c3f" />
    <rect x="0" y="560" width="1440" height="90" fill="url(#dotsFine)" mask="url(#mHaze)" opacity="0.18" />
  </g>

  <!-- Palm Drive's palms, far ones small -->
  <g data-layer="0.22" class="palms">
    {
      palms.map(([x, base, top, k]) => (
        <g>
          <path d={`M${x} ${base} C ${x - 6 * k} ${(base + top) / 2}, ${x + 8 * k} ${top + 40 * k}, ${x + 2} ${top}`} stroke="#070f27" stroke-width={7 * k} fill="none" stroke-linecap="round" />
          <path d={`M${x} ${base} C ${x - 6 * k} ${(base + top) / 2}, ${x + 8 * k} ${top + 40 * k}, ${x + 2} ${top}`} stroke="#16244a" stroke-width={7 * k + 1} fill="none" stroke-dasharray={`1.4 ${6 * k + 2}`} />
          <g fill="#070f27" transform={`translate(${x + 2} ${top}) scale(${k})`}>
            <path d="M-4 6 C -10 22, -14 34, -20 46 C -12 36, -6 24, 2 8 Z" fill="#0b1636" />
            <path d="M4 6 C 10 22, 12 34, 18 48 C 10 36, 6 24, -2 8 Z" fill="#0b1636" />
            <path d="M0 0 C -30 -12, -58 -4, -74 18 C -50 4, -26 4, 0 6 Z" />
            <path d="M0 0 C 30 -14, 60 -6, 76 16 C 52 2, 28 2, 0 6 Z" />
            <path d="M0 0 C -14 -30, -42 -42, -66 -36 C -40 -26, -20 -14, 0 4 Z" />
            <path d="M0 0 C 16 -30, 44 -40, 68 -32 C 42 -24, 22 -12, 0 4 Z" />
            <path d="M0 0 C -4 -30, 6 -52, 22 -62 C 12 -44, 6 -24, 2 2 Z" />
            <path d="M0 2 C -28 4, -48 22, -54 46 C -36 26, -18 14, 0 8 Z" />
            <path d="M0 2 C 28 4, 50 22, 56 46 C 38 26, 20 14, 0 8 Z" />
            {fronds.map(([fx, fy]) => (
              <path d={`M0 3 Q ${fx * 0.5} ${fy * 0.5 - 10} ${fx} ${fy}`} fill="none" stroke="#050b1e" stroke-width="7" stroke-dasharray="1.1 2.6" />
            ))}
            {fronds.map(([fx, fy]) => (
              <path d={`M0 3 Q ${fx * 0.5} ${fy * 0.5 - 10} ${fx} ${fy}`} fill="none" stroke="#1d2e5a" stroke-width="1.1" />
            ))}
          </g>
        </g>
      ))
    }
  </g>

  <!-- Hoover Tower, with an offset ink shadow like a misregistered print -->
  <g data-layer="0.26" class="tower"><g class="tower-pos" transform="translate(-112 0)">
    <path d="M204 702 L212 332 L282 332 L290 702 Z" fill="#081029" />
    <path d="M207 700 L215 330 L285 330 L293 700 Z" fill="#1c2c58" />
    <path d="M250 700 L250 330 L285 330 L293 700 Z" fill="#26386a" />
    <path d="M207 700 L215 330 L232 330 L228 700 Z" fill="url(#hatch)" opacity="0.7" />
    <g clip-path="url(#cTower)"><rect x="200" y="190" width="100" height="520" fill="url(#dots)" mask="url(#mTower)" opacity="0.55" /></g>
    <g clip-path="url(#cTower)"><rect x="200" y="330" width="100" height="372" fill="url(#courses)" opacity="0.55" /></g>
    <g fill="#0f1a39">
      <rect x="228" y="360" width="6" height="300" />
      <rect x="266" y="360" width="6" height="300" />
    </g>
    <g stroke="#efe3c6" stroke-opacity="0.28" stroke-width="1">
      <path d="M234.5 360 L234.5 660" />
      <path d="M272.5 360 L272.5 660" />
    </g>
    <g stroke="#0b1430" stroke-width="2.2">
      <path d="M211 436 L289 436" />
      <path d="M210 512 L290 512" />
      <path d="M209 588 L291 588" />
    </g>
    <g stroke="#efe3c6" stroke-opacity="0.22" stroke-width="1">
      <path d="M211 438.5 L289 438.5" />
      <path d="M210 514.5 L290 514.5" />
      <path d="M209 590.5 L291 590.5" />
    </g>
    <!-- base: a broad plinth with steps -->
    <path d="M196 700 L198 668 L302 668 L304 700 Z" fill="#203264" />
    <path d="M250 668 L302 668 L304 700 L250 700 Z" fill="#2a3d72" />
    <g stroke="#0b1430" stroke-width="1.6"><path d="M197 678 L303 678" /><path d="M196 689 L304 689" /></g>
    <g class="win" fill="#f0b860">
      <rect x="244" y="380" width="12" height="18" rx="1" />
      <rect x="244" y="452" width="12" height="18" rx="1" />
      <rect x="244" y="524" width="12" height="18" rx="1" />
      <rect x="244" y="596" width="12" height="18" rx="1" />
    </g>
    <path d="M209 330 L291 330 L291 290 L209 290 Z" fill="#203264" />
    <path d="M250 330 L291 330 L291 290 L250 290 Z" fill="#283c72" />
    <g class="win" fill="#f0b860" fill-opacity="0.9">
      <path d="M220 326 L220 306 A6 6 0 0 1 232 306 L232 326 Z" />
