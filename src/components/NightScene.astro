<style>
  .scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .scene :global([data-layer]) {
    will-change: transform;
  }

  /* Lit by script, one window after another; lit from the start without it. */
  :global(html.js) .scene .win {
    opacity: 0;
    transition: opacity 600ms var(--ease) calc(var(--w, 0) * 70ms);
  }

  :global(html.js) .scene.is-lit .win {
    opacity: 1;
  }

  /* The planner's sampled paths show only while the robot is walking. */
  .scene .fan {
    opacity: 0;
    transition: opacity 400ms var(--ease);
  }

  .scene.is-walking .fan {
    opacity: 1;
  }

  .legs .leg {
    transform-box: fill-box;
    transform-origin: 50% 0%;
  }

  .scene.is-walking .leg.l {
    animation: stride 520ms ease-in-out infinite alternate;
