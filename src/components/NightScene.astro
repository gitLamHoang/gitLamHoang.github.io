---
// Stanford at night, screen-printed: Hoover Tower, the Main Quad arcade and Memorial Church, Palm
// Drive's palms, oaks on the hills, a full moon, and the plaza where a small G1 walks its waypoints
// between people. Flat ink layers with halftone where light falls, slightly misregistered, so it
// reads as a print. Each layer can move on its own: the windows light, the plan draws, the robot
// walks it, the stars and lamps keep breathing, and the layers drift apart as the page scrolls.

// Deterministic stars, so every build draws the same sky.
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const stars = Array.from({ length: 90 }, () => ({
  x: Math.round(rand() * 1440),
  y: Math.round(rand() * 480),
  r: +(0.6 + rand() * 1.4).toFixed(2),
  o: +(0.3 + rand() * 0.6).toFixed(2),
  d: +(rand() * 6).toFixed(2),
}));

// Arcade openings along the Main Quad, leaving room for the church.
const arches = Array.from({ length: 15 }, (_, i) => 540 + i * 62).filter((x) => x < 860 || x > 1130);

// Oaks on the foothills: x, y, radius.
const oaks = [
  [380, 620, 26], [430, 612, 34], [720, 598, 30], [770, 604, 24], [1180, 596, 32], [1235, 606, 26], [1300, 600, 30], [1390, 610, 34],
];

// Palm Drive: x, base, top, scale (near palms large, far ones small).
const palms = [
  [470, 690, 400, 1], [604, 640, 430, 0.9], [1216, 640, 386, 1], [1378, 650, 418, 0.95],
  [1290, 600, 470, 0.55], [1335, 600, 482, 0.5], [1160, 598, 488, 0.45], [680, 600, 476, 0.5],
];

// People crossing the plaza: x, y (feet), height, drift distance.
const walkers = [
  { x: 430, y: 796, h: 44, d: 70 },
  { x: 575, y: 752, h: 34, d: -50 },
  { x: 640, y: 808, h: 46, d: 60 },
  { x: 770, y: 770, h: 38, d: -60 },
  { x: 845, y: 804, h: 44, d: 50 },
  { x: 945, y: 744, h: 30, d: 40 },
  { x: 1125, y: 784, h: 40, d: -70 },
  { x: 1230, y: 806, h: 46, d: 50 },
  { x: 1330, y: 758, h: 34, d: -40 },
];

// The robot's planned route: start, three waypoints, the church steps.
const route = 'M 214 812 C 320 806, 400 782, 500 788 S 616 808, 700 786 S 806 744, 892 752 S 984 734, 1010 714';
const waypoints = [
  [500, 788],
  [700, 786],
  [892, 752],
  [1010, 714],
];
const lamps = [
  [400, 744],
  [880, 728],
  [1186, 748],
];
---

<svg
  class="scene"
  viewBox="0 0 1440 900"
  preserveAspectRatio="xMidYMax slice"
  role="img"
  aria-label="Illustration: Stanford at night. Hoover Tower and the Main Quad with Memorial Church stand under a full moon; on the plaza a small humanoid robot walks a dotted route between people."
  data-scene
>
  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#091127" />
      <stop offset="0.72" stop-color="#121f45" />
      <stop offset="1" stop-color="#1a2b55" />
    </linearGradient>
    <linearGradient id="plaza" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#16244a" />
      <stop offset="1" stop-color="#0a1229" />
    </linearGradient>

    <!-- Halftone screens: cream for moonlight, gold for lamplight. -->
    <pattern id="dots" width="5" height="5" patternUnits="userSpaceOnUse">
      <circle cx="2.5" cy="2.5" r="1.15" fill="#efe3c6" />
    </pattern>
    <pattern id="dotsFine" width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(30)">
      <circle cx="2" cy="2" r="0.9" fill="#efe3c6" />
    </pattern>
    <pattern id="dotsGold" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(15)">
      <circle cx="2.5" cy="2.5" r="1.3" fill="#f0b860" />
    </pattern>

    <!-- Masks that fade a screen out from its light source. -->
    <radialGradient id="fadeRound">
      <stop offset="0" stop-color="#fff" stop-opacity="1" />
      <stop offset="0.55" stop-color="#fff" stop-opacity="0.35" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="litRight" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0.35" stop-color="#fff" stop-opacity="0" />
      <stop offset="1" stop-color="#fff" stop-opacity="0.9" />
    </linearGradient>
    <linearGradient id="litTop" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity="0.85" />
      <stop offset="0.7" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
    <radialGradient id="litMoon" cx="0.68" cy="0.32" r="0.75">
      <stop offset="0" stop-color="#fff" stop-opacity="0.85" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </radialGradient>
    <mask id="mGlow" maskUnits="userSpaceOnUse" x="900" y="0" width="540" height="480">
      <circle cx="1238" cy="158" r="250" fill="url(#fadeRound)" />
      <circle cx="1238" cy="158" r="60" fill="#000" />
    </mask>
    <mask id="mTower"><rect x="200" y="190" width="100" height="520" fill="url(#litRight)" /></mask>
    <mask id="mQuad"><rect x="520" y="470" width="920" height="240" fill="url(#litTop)" /></mask>
    <mask id="mMoon"><circle cx="1238" cy="158" r="56" fill="url(#litMoon)" /></mask>
    <mask id="mLamp" maskUnits="userSpaceOnUse" x="0" y="640" width="1440" height="220">
      {lamps.map(([x, y]) => <ellipse cx={x} cy={y + 46} rx="110" ry="30" fill="url(#fadeRound)" />)}
    </mask>
    <mask id="mHalo" maskUnits="userSpaceOnUse" x="0" y="640" width="1440" height="220">
      {lamps.map(([x, y]) => <circle cx={x} cy={y - 8} r="28" fill="url(#fadeRound)" />)}
    </mask>
    <clipPath id="cTower">
      <path d="M207 700 L215 330 L285 330 L293 700 Z" />
      <rect x="209" y="290" width="82" height="40" />
      <path d="M214 282 C 214 246, 236 230, 250 230 C 264 230, 286 246, 286 282 Z" />
    </clipPath>
    <clipPath id="cQuad">
      <rect x="520" y="596" width="920" height="108" />
      <path d="M884 704 L884 560 L1010 470 L1136 560 L1136 704 Z" />
    </clipPath>
    <!-- The plan draws itself ahead of the robot: a solid copy of the route reveals the dotted one. -->
    <mask id="mRoute" maskUnits="userSpaceOnUse" x="0" y="600" width="1440" height="300">
      <path d={route} fill="none" stroke="#fff" stroke-width="34" stroke-linecap="round" data-route-reveal />
    </mask>
  </defs>

  <!-- sky, stars, the moon and its halftone glow -->
  <g data-layer="0.08">
    <rect width="1440" height="900" fill="url(#sky)" />
    <rect x="900" y="0" width="540" height="480" fill="url(#dotsFine)" mask="url(#mGlow)" opacity="0.55" class="glow" />
    {stars.map((s) => <circle class="star" cx={s.x} cy={s.y} r={s.r} fill="#efe3c6" opacity={s.o} style={`--d:${s.d}s;--o:${s.o}`} />)}
    <g class="moon">
      <circle cx="1241" cy="161" r="56" fill="#b9a983" opacity="0.5" />
      <circle cx="1238" cy="158" r="56" fill="#e9dcbc" />
      <circle cx="1238" cy="158" r="56" fill="url(#dots)" mask="url(#mMoon)" opacity="0.6" />
      <g fill="#cdbd98" opacity="0.75">
        <circle cx="1222" cy="140" r="11" />
        <circle cx="1255" cy="172" r="8" />
        <circle cx="1230" cy="182" r="5" />
        <circle cx="1260" cy="135" r="4" />
        <circle cx="1210" cy="166" r="3.5" />
      </g>
    </g>
  </g>

  <!-- the foothills, with oaks -->
  <g data-layer="0.14">
    <path d="M0 610 C 160 560, 300 575, 430 590 S 700 540, 860 566 S 1150 548, 1300 572 S 1420 586, 1440 590 L1440 700 L0 700 Z" fill="#13214a" />
    <g fill="#0f1b3d">
      {oaks.map(([x, y, r]) => <g><circle cx={x} cy={y} r={r} /><circle cx={x + r * 0.7} cy={y + 4} r={r * 0.7} /><circle cx={x - r * 0.7} cy={y + 6} r={r * 0.6} /></g>)}
    </g>
    <path d="M0 640 C 220 610, 420 628, 600 620 S 980 600, 1180 618 S 1380 630, 1440 626 L1440 700 L0 700 Z" fill="#101c3f" />
  </g>

  <!-- Palm Drive's palms, far ones small -->
  <g data-layer="0.22" class="palms">
    {
      palms.map(([x, base, top, k]) => (
        <g>
          <path d={`M${x} ${base} C ${x - 6 * k} ${(base + top) / 2}, ${x + 8 * k} ${top + 40 * k}, ${x + 2} ${top}`} stroke="#070f27" stroke-width={7 * k} fill="none" stroke-linecap="round" />
          <g fill="#070f27" transform={`translate(${x + 2} ${top}) scale(${k})`}>
            <path d="M0 0 C -30 -12, -58 -4, -74 18 C -50 4, -26 4, 0 6 Z" />
            <path d="M0 0 C 30 -14, 60 -6, 76 16 C 52 2, 28 2, 0 6 Z" />
            <path d="M0 0 C -14 -30, -42 -42, -66 -36 C -40 -26, -20 -14, 0 4 Z" />
            <path d="M0 0 C 16 -30, 44 -40, 68 -32 C 42 -24, 22 -12, 0 4 Z" />
            <path d="M0 0 C -4 -30, 6 -52, 22 -62 C 12 -44, 6 -24, 2 2 Z" />
            <path d="M0 2 C -28 4, -48 22, -54 46 C -36 26, -18 14, 0 8 Z" />
            <path d="M0 2 C 28 4, 50 22, 56 46 C 38 26, 20 14, 0 8 Z" />
          </g>
        </g>
      ))
    }
  </g>

  <!-- Hoover Tower, with an offset ink shadow like a misregistered print -->
  <g data-layer="0.26" class="tower"><g class="tower-pos" transform="translate(-112 0)">
    <path d="M204 702 L212 332 L282 332 L290 702 Z" fill="#081029" />
    <path d="M207 700 L215 330 L285 330 L293 700 Z" fill="#1c2c58" />
    <path d="M250 700 L250 330 L285 330 L293 700 Z" fill="#26386a" />
    <g clip-path="url(#cTower)"><rect x="200" y="190" width="100" height="520" fill="url(#dots)" mask="url(#mTower)" opacity="0.55" /></g>
    <g fill="#0f1a39">
      <rect x="228" y="360" width="6" height="300" />
      <rect x="266" y="360" width="6" height="300" />
    </g>
    <g class="win" fill="#f0b860">
      <rect x="244" y="380" width="12" height="18" rx="1" />
      <rect x="244" y="452" width="12" height="18" rx="1" />
      <rect x="244" y="524" width="12" height="18" rx="1" />
      <rect x="244" y="596" width="12" height="18" rx="1" />
    </g>
    <path d="M209 330 L291 330 L291 290 L209 290 Z" fill="#203264" />
    <g class="win" fill="#f0b860" fill-opacity="0.9">
      <path d="M220 326 L220 306 A6 6 0 0 1 232 306 L232 326 Z" />
      <path d="M244 326 L244 306 A6 6 0 0 1 256 306 L256 326 Z" />
      <path d="M268 326 L268 306 A6 6 0 0 1 280 306 L280 326 Z" />
    </g>
    <rect x="204" y="282" width="92" height="9" fill="#2c4078" />
    <path d="M211 284 C 211 248, 233 232, 247 232 C 261 232, 283 248, 283 284 Z" fill="#4a2230" />
    <path d="M214 282 C 214 246, 236 230, 250 230 C 264 230, 286 246, 286 282 Z" fill="#7a3b34" />
    <path d="M250 230 C 264 230, 286 246, 286 282 L 262 282 C 262 252, 256 236, 250 230 Z" fill="#a4553f" />
    <rect x="241" y="212" width="18" height="20" fill="#26386a" />
    <path d="M239 213 C 239 203, 261 203, 261 213 Z" fill="#a4553f" />
    <path d="M250 203 L250 186" stroke="#efe3c6" stroke-width="2" stroke-linecap="round" />
  </g></g>

  <!-- the Main Quad arcade and Memorial Church's front: a gold mosaic over three portals -->
  <g data-layer="0.34" class="quad">
    <rect x="517" y="599" width="920" height="108" fill="#081029" />
    <rect x="520" y="612" width="920" height="92" fill="#1e2f5c" />
    <rect x="520" y="596" width="920" height="18" fill="#6e3430" />
    <rect x="520" y="599" width="920" height="3" fill="#a4553f" opacity="0.7" />
    {
      arches.map((x) => (
        <g>
          <path d={`M${x} 700 L${x} 652 A22 22 0 0 1 ${x + 44} 652 L${x + 44} 700 Z`} fill="#0c1530" />
          <path class="win" d={`M${x + 6} 700 L${x + 6} 656 A16 16 0 0 1 ${x + 38} 656 L${x + 38} 700 Z`} fill="#f0b860" fill-opacity="0.5" />
          <path class="win" d={`M${x + 6} 700 L${x + 6} 656 A16 16 0 0 1 ${x + 38} 656 L${x + 38} 700 Z`} fill="url(#dotsGold)" />
        </g>
      ))
    }
    <!-- church facade -->
    <path d="M881 706 L881 562 L1007 472 L1133 562 L1133 706 Z" fill="#081029" />
    <path d="M884 704 L884 560 L1010 470 L1136 560 L1136 704 Z" fill="#26386a" />
    <path d="M1010 470 L1136 560 L1136 704 L1010 704 Z" fill="#2d4277" />
    <path d="M872 564 L1010 464 L1148 564" fill="none" stroke="#7a3b34" stroke-width="11" stroke-linejoin="round" />
    <path d="M914 560 L1010 492 L1106 560 L1106 620 L914 620 Z" fill="#c99a45" />
    <g fill="#8c6a2d">
      <path d="M1010 500 L1040 522 L980 522 Z" />
      <rect x="930" y="566" width="18" height="48" />
      <rect x="958" y="560" width="18" height="54" />
      <rect x="1000" y="540" width="20" height="74" />
      <rect x="1044" y="560" width="18" height="54" />
      <rect x="1072" y="566" width="18" height="48" />
    </g>
    <g fill="#e8c77a" opacity="0.8">
      <circle cx="1010" cy="533" r="5" />
      <circle cx="939" cy="561" r="3" />
      <circle cx="967" cy="555" r="3" />
      <circle cx="1053" cy="555" r="3" />
      <circle cx="1081" cy="561" r="3" />
    </g>
    <rect x="884" y="620" width="252" height="6" fill="#203264" />
    <g fill="#0c1530">
      <path d="M906 704 L906 664 A22 22 0 0 1 950 664 L950 704 Z" />
      <path d="M978 704 L978 656 A32 32 0 0 1 1042 656 L1042 704 Z" />
      <path d="M1070 704 L1070 664 A22 22 0 0 1 1114 664 L1114 704 Z" />
    </g>
    <g class="win" fill="#f0b860" fill-opacity="0.6">
      <path d="M912 704 L912 666 A16 16 0 0 1 944 666 L944 704 Z" />
      <path d="M985 704 L985 658 A25 25 0 0 1 1035 658 L1035 704 Z" />
      <path d="M1076 704 L1076 666 A16 16 0 0 1 1108 666 L1108 704 Z" />
    </g>
    <g clip-path="url(#cQuad)"><rect x="520" y="470" width="920" height="240" fill="url(#dots)" mask="url(#mQuad)" opacity="0.3" /></g>
  </g>

  <!-- the plaza: paths, lamps with halftone light, people, the robot and its route -->
  <g data-layer="0.5" class="plaza">
    <rect x="0" y="700" width="1440" height="200" fill="url(#plaza)" />
    <path d="M0 724 C 400 712, 1000 712, 1440 724" stroke="#22356a" stroke-width="2" fill="none" opacity="0.7" />
    <path d="M520 830 L860 704 L1160 704 L1440 812 L1440 830 Z" fill="#14224a" opacity="0.8" />
    <rect x="0" y="640" width="1440" height="220" fill="url(#dotsGold)" mask="url(#mLamp)" opacity="0.7" class="pools" />
    <rect x="0" y="640" width="1440" height="220" fill="url(#dotsGold)" mask="url(#mHalo)" opacity="0.9" class="halos" />
    {
      lamps.map(([x, y]) => (
        <g>
          <rect x={x - 1.5} y={y - 6} width="3" height="52" fill="#0b132b" />
          <circle class="win lamp" cx={x} cy={y - 8} r="5" fill="#f6cf86" />
        </g>
      ))
    }
    <rect x="0" y="826" width="1440" height="74" fill="#08112b" />
    <rect x="0" y="822" width="1440" height="4" fill="#0d1838" />

    <g mask="url(#mRoute)">
      <path class="route" d={route} fill="none" stroke="#ec5a36" stroke-width="3.5" stroke-linecap="round" stroke-dasharray="2 12" data-route />
      {waypoints.map(([x, y]) => <circle class="wp" cx={x} cy={y} r="9" fill="none" stroke="#ec5a36" stroke-width="2.5" />)}
    </g>

    {
      walkers.map((w) => (
        <g class="walker" data-drift={w.d} transform={`translate(${w.x} ${w.y})`}>
          <ellipse cx="0" cy="1" rx={w.h * 0.32} ry="3" fill="#050a1a" opacity="0.6" />
          <path d={`M${-w.h * 0.1} 0 L${-w.h * 0.06} ${-w.h * 0.42} M${w.h * 0.1} 0 L${w.h * 0.06} ${-w.h * 0.42}`} stroke="#070d22" stroke-width={w.h * 0.1} stroke-linecap="round" />
          <path d={`M${-w.h * 0.16} ${-w.h * 0.4} C ${-w.h * 0.2} ${-w.h * 0.62}, ${-w.h * 0.14} ${-w.h * 0.76}, 0 ${-w.h * 0.76} C ${w.h * 0.14} ${-w.h * 0.76}, ${w.h * 0.2} ${-w.h * 0.62}, ${w.h * 0.16} ${-w.h * 0.4} Z`} fill="#0a1229" />
          <circle cx="0" cy={-w.h * 0.88} r={w.h * 0.11} fill="#0a1229" />
          <path d={`M${w.h * 0.06} ${-w.h * 0.74} C ${w.h * 0.16} ${-w.h * 0.72}, ${w.h * 0.19} ${-w.h * 0.6}, ${w.h * 0.16} ${-w.h * 0.42}`} stroke="#efe3c6" stroke-opacity="0.45" stroke-width="1.6" fill="none" />
          <path d={`M${w.h * 0.04} ${-w.h * 0.98} A ${w.h * 0.11} ${w.h * 0.11} 0 0 1 ${w.h * 0.11} ${-w.h * 0.86}`} stroke="#efe3c6" stroke-opacity="0.5" stroke-width="1.4" fill="none" />
        </g>
      ))
    }

    <!-- the G1: cream body, vermilion visor -->
    <g class="robot" data-robot transform="translate(214 812)">
      <ellipse cx="0" cy="1" rx="12" ry="3" fill="#050a1a" opacity="0.6" />
      <g class="legs">
        <rect class="leg l" x="-6" y="-17" width="4.5" height="17" rx="2" fill="#d9cba8" />
        <rect class="leg r" x="1.5" y="-17" width="4.5" height="17" rx="2" fill="#efe3c6" />
      </g>
      <rect x="-8" y="-34" width="16" height="18" rx="4" fill="#efe3c6" />
      <rect x="-11" y="-32" width="3.5" height="14" rx="1.75" fill="#d9cba8" />
      <rect x="7.5" y="-32" width="3.5" height="14" rx="1.75" fill="#efe3c6" />
      <rect x="-5.5" y="-44" width="11" height="10" rx="4" fill="#efe3c6" />
      <rect x="-4" y="-41" width="8" height="3.5" rx="1.5" fill="#ec5a36" />
    </g>
  </g>
</svg>

<style>
  .scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .scene :global([data-layer]) {
    will-change: transform;
  }

  /* Lit by script, one window after another; lit from the start without it. */
  :global(html.js) .scene .win {
    opacity: 0;
    transition: opacity 600ms var(--ease) calc(var(--w, 0) * 70ms);
  }

  :global(html.js) .scene.is-lit .win {
    opacity: 1;
  }

  .legs .leg {
    transform-box: fill-box;
    transform-origin: 50% 0%;
  }

  .scene.is-walking .leg.l {
    animation: stride 520ms ease-in-out infinite alternate;
  }

  .scene.is-walking .leg.r {
    animation: stride 520ms ease-in-out infinite alternate-reverse;
  }

  @keyframes stride {
    from {
      transform: rotate(-16deg);
    }
    to {
      transform: rotate(16deg);
    }
  }

  /* Ambient life while the poster is on screen: stars blink, the lamps' halftone breathes. */
  @media (prefers-reduced-motion: no-preference) {
    .scene.is-live .star {
      animation: blink 5.5s ease-in-out infinite;
      animation-delay: var(--d);
    }

    .scene.is-live .halos,
    .scene.is-live .pools {
      animation: breathe 4.8s ease-in-out infinite;
    }

    .scene.is-live .glow {
      animation: breathe 9s ease-in-out infinite;
    }
  }

  @keyframes blink {
    0%,
    100% {
      opacity: var(--o, 0.6);
    }
    50% {
      opacity: 0.12;
    }
  }

  @keyframes breathe {
    0%,
    100% {
      opacity: 0.85;
    }
    50% {
      opacity: 0.5;
    }
  }

  /* Phones see a narrow slice of the middle: bring the tower and the moon into it. */
  @media (max-width: 760px) {
    .scene :global(.tower-pos) {
      transform: translate(330px, 0);
    }

    .scene :global(.moon),
    .scene :global(.glow) {
      transform-box: fill-box;
      transform-origin: center;
    }

    .scene :global(.moon) {
      transform: translate(-370px, 330px) scale(0.55);
    }

    .scene :global(.glow) {
      transform: translate(-370px, 330px) scale(0.6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .scene .win {
      transition: none;
    }
  }
</style>
