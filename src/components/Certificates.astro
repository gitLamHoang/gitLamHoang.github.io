---
import { Image } from 'astro:assets';
import { immc } from '../data/profile';
import cert2025 from '../assets/immc/immc-2025-honorable-mention.png';
import cert2024 from '../assets/immc/immc-2024-honorable-mention.png';

const images: Record<string, ImageMetadata> = { '2025': cert2025, '2024': cert2024 };
---

<ul class="certs">
  {
    immc.certificates.map((c) => (
      <li>
        <a href={c.pdf} class="shot">
          <Image
            src={images[c.year]}
            alt={`IM²C ${c.year} Certificate of Achievement, Honorable Mention, Hanoi-Amsterdam High School for the Gifted, representing Vietnam.`}
            widths={[360, 540, 720]}
            sizes="(max-width: 700px) 100vw, 340px"
          />
        </a>
        <p class="label">{c.label}</p>
        <p class="team">{c.team}</p>
        <p class="pdf"><a href={c.pdf}>Certificate (PDF)</a></p>
      </li>
    ))
  }
</ul>

<style>
  .certs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 32px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .shot {
    display: block;
    background: #fff;
  }

  .shot img {
    width: 100%;
    height: auto;
  }

  .label {
    margin-top: 14px;
    font-weight: 500;
  }

  .team {
    margin-top: 4px;
    font-size: var(--step-small);
    color: var(--muted);
  }

  .pdf {
    font-size: var(--step-small);
    font-weight: 500;
  }

  .pdf a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
