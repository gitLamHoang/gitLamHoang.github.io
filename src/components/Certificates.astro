---
import { Image } from 'astro:assets';
import { immc } from '../data/profile';
import cert2025 from '../assets/immc/immc-2025-honorable-mention.png';
import cert2024 from '../assets/immc/immc-2024-honorable-mention.png';

const images: Record<string, ImageMetadata> = { '2025': cert2025, '2024': cert2024 };
---

<ul class="certs">
  {
    immc.certificates.map((c) => (
      <li>
        <a href={c.pdf} class="shot">
          <Image
            src={images[c.year]}
            alt={`IM²C ${c.year} Certificate of Achievement, Honorable Mention, Hanoi-Amsterdam High School for the Gifted, representing Vietnam.`}
            widths={[360, 540, 720]}
            sizes="(max-width: 700px) 100vw, 300px"
          />
        </a>
        <p class="body-5">{c.label}</p>
        <p class="caption-2 text-2">{c.team}</p>
        <p class="pdf"><a class="body-5" href={c.pdf}>Certificate (PDF)</a></p>
      </li>
    ))
  }
</ul>

<style>
  .certs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-200);
    margin: var(--space-75) 0 0;
    padding: 0;
    list-style: none;
  }

  .shot {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: #ffffff;
  }

  .shot img {
    width: 100%;
    height: auto;
  }

  li > p {
    margin-top: var(--space-75);
  }

  .pdf a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  @media (max-width: 480px) {
    .certs {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
