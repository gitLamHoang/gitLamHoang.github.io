---
// The close of every page: the final call to action (the same two actions as the top), the contact
// details, then a short footer with the legal-name and quote credits.
import Epigraph from './Epigraph.astro';
import Icon from './Icon.astro';
import { contact, person } from '../data/profile';

const built = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'America/Los_Angeles' });
const year = new Date().getFullYear();
const source = 'https://github.com/gitLamHoang/gitLamHoang.github.io';
---

<footer class="site-footer wrap" id="contact">
  <section class="panel close-cta" aria-labelledby="contact-title" data-reveal>
    <div class="ask">
      <h2 id="contact-title" class="heading-2">Get in touch</h2>
      <p class="title-2 text-2">Questions about the work, or a role in robotics or AI? Email me.</p>
      <div class="cta">
        <a class="btn btn-primary" href={contact.resume} download="Harvey_Phan_Resume.pdf"><Icon name="download" />Download resume</a>
        <a class="btn" href={`mailto:${contact.email}`}><Icon name="envelope" />Email me</a>
      </div>
      <Epigraph quote="footer" />
    </div>
    <dl class="contact panel-inset">
      <div><dt class="title-4 text-2"><Icon name="envelope" />Email</dt><dd><a class="body-2" href={`mailto:${contact.email}`}>{contact.email}</a></dd></div>
      <div><dt class="title-4 text-2"><Icon name="phone" />Phone</dt><dd><a class="body-2" href={contact.phoneHref}>{contact.phone}</a></dd></div>
      <div><dt class="title-4 text-2"><Icon name="mapPin" />Based in</dt><dd class="body-2">{contact.location}</dd></div>
      <div><dt class="title-4 text-2"><Icon name="linkedin" />LinkedIn</dt><dd><a class="body-2" href={contact.linkedin}>linkedin.com/in/phanhlam</a></dd></div>
      <div><dt class="title-4 text-2"><Icon name="github" />GitHub</dt><dd><a class="body-2" href={contact.github}>github.com/gitLamHoang</a></dd></div>
    </dl>
  </section>

  <div class="base">
    <div class="fine caption-2 text-2">
      <p>Legal name: {person.legalName}. Papers are listed under the published author name.</p>
      <p>Quotes are Harvey Specter's, from <cite>Suits</cite> (USA Network). This site is not affiliated with the show.</p>
      <p>Built with Astro, a MuJoCo replay of a recorded HARP run, and KaTeX. Every number traces to a source. <a href={source}>Source on GitHub</a>. Updated {built}.</p>
    </div>
    <nav class="paths title-4" aria-label="Footer">
      <a href="/#work">Work</a>
      <a href="/#research">Research</a>
      <a href="/lab/">Crowd lab</a>
      <a href={contact.resume} download="Harvey_Phan_Resume.pdf">Resume</a>
    </nav>
    <p class="caption-2 text-3 year">{person.siteTitle}, {year}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: var(--space-900);
    padding-bottom: var(--space-400);
  }

  .close-cta {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-400);
    padding: var(--space-75);
  }

  .ask {
    display: grid;
    align-content: start;
    gap: var(--space-300);
    padding: var(--space-600) var(--space-400);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-100);
  }

  .contact {
    display: grid;
    align-content: center;
    gap: var(--space-75);
    margin: 0;
    padding: var(--space-400) var(--space-300);
  }

  .contact div {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: var(--space-100);
    align-items: center;
    min-height: 44px;
  }

  .contact dt {
    display: inline-flex;
    align-items: center;
    gap: var(--space-75);
  }

  .contact dt :global(.icon) {
    width: 16px;
    height: 16px;
  }

  .contact dd {
    overflow-wrap: anywhere;
  }

  .contact a {
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .contact a:hover {
      text-decoration: underline;
    }
  }

  .base {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-300) var(--space-600);
    margin-top: var(--space-600);
    padding-top: var(--space-300);
  }

  .fine {
    display: grid;
    gap: var(--space-50);
    max-width: 68ch;
  }

  .paths {
    display: flex;
    flex-wrap: wrap;
    align-content: start;
    gap: var(--space-50) var(--space-300);
  }

  .paths a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    color: var(--text-2);
    transition: color var(--dur-fade) var(--ease);
  }

  @media (hover: hover) and (pointer: fine) {
    .paths a:hover {
      color: var(--text);
    }
  }

  .year {
    grid-column: 1 / -1;
  }

  @media (max-width: 900px) {
    .close-cta,
    .base {
      grid-template-columns: minmax(0, 1fr);
    }

    .ask {
      padding: var(--space-400) var(--space-200);
    }

    .contact div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding-block: var(--space-50);
    }
  }
</style>
