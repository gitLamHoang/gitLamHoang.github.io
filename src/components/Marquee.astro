---
// Where Harvey has worked, studied, and competed: one slow line of names on an off-white field,
// cropped by both edges. The list is read once by assistive tech; the moving copy is hidden.
// Paused under reduced motion and while hovered.
import { affiliations } from '../data/profile';

const names = affiliations.map((a) => a.name.replace('International Mathematical Modeling Challenge', 'IM²C'));
---

<section class="orgs" aria-labelledby="orgs-title" data-marquee>
  <h2 id="orgs-title" class="sr-only">Organizations</h2>
  <div class="band">
    <ul class="track" aria-label="Organizations">
      {names.map((n) => <li>{n}</li>)}
    </ul>
    <ul class="track" aria-hidden="true">
      {names.map((n) => <li>{n}</li>)}
    </ul>
  </div>
  <div class="note wrap">
    <p>Where I've worked, studied, and competed, from Stanford and HARP to Hanoi.</p>
    <button type="button" class="btn pause" data-marquee-toggle aria-pressed="false">Pause the names</button>
  </div>
</section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-marquee]')) {
    const btn = root.querySelector<HTMLButtonElement>('[data-marquee-toggle]')!;
    btn.addEventListener('click', () => {
      const paused = root.classList.toggle('is-paused');
      btn.setAttribute('aria-pressed', String(paused));
      btn.textContent = paused ? 'Play the names' : 'Pause the names';
    });
  }
</script>

<style>
  .orgs {
    margin-top: var(--section);
  }

  .band {
    display: flex;
    overflow: hidden;
    background: var(--ink);
    color: var(--bg);
    padding-block: clamp(28px, 5vw, 72px);
  }

  .track {
    display: flex;
    flex: none;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: clamp(2.75rem, 8vw, 7.5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    white-space: nowrap;
  }

  .track li {
    display: flex;
    align-items: center;
  }

  /* A round dot one third of the cap height between names. */
  .track li::after {
    content: '';
    width: 0.2em;
    height: 0.2em;
    margin-inline: 0.45em;
    border-radius: 50%;
    background: currentColor;
  }

  .note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-top: 20px;
    color: var(--muted);
  }

  .pause {
    color: var(--ink);
  }

  .pause[aria-pressed='true'] {
    background: var(--surface-2);
    color: var(--ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .track {
      animation: drift 90s linear infinite;
    }

    .band:hover .track,
    .is-paused .track {
      animation-play-state: paused;
    }
  }

  @keyframes drift {
    to {
      transform: translateX(-100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .band {
      flex-wrap: wrap;
    }

    .track[aria-hidden='true'],
    .pause {
      display: none;
    }

    .track {
      flex-wrap: wrap;
      white-space: normal;
      padding-inline: var(--margin);
      row-gap: 0.15em;
    }
  }
</style>
