---
// The predictive avoidance layer as a signal chain, LiDAR in, velocity request out.
// Facts from the HARP branch lam/predictive-avoidance (context/predictive-avoidance.md, SFM_NMPC_REFERENCE.md).
const stages = [
  { name: 'Perceive', detail: 'Motion-compensated LiDAR, floor and self filtering, voxel clusters', param: 'stamped TF' },
  { name: 'Track', detail: 'Joint Hungarian assignment, merged-return splitting, occlusion memory', param: '2.5 s coasting' },
  { name: 'Forecast', detail: 'Constant-velocity motion with bounded uncertainty; no assumed cooperation', param: '4 s horizon' },
  { name: 'Optimize', detail: 'Three velocity blocks, nonlinear rollout with delay and gains, sampled then SLSQP-refined', param: 'NMPC' },
  { name: 'Certify', detail: 'Swept-disc checks with a braking tail; least-intrusion fallback when nothing is clear', param: 'hard body margin' },
  { name: 'Command', detail: 'First request only, then replan; zero on stale input or a missed deadline', param: '5 Hz, 0.15 s' },
];
---

<figure class="pipeline" aria-labelledby="pipeline-caption">
  <div class="ends">
    <span>LiDAR point cloud in</span>
    <span>Body-frame velocity request out, to the GR00T walker</span>
  </div>
  <ol>
    {
      stages.map((s) => (
        <li>
          <p class="name">{s.name}</p>
          <p class="detail">{s.detail}</p>
          <p class="param tnum">{s.param}</p>
        </li>
      ))
    }
  </ol>
  <figcaption id="pipeline-caption" class="cap">
    The predictive avoidance layer runs between Nav2's route and the walking policy. Each stage hands the next a smaller, more decided
    picture of the hallway.
  </figcaption>
</figure>

<style>
  .pipeline {
    margin: 0;
    padding: clamp(20px, 2.6vw, 36px);
    background: var(--surface);
  }

  .ends {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--muted);
    font-size: var(--step-small);
    font-weight: 500;
  }

  ol {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 28px clamp(16px, 2vw, 32px);
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .name {
    font-size: var(--step-lead);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .detail {
    margin-top: 8px;
    font-size: var(--step-small);
  }

  .param {
    margin-top: 10px;
    color: var(--muted);
    font-size: var(--step-small);
    font-weight: 500;
  }

  .cap {
    margin-top: 24px;
    max-width: 72ch;
    color: var(--muted);
    font-size: var(--step-small);
  }

  @media (max-width: 1100px) {
    ol {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    ol {
      grid-template-columns: minmax(0, 1fr);
    }

    .ends {
      flex-direction: column;
    }
  }
</style>
