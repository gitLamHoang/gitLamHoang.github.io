---
// The predictive avoidance layer as a signal chain, LiDAR in, velocity request out.
// Facts from the HARP branch lam/predictive-avoidance at 3a87d78 (context/predictive-avoidance.md).
const stages = [
  { name: 'Perceive', detail: 'Motion-compensated LiDAR plus the head depth camera, floor and self filtering, clusters', param: 'LiDAR and depth' },
  { name: 'Track', detail: 'Joint Hungarian assignment, occlusion memory; only what actually moved leaves the map', param: 'Multi-object tracking' },
  { name: 'Forecast', detail: 'A cloud of 32 possible paths for each of the 8 nearest people; people react after 0.5 s', param: '8 people within 5 m' },
  { name: 'Plan', detail: 'About 260 robot paths; six rounds of Bayesian best responses settle on a joint plan, after BRNE', param: 'Game-theoretic core' },
  { name: 'Certify', detail: 'Clear of straight-line forecasts for 1.2 s, with a 2.5 s plan B; else the least violation', param: '0.30 m clearance rule' },
  { name: 'Command', detail: 'First request only, then replan; zero on stale input or a missed deadline', param: '5 Hz, 0.15 s' },
];
---

<figure class="pipeline" aria-labelledby="pipeline-caption">
  <div class="ends">
    <span>LiDAR point cloud in</span>
    <span>Body-frame velocity request out, to the GR00T walker</span>
  </div>
  <ol>
    {
      stages.map((s) => (
        <li>
          <p class="name">{s.name}</p>
          <p class="detail">{s.detail}</p>
          <p class="param tnum">{s.param}</p>
        </li>
      ))
    }
  </ol>
  <figcaption id="pipeline-caption" class="cap">
    The predictive avoidance layer runs between Nav2's route and the walking policy. Each stage hands the next a smaller, more decided
    picture of the hallway.
  </figcaption>
</figure>

<style>
  .pipeline {
    margin: 0;
    padding: clamp(20px, 2.6vw, 36px);
    background: var(--surface);
  }

  .ends {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--muted);
    font-size: var(--step-small);
    font-weight: 500;
  }

  ol {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 28px clamp(16px, 2vw, 32px);
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .name {
    font-size: var(--step-lead);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .detail {
    margin-top: 8px;
    font-size: var(--step-small);
  }

  .param {
    margin-top: 10px;
    color: var(--muted);
    font-size: var(--step-small);
    font-weight: 500;
  }

  .cap {
    margin-top: 24px;
    max-width: 72ch;
    color: var(--muted);
    font-size: var(--step-small);
  }

  @media (max-width: 1100px) {
    ol {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    ol {
      grid-template-columns: minmax(0, 1fr);
    }

    .ends {
      flex-direction: column;
    }
  }
</style>
