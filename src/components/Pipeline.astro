---
// The predictive avoidance layer as a signal chain, LiDAR in, velocity request out.
// Facts from the HARP branch lam/predictive-avoidance (context/predictive-avoidance.md, SFM_NMPC_REFERENCE.md).
const stages = [
  { name: 'Perceive', detail: 'Motion-compensated LiDAR, floor and self filtering, voxel clusters', param: 'stamped TF' },
  { name: 'Track', detail: 'Joint Hungarian assignment, merged-return splitting, occlusion memory', param: '2.5 s coasting' },
  { name: 'Forecast', detail: 'Constant-velocity motion with bounded uncertainty; no assumed cooperation', param: '4 s horizon' },
  { name: 'Optimize', detail: 'Three velocity blocks, nonlinear rollout with delay and gains, sampled then SLSQP-refined', param: 'NMPC' },
  { name: 'Certify', detail: 'Swept-disc checks with a braking tail; least-intrusion fallback when nothing is clear', param: 'hard body margin' },
  { name: 'Command', detail: 'First request only, then replan; zero on stale input or a missed deadline', param: '5 Hz, 0.15 s' },
];
---

<figure class="pipeline" aria-labelledby="pipeline-caption">
  <div class="ends ui">
    <span>LiDAR point cloud in</span>
    <span>Body-frame velocity request out, to the GR00T walker</span>
  </div>
  <ol>
    {
      stages.map((s) => (
        <li>
          <p class="name">{s.name}</p>
          <p class="detail">{s.detail}</p>
          <p class="param mono">{s.param}</p>
        </li>
      ))
    }
  </ol>
  <figcaption id="pipeline-caption" class="cap">
    The predictive avoidance layer runs between Nav2's route and the walking policy. Each stage hands the next a smaller, more decided
    picture of the hallway.
  </figcaption>
</figure>

<style>
  .pipeline {
    margin: 0;
  }

  .ends {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--graphite);
  }

  ol {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: stage;
    border: 1.5px solid var(--ink);
    border-radius: var(--radius);
    background: var(--paper-raised);
  }

  li {
    position: relative;
    padding: 16px 16px 18px;
    counter-increment: stage;
  }

  li + li {
    border-left: 1px solid var(--grid);
  }

  /* arrowhead on each boundary */
  li + li::before {
    content: '';
    position: absolute;
    top: 22px;
    left: -6px;
    width: 10px;
    height: 10px;
    border-top: 1.5px solid var(--ink);
    border-right: 1.5px solid var(--ink);
    background: var(--paper-raised);
    transform: rotate(45deg);
  }

  .name {
    font-family: var(--font-ui);
    font-size: 1.1875rem;
    font-weight: 600;
  }

  .name::before {
    content: counter(stage) ' ';
    color: var(--pen);
    font-variant-numeric: lining-nums;
  }

  .detail {
    margin-top: 6px;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .param {
    display: inline-block;
    margin-top: 10px;
    padding: 2px 8px;
    border-radius: 3px;
    background: var(--hl-mark);
    font-size: 0.875rem;
  }

  .cap {
    margin-top: 10px;
    font-size: 0.9375rem;
    color: var(--graphite);
  }

  @media (max-width: 1100px) {
    ol {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    li:nth-child(4) {
      border-left: 0;
    }

    li:nth-child(4)::before {
      display: none;
    }

    li:nth-child(n + 4) {
      border-top: 1px solid var(--grid);
    }
  }

  @media (max-width: 640px) {
    .ends {
      flex-direction: column;
    }

    ol {
      grid-template-columns: minmax(0, 1fr);
    }

    li + li {
      border-left: 0;
      border-top: 1px solid var(--grid);
    }

    li + li::before {
      top: -6px;
      left: 22px;
      transform: rotate(135deg);
    }

    li:nth-child(4)::before {
      display: block;
    }
  }
</style>
