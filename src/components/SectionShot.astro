<script>
  // Each shot's layers slide at their own speed while it crosses the screen; a shot only lives
  // (stars blink, traffic runs, bells swing) while it is on screen.
  const shots = [...document.querySelectorAll<HTMLElement>('[data-shot]')].map((el) => ({
    el,
    layers: [...el.querySelectorAll<SVGGElement>('[data-depth]')].map((g) => ({ g, k: Number(g.dataset.depth) })),
    live: false,
  }));
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let queued = false;
  const place = () => {
    queued = false;
    for (const s of shots) {
      if (!s.live) continue;
      const r = s.el.getBoundingClientRect();
      const p = (r.top + r.height / 2 - innerHeight / 2) / innerHeight;
      for (const l of s.layers) l.g.style.transform = `translateY(${(p * l.k * 90).toFixed(1)}px)`;
    }
  };
  const ask = () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(place);
  };
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      const s = shots.find((x) => x.el === e.target)!;
      s.live = e.isIntersecting;
      s.el.classList.toggle('is-live', s.live);
    }
    if (!reduce) ask();
  }, { rootMargin: '15% 0px' });
  shots.forEach((s) => io.observe(s.el));
  if (!reduce) addEventListener('scroll', ask, { passive: true });
</script>

<style>
  .shot {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    height: clamp(240px, 29vw, 440px);
    overflow: hidden;
    pointer-events: none;
  }

  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  [data-depth] {
