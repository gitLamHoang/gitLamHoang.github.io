---
// The opening shot of a section: a wide drawn view of a real place on campus at night, like the
// establishing shot before a scene, with the section's heading laid over its foot as a title card.
// Each shot is built in layers that drift at their own speed as it scrolls past, and keeps a little
// life while on screen. It borrows the poster's halftone screens and bloom (#dots, #dotsGold,
// #courses, #tiles, #hatch, #bloom), so it belongs on the home page under the poster.
//
//   library    Research: a lit window in the Quad, the balancing-number recurrence on the board
//   palmdrive  Experience: Palm Drive toward the Quad, traffic as light, the G1 walking it
//   arcade     People: inside the Quad's arcade, people talking under the lanterns
//   tower      Education: the top of Hoover Tower, its carillon ringing under the moon
interface Props {
  kind: 'library' | 'palmdrive' | 'arcade' | 'tower';
}

const { kind } = Astro.props;
const id = (n: string) => `${kind}-${n}`;
const url = (n: string) => `url(#${kind}-${n})`;
const f = (v: number) => +v.toFixed(1);

let seed = [...kind].reduce((a, c) => a * 31 + c.charCodeAt(0), 7) % 2147483646 || 11;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const stars = Array.from({ length: 80 }, () => ({
  x: f(rand() * 1440),
  y: f(rand() * 250),
  r: f(0.5 + rand() * 1.3),
  o: f(0.3 + rand() * 0.6),
  d: f(rand() * 6),
}));
const lens = (x: number, y: number, len: number, w: number) =>
  `M${f(x)} ${f(y)} Q ${f(x + len / 2)} ${f(y - w)} ${f(x + len)} ${f(y)} Q ${f(x + len / 2)} ${f(y + w * 0.6)} ${f(x)} ${f(y)} Z`;
const strokes = Array.from({ length: 26 }, () => ({
  d: lens(rand() * 1500 - 60, 20 + rand() * 240, 120 + rand() * 340, 1.5 + rand() * 4),
  c: rand() > 0.5 ? '#1b2b5a' : '#0a1330',
  o: f(0.25 + rand() * 0.45),
}));

// Mix two hex colours: far things take the haze, near ones the ink.
const mix = (a: string, b: string, t: number) => {
  const p = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
  const [x, y] = [p(a), p(b)];
  return `#${x.map((v, i) => Math.round(v + (y[i] - v) * Math.min(1, Math.max(0, t))).toString(16).padStart(2, '0')).join('')}`;
};

// ---------- Palm Drive: one-point perspective toward the Quad ----------
const VP = { x: 930, y: 232 };
const along = (s: number, ex: number, ey: number) => ({ x: VP.x + s * (ex - VP.x), y: VP.y + s * (ey - VP.y) });
const drivePalms = [0.1, 0.15, 0.21, 0.29, 0.39, 0.52, 0.68, 0.88, 1.12].flatMap((s) =>
  [-1, 1].map((side) => {
    const b = along(s, side < 0 ? 430 : 1430, 440);
    const h = 12 + s * 300;
    return { x: f(b.x), y: f(b.y), h: f(h), k: f(h / 330), c: mix('#1d2c58', '#03081a', s * 1.1), s };
  }),
);
const driveLamps = [0.22, 0.34, 0.5, 0.72, 0.98].flatMap((s) =>
  [-1, 1].map((side) => {
    const b = along(s, side < 0 ? 540 : 1320, 440);
    return { x: f(b.x), y: f(b.y), h: f(6 + s * 96), s };
  }),
);
const dashes = Array.from({ length: 11 }, (_, i) => {
  const s0 = ((i + 0.2) / 11) ** 1.8;
  const s1 = ((i + 0.62) / 11) ** 1.8;
  return { y0: f(VP.y + s0 * 200), y1: f(VP.y + s1 * 200), w: f(0.6 + s1 * 5) };
});

// ---------- the arcade: a corridor of arches receding to one point ----------
const AV = { x: 900, y: 236 };
const AX = (s: number, u: number) => f(AV.x + s * u * 620);
const AY = (s: number, v: number) => f(AV.y + s * (190 - v * 440));
const cols = [0.16, 0.21, 0.28, 0.37, 0.5, 0.68, 0.92, 1.25];
const doors = [0.2, 0.28, 0.38, 0.5, 0.66];
const lanterns = [0.22, 0.34, 0.5, 0.75, 1.08];
const people = [
  { s: 0.3, u: 0.12, n: 1 },
  { s: 0.45, u: -0.32, n: 2 },
  { s: 0.66, u: 0.38, n: 3 },
  { s: 0.82, u: -0.15, n: 2 },
];
// One person: feet at x, y, height h, facing left or right; a raised hand for the one talking.
const person = (x: number, y: number, h: number, face: number, talk: boolean) => {
  const w = h * 0.17;
  return {
    legs: `M${f(x - w * 0.4)} ${f(y)} L${f(x - w * 0.3)} ${f(y - h * 0.42)} M${f(x + w * 0.4)} ${f(y)} L${f(x + w * 0.3)} ${f(y - h * 0.42)}`,
    body: `M${f(x - w)} ${f(y - h * 0.4)} C ${f(x - w * 1.15)} ${f(y - h * 0.64)}, ${f(x - w * 0.8)} ${f(y - h * 0.78)}, ${f(x)} ${f(y - h * 0.78)} C ${f(x + w * 0.8)} ${f(y - h * 0.78)}, ${f(x + w * 1.15)} ${f(y - h * 0.64)}, ${f(x + w)} ${f(y - h * 0.4)} Z`,
    head: { cx: f(x + face * w * 0.12), cy: f(y - h * 0.88), r: f(h * 0.1) },
    arm: talk ? `M${f(x + face * w * 0.7)} ${f(y - h * 0.7)} Q ${f(x + face * w * 1.6)} ${f(y - h * 0.6)} ${f(x + face * w * 1.9)} ${f(y - h * 0.72)}` : '',
    rim: `M${f(x + face * w * 0.5)} ${f(y - h * 0.77)} C ${f(x + face * w * 1.05)} ${f(y - h * 0.7)}, ${f(x + face * w * 1.12)} ${f(y - h * 0.56)}, ${f(x + face * w)} ${f(y - h * 0.42)}`,
    w,
  };
};
const crowd = people.flatMap((g) => {
  const h = 176 * g.s;
  const x0 = AX(g.s, g.u);
  const y0 = AY(g.s, 0);
  return Array.from({ length: g.n }, (_, i) => {
    const off = (i - (g.n - 1) / 2) * h * 0.34;
    const face = g.n === 1 ? 1 : i < g.n / 2 ? 1 : -1;
    return person(x0 + off, y0 + (i % 2) * h * 0.02, h * (1 - (i % 2) * 0.06), face, i === 0);
  });
});

// ---------- the tower: the carillon's bells and the rings they send out ----------
const bells = [700, 760, 820];
---

<div class={`shot shot-${kind}`} data-shot aria-hidden="true">
  <svg viewBox="0 0 1440 420" preserveAspectRatio="xMidYMax slice">
    <defs>
      <linearGradient id={id('sky')} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#0b1430" />
        <stop offset="0.6" stop-color="#121f45" />
        <stop offset="1" stop-color="#1a2b55" />
      </linearGradient>
      <linearGradient id={id('foot')} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#0b1430" stop-opacity="0" />
        <stop offset="1" stop-color="#0b1430" stop-opacity="1" />
      </linearGradient>
      <linearGradient id={id('head')} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#0b1430" stop-opacity="1" />
        <stop offset="1" stop-color="#0b1430" stop-opacity="0" />
      </linearGradient>
      <linearGradient id={id('trailW')} gradientUnits="userSpaceOnUse" x1="0" y1={VP.y} x2="0" y2="420">
        <stop offset="0" stop-color="#fff3d0" stop-opacity="0" />
        <stop offset="1" stop-color="#fff3d0" stop-opacity="0.9" />
      </linearGradient>
      <linearGradient id={id('trailR')} gradientUnits="userSpaceOnUse" x1="0" y1={VP.y} x2="0" y2="420">
        <stop offset="0" stop-color="#ec5a36" stop-opacity="0.15" />
        <stop offset="1" stop-color="#ec5a36" stop-opacity="0.85" />
      </linearGradient>
      <linearGradient id={id('room')} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#c98a3a" />
        <stop offset="1" stop-color="#f0b860" />
      </linearGradient>
      <linearGradient id={id('litR')} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0.3" stop-color="#fff" stop-opacity="0" />
        <stop offset="1" stop-color="#fff" stop-opacity="0.85" />
      </linearGradient>
      <radialGradient id={id('corona')}>
        <stop offset="0.35" stop-color="#efe3c6" stop-opacity="0.18" />
        <stop offset="1" stop-color="#efe3c6" stop-opacity="0" />
      </radialGradient>
      <g id={id('crown')}>
        <path d="M-4 6 C -10 22, -14 34, -20 46 C -12 36, -6 24, 2 8 Z" />
        <path d="M4 6 C 10 22, 12 34, 18 48 C 10 36, 6 24, -2 8 Z" />
        <path d="M0 0 C -30 -12, -58 -4, -74 18 C -50 4, -26 4, 0 6 Z" />
        <path d="M0 0 C 30 -14, 60 -6, 76 16 C 52 2, 28 2, 0 6 Z" />
        <path d="M0 0 C -14 -30, -42 -42, -66 -36 C -40 -26, -20 -14, 0 4 Z" />
        <path d="M0 0 C 16 -30, 44 -40, 68 -32 C 42 -24, 22 -12, 0 4 Z" />
        <path d="M0 0 C -4 -30, 6 -52, 22 -62 C 12 -44, 6 -24, 2 2 Z" />
        <path d="M0 2 C -28 4, -48 22, -54 46 C -36 26, -18 14, 0 8 Z" />
        <path d="M0 2 C 28 4, 50 22, 56 46 C 38 26, 20 14, 0 8 Z" />
      </g>
      {
        kind === 'library' &&
          [0, 1, 2].map((i) => (
            <mask id={id(`chalk${i}`)} maskUnits="userSpaceOnUse" x="700" y="110" width="380" height="200">
              <rect class="wipe" style={`--i:${i}`} x={[700, 700, 866][i]} y={[120, 196, 200][i]} width={[340, 150, 176][i]} height={[56, 90, 60][i]} fill="#fff" />
            </mask>
          ))
      }
      {
        kind === 'library' && (
          <mask id={id('moonlit')}>
            <rect width="1440" height="420" fill={url('litR')} />
          </mask>
        )
      }
    </defs>

    <!-- the sky every shot shares, with its own stars and brushwork -->
    <g data-depth="0.15">
      <rect width="1440" height="420" fill={url('sky')} />
      <g>{strokes.map((b) => <path d={b.d} fill={b.c} opacity={b.o} />)}</g>
      {stars.map((s) => <circle class="star" cx={s.x} cy={s.y} r={s.r} fill="#efe3c6" opacity={s.o} style={`--d:${s.d}s;--o:${s.o}`} />)}
      <path class="meteor" d="M220 40 L300 74" stroke="#efe3c6" stroke-width="1.5" stroke-linecap="round" />
    </g>

    {
      kind === 'palmdrive' && (
        <>
          <g data-depth="0.2">
            <circle cx="1220" cy="80" r="70" fill={url('corona')} />
            <circle cx="1220" cy="80" r="17" fill="#e9dcbc" />
            <circle cx="1220" cy="80" r="17" fill="url(#dots)" opacity="0.35" />
            <path d="M0 218 C 200 196, 420 206, 620 210 S 1000 194, 1200 206 S 1400 214, 1440 212 L1440 240 L0 240 Z" fill="#13214a" />
            <path d="M0 218 C 200 196, 420 206, 620 210 S 1000 194, 1200 206 S 1400 214, 1440 212" fill="none" stroke="#24376b" stroke-width="1.2" />
            <!-- Hoover Tower over the trees, and the Quad at the end of the drive -->
            <rect x="755" y="166" width="13" height="70" fill="#1c2c58" />
            <rect x="762" y="166" width="6" height="70" fill="#26386a" />
            <path d="M753 168 C 753 158, 770 158, 770 168 Z" fill="#a4553f" />
            <rect class="glow-win" x="759" y="172" width="5" height="6" fill="#f0b860" />
            <path d="M761.5 158 L761.5 150" stroke="#efe3c6" stroke-width="1" />
            <rect x="846" y="212" width="168" height="22" fill="#1e2f5c" />
            <rect x="846" y="208" width="168" height="4" fill="#6e3430" />
            <path d="M912 212 L930 196 L948 212 Z" fill="#c99a45" />
            <path d="M910 212.5 L930 195 L950 212.5" fill="none" stroke="#7a3b34" stroke-width="2.4" />
            {Array.from({ length: 12 }, (_, i) => <rect class="glow-win" x={850 + i * 14 + (i > 5 ? 8 : 0)} y="222" width="5" height="8" rx="2" fill="#f0b860" opacity="0.85" />)}
            <ellipse cx="930" cy="222" rx="110" ry="30" fill="url(#bloom)" />
          </g>
          <g data-depth="0.35">
            <rect x="0" y="232" width="1440" height="190" fill="#0d1838" />
            <g stroke="#14234a" stroke-width="1" fill="none">
              {[-900, -500, -200, 200, 500, 900, 1300, 1800, 2300].map((x) => <path d={`M930 232 L${x} 420`} />)}
              {[250, 272, 302, 344, 400].map((y) => <path d={`M0 ${y} L1440 ${y}`} stroke-opacity="0.5" />)}
            </g>
            <path d="M924 232 L936 232 L1290 420 L570 420 Z" fill="#0a1433" />
            <path d="M918 232 L470 420 M942 232 L1390 420" stroke="#1d2d5a" stroke-width="1.2" />
            <path d="M924 232 L570 420 M936 232 L1290 420" stroke="#2a3d72" stroke-width="1.4" />
            {dashes.map((d) => <path d={`M930 ${d.y0} L930 ${d.y1}`} stroke="#d9cba8" stroke-opacity="0.45" stroke-width={d.w} />)}
            <!-- traffic as a long exposure: headlights coming, tail lights going -->
            <path d="M927 234 L740 420 M928 234 L800 420" stroke={url('trailW')} stroke-width="2.2" fill="none" />
            <path d="M933 234 L1080 420 M934 234 L1130 420" stroke={url('trailR')} stroke-width="2.2" fill="none" />
            <g class="cars" fill="none" stroke-linecap="round" stroke-width="3">
              <path class="car in" d="M927 234 L740 420" stroke="#fff3d0" stroke-dasharray="10 230" />
              <path class="car in late" d="M928 234 L800 420" stroke="#fff3d0" stroke-dasharray="10 230" />
              <path class="car out" d="M933 234 L1080 420" stroke="#ff7a52" stroke-dasharray="8 240" />
              <path class="car out late" d="M934 234 L1130 420" stroke="#ff7a52" stroke-dasharray="8 240" />
            </g>
            {
              driveLamps.map((l) => (
                <g>
                  <ellipse cx={l.x} cy={l.y} rx={f(60 * l.s)} ry={f(10 * l.s)} fill="url(#dotsGold)" opacity="0.5" />
                  <path d={`M${l.x} ${l.y} L${l.x} ${f(l.y - l.h)}`} stroke="#060c20" stroke-width={f(0.8 + l.s * 3)} />
                  <circle cx={l.x} cy={f(l.y - l.h)} r={f(34 * l.s + 4)} fill="url(#bloom)" />
                  <rect class="glow-win" x={f(l.x - 3 * l.s - 1)} y={f(l.y - l.h - 6 * l.s - 2)} width={f(6 * l.s + 2)} height={f(8 * l.s + 2)} rx="1" fill="#f6cf86" />
                </g>
              ))
            }
            <!-- the G1, walking up the drive toward the Quad on its route -->
            <path d="M688 330 C 760 300, 840 266, 922 236" fill="none" stroke="#ec5a36" stroke-width="2.2" stroke-dasharray="1.5 7" stroke-linecap="round" />
            <g class="g1" transform="translate(684 334) scale(0.85)">
              <ellipse cx="0" cy="1" rx="10" ry="2.6" fill="#050a1a" opacity="0.6" />
              <rect class="leg l" x="-5" y="-15" width="4" height="15" rx="2" fill="#d9cba8" />
              <rect class="leg r" x="1" y="-15" width="4" height="15" rx="2" fill="#efe3c6" />
              <rect x="-7" y="-30" width="14" height="16" rx="3.5" fill="#efe3c6" />
              <rect x="-4.5" y="-27" width="9" height="9" rx="2" fill="#c9bb98" />
              <rect x="-9.5" y="-28" width="3" height="12" rx="1.5" fill="#d9cba8" />
              <rect x="6.5" y="-28" width="3" height="12" rx="1.5" fill="#efe3c6" />
              <rect x="-5" y="-39" width="10" height="9" rx="3.5" fill="#efe3c6" />
            </g>
          </g>
          <g data-depth="0.6">
            {
              drivePalms.map((p) => (
                <g>
                  <path d={`M${p.x} ${p.y} C ${f(p.x - 4 * p.k)} ${f(p.y - p.h * 0.5)}, ${f(p.x + 7 * p.k)} ${f(p.y - p.h + 34 * p.k)}, ${f(p.x + 2 * p.k)} ${f(p.y - p.h)}`} stroke={p.c} stroke-width={f(8 * p.k + 0.6)} fill="none" stroke-linecap="round" />
                  {p.s > 0.4 && <path d={`M${p.x} ${p.y} C ${f(p.x - 4 * p.k)} ${f(p.y - p.h * 0.5)}, ${f(p.x + 7 * p.k)} ${f(p.y - p.h + 34 * p.k)}, ${f(p.x + 2 * p.k)} ${f(p.y - p.h)}`} stroke="#1d2e5a" stroke-width={f(8 * p.k + 1)} fill="none" stroke-dasharray={`1.4 ${f(6 * p.k + 2)}`} />}
                  <use href={`#${id('crown')}`} fill={p.c} transform={`translate(${f(p.x + 2 * p.k)} ${f(p.y - p.h)}) scale(${p.k})`} />
                  {p.s > 0.5 && <path d={`M${f(p.x + 2 * p.k + 10 * p.k)} ${f(p.y - p.h - 6 * p.k)} C ${f(p.x + 40 * p.k)} ${f(p.y - p.h - 12 * p.k)}, ${f(p.x + 62 * p.k)} ${f(p.y - p.h - 4 * p.k)}, ${f(p.x + 76 * p.k)} ${f(p.y - p.h + 14 * p.k)}`} stroke="#efe3c6" stroke-opacity="0.22" stroke-width="1.2" fill="none" />}
                </g>
              ))
            }
          </g>
        </>
      )
    }

    {
      kind === 'library' && (
        <>
          <g data-depth="0.3">
            <rect x="0" y="0" width="1440" height="420" fill="#1a2a55" />
            <rect x="0" y="0" width="1440" height="420" fill="url(#courses)" opacity="0.55" />
            <rect x="0" y="0" width="1440" height="420" fill="url(#dots)" mask={url('moonlit')} opacity="0.22" />
            <rect x="0" y="0" width="420" height="420" fill="url(#hatch)" opacity="0.35" />
            <!-- the eave above, its tiles catching the moon -->
            <rect x="0" y="0" width="1440" height="30" fill="#6e3430" />
            <rect x="0" y="0" width="1440" height="30" fill="url(#tiles)" />
            <rect x="0" y="30" width="1440" height="4" fill="#3e1a22" />
            <g fill="#0f1a39">{Array.from({ length: 60 }, (_, i) => <rect x={8 + i * 24} y="34" width="8" height="6" />)}</g>
            <!-- pilasters either side of the window -->
            {[598, 1150].map((x) => (
              <g>
                <rect x={x} y="40" width="34" height="380" fill="#1e2f5c" />
                <rect x={x} y="40" width="34" height="380" fill="url(#courses)" opacity="0.5" />
                <path d={`M${x + 33} 40 L${x + 33} 420`} stroke="#efe3c6" stroke-opacity="0.35" stroke-width="1.4" />
                <rect x={x - 4} y="40" width="42" height="8" fill="#2c4078" />
              </g>
            ))}
            <!-- a dark window to the left, the moon on its glass -->
            <path d="M210 330 L210 150 A60 60 0 0 1 330 150 L330 330 Z" fill="#2c4078" />
            <path d="M222 330 L222 152 A48 48 0 0 1 318 152 L318 330 Z" fill="#0c1530" />
            <path d="M222 330 L222 152 A48 48 0 0 1 318 152 L318 330 Z" fill="url(#dots)" opacity="0.12" />
            <path d="M270 104 L270 330 M222 230 L318 230" stroke="#2c4078" stroke-width="4" />
            <path d="M300 120 L240 320" stroke="#efe3c6" stroke-opacity="0.18" stroke-width="10" />
            <!-- the lantern on its bracket, moths at it -->
            <path d="M1250 96 L1250 120 L1226 120 M1236 120 Q 1240 108, 1250 108" fill="none" stroke="#060c20" stroke-width="2.4" />
            <circle cx="1226" cy="140" r="56" fill="url(#bloom)" />
            <path d="M1216 128 L1236 128 L1226 120 Z" fill="#060c20" />
            <rect class="glow-win" x="1219" y="128" width="14" height="18" rx="1.5" fill="#f6cf86" />
            <path d="M1226 128 L1226 146 M1219 137 L1233 137" stroke="#8c6a2d" stroke-width="1" />
            <rect x="1218" y="146" width="16" height="3" fill="#060c20" />
            {[0, 1, 2, 3, 4].map((i) => <circle class="moth" cx="1226" cy="138" r="1.3" fill="#f6dca0" style={`--i:${i}`} />)}
          </g>
          <g data-depth="0.45">
            <!-- the big window: a warm room, the board, someone at it -->
            <ellipse cx="880" cy="250" rx="300" ry="200" fill="url(#bloom)" opacity="0.6" />
            <path d="M672 420 L672 160 A208 208 0 0 1 1088 160 L1088 420 Z" fill="#081029" />
            <path d="M676 420 L676 156 A204 204 0 0 1 1084 156 L1084 420 Z" fill="#2c4078" />
            <path d="M692 420 L692 156 A188 188 0 0 1 1068 156 L1068 420 Z" fill={url('room')} />
            <path d="M692 420 L692 156 A188 188 0 0 1 1068 156 L1068 420 Z" fill="url(#dotsGold)" opacity="0.5" />
            <rect x="716" y="112" width="328" height="196" fill="#5a3e17" />
            <rect x="722" y="118" width="316" height="184" fill="#142440" />
            <rect x="722" y="118" width="316" height="184" fill="url(#dots)" opacity="0.05" />
            <g class="chalk" fill="#efe3c6" font-family="KaTeX_Main, 'Times New Roman', serif">
              <g mask={url('chalk0')}>
                <text x="742" y="158" font-size="25" opacity="0.88">B<tspan font-style="italic">(n)</tspan> = 6B<tspan font-style="italic">(n</tspan>−1<tspan font-style="italic">)</tspan> − B<tspan font-style="italic">(n</tspan>−2<tspan font-style="italic">)</tspan></text>
                <path d="M742 168 C 820 164, 900 166, 1000 162" stroke="#efe3c6" stroke-opacity="0.5" stroke-width="1.6" fill="none" />
              </g>
              <g mask={url('chalk1')}>
                <path d="M752 206 L746 206 L746 270 L752 270 M818 206 L824 206 L824 270 L818 270" stroke="#efe3c6" stroke-opacity="0.8" stroke-width="2" fill="none" />
                <text x="760" y="232" font-size="22" opacity="0.8">6</text>
