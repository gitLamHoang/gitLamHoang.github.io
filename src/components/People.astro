---
import { Image } from 'astro:assets';
import { people } from '../data/profile';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/people/*.jpg', { eager: true });
const photo = (slug: string) => photos[`../assets/people/${slug}.jpg`].default;
---

<ul class="people">
  {
    people.map((p) => (
      <li>
        <figure>
          <div class="photo">
            <Image
              src={photo(p.photo)}
              alt={`Harvey Phan with ${p.name}`}
              widths={[360, 540, 720]}
              sizes="(max-width: 700px) 100vw, 30vw"
              style={`object-position:${p.focus}`}
            />
          </div>
          <figcaption>
            <span class="heading-6">{p.name}</span>
            <span class="body-6 text-2">{p.title}</span>
          </figcaption>
        </figure>
      </li>
    ))
  }
</ul>

<style>
  /* Three portraits at staggered heights; real photographs, cropped decisively. */
  .people {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-300);
    align-items: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li:nth-child(2) {
    margin-top: var(--space-800);
  }

  li:nth-child(3) {
    margin-top: var(--space-400);
  }

  figure {
    margin: 0;
  }

  .photo {
    overflow: hidden;
    padding: var(--space-75);
    border: 1.5px solid rgb(217 164 65 / 0.7);
    background: var(--surface-1);
  }

  .photo img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  figcaption {
    display: grid;
    gap: var(--space-25);
    padding-top: var(--space-200);
  }

  @media (max-width: 700px) {
    .people {
      grid-template-columns: minmax(0, 1fr);
    }

    li {
      margin-top: 0 !important;
    }
  }
</style>
