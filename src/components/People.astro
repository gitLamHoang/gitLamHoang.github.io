---
import { Image } from 'astro:assets';
import { people } from '../data/profile';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/people/*.jpg', { eager: true });
const photo = (slug: string) => photos[`../assets/people/${slug}.jpg`].default;
---

<ul class="people">
  {
    people.map((p) => (
      <li>
        <figure>
          <div class="photo">
            <Image
              src={photo(p.photo)}
              alt={`Harvey Phan with ${p.name}`}
              widths={[360, 540, 720]}
              sizes="(max-width: 700px) 82vw, 30vw"
              style={`object-position:${p.focus}`}
            />
          </div>
          <figcaption>
            <span class="name">{p.name}</span>
            <span class="title">{p.title}</span>
          </figcaption>
        </figure>
      </li>
    ))
  }
</ul>

<style>
  /* Three portraits in one row, set at staggered heights. */
  .people {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 32px);
    align-items: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li:nth-child(2) {
    margin-top: clamp(32px, 6vw, 96px);
  }

  li:nth-child(3) {
    margin-top: clamp(16px, 3vw, 48px);
  }

  figure {
    margin: 0;
  }

  .photo {
    background: var(--surface);
  }

  .photo img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  figcaption {
    display: grid;
    gap: 2px;
    margin-top: 16px;
  }

  .name {
    font-size: var(--step-lead);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .title {
    color: var(--muted);
  }

  @media (max-width: 700px) {
    .people {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }

    li {
      width: 82%;
      margin-top: 0 !important;
    }

    li:nth-child(2) {
      justify-self: end;
    }
  }
</style>
