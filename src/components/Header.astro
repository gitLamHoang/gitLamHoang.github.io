---
import { contact, person } from '../data/profile';

const nav = [
  { label: 'Work', href: '/#work' },
  { label: 'Research', href: '/#research' },
  { label: 'Experience', href: '/#experience' },
  { label: 'People', href: '/#people' },
];
// On the home page the bar starts clear over the film, and the giant name stands in for the wordmark.
const home = Astro.url.pathname === '/';
---

<header class="site-header" data-header data-home={home ? '' : undefined}>
  <div class="bar wrap">
    <a class="wordmark" href="/" aria-label={`${person.siteTitle}, home`}>{person.siteTitle}</a>
    <nav aria-label="Main">
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href={contact.resume} download="Harvey_Phan_Resume.pdf">Resume</a></li>
      </ul>
    </nav>
    <button type="button" class="palette-btn" data-palette-open aria-label="Open the command palette" aria-keyshortcuts="Meta+K Control+K">
      <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path d="M13 13 L17.5 17.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
      <span class="pb-label">Jump to</span>
      <span class="pb-menu">Menu</span>
      <kbd data-kbd>⌘K</kbd>
    </button>
  </div>
</header>

<script>
  // Show Ctrl K instead of ⌘K off Apple platforms.
  if (!/Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent)) {
    for (const k of document.querySelectorAll('[data-kbd]')) k.textContent = 'Ctrl K';
  }

  // Home: the bar turns solid once the film's first screen has scrolled away.
  const header = document.querySelector<HTMLElement>('[data-header][data-home]');
  const mark = document.querySelector('[data-film-end]');
  if (header && mark) {
    new IntersectionObserver(([e]) => header.classList.toggle('is-solid', e.boundingClientRect.top < 0 && !e.isIntersecting), {
      threshold: 0,
    }).observe(mark);
  }
</script>

<style>
  .site-header {
    --header-h: 64px;
    view-transition-name: site-header;
    position: sticky;
    top: 0;
    z-index: 30;
    height: var(--header-h);
    background: var(--bg);
    transition: background-color var(--dur-ui) ease;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: clamp(12px, 2.4vw, 36px);
    height: 100%;
  }

  .wordmark {
    margin-right: auto;
    font-size: var(--step-small);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: opacity var(--dur-ui) ease;
  }

  nav ul {
    display: flex;
    gap: clamp(12px, 2.2vw, 32px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a,
  .palette-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--step-small);
    font-weight: 500;
    text-decoration: none;
  }

  nav a {
    color: var(--muted);
    transition: color var(--dur-ui) ease;
  }

  .palette-btn {
    gap: 10px;
    padding: 0 14px;
    border: 0;
    background: var(--surface-2);
    cursor: pointer;
    transition:
      background-color var(--dur-ui) ease,
      transform var(--dur-press) var(--ease-out);
  }

  .palette-btn:active {
    transform: scale(0.97);
  }

  .palette-btn svg {
    width: 16px;
    height: 16px;
  }

  .palette-btn kbd {
    font: inherit;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .pb-menu {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    nav a:hover {
      color: var(--ink);
    }

    .palette-btn:hover {
      background: #2a2f37;
    }
  }

  /* Home, over the film: clear bar, no wordmark, until the first screen has passed. */
  .site-header[data-home] {
    margin-bottom: calc(-1 * var(--header-h));
    background: transparent;
  }

  .site-header[data-home] .wordmark {
    opacity: 0;
    pointer-events: none;
  }

  .site-header[data-home] nav a {
    color: var(--ink);
  }

  .site-header[data-home].is-solid {
    background: var(--bg);
  }

  .site-header[data-home].is-solid .wordmark {
    opacity: 1;
    pointer-events: auto;
  }

  .site-header[data-home].is-solid nav a {
    color: var(--muted);
  }

  @media (max-width: 760px) {
    nav {
      display: none;
    }

    .pb-label,
    .palette-btn kbd {
      display: none;
    }

    .pb-menu {
      display: inline;
    }
  }
</style>
