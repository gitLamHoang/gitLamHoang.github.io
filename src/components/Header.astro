---
import ThemeToggle from './ThemeToggle.astro';
import { contact, person } from '../data/profile';

const nav = [
  { label: 'Work', href: '/#work' },
  { label: 'Research', href: '/#research' },
  { label: 'Experience', href: '/#experience' },
  { label: 'People', href: '/#people' },
];
---

<div class="header-shell">
<header class="site-header wrap">
  <a class="wordmark" href="/" aria-label={`${person.siteTitle}, home`}>
    <svg class="wordmark-glyph" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"></circle>
      <path d="M9 7.5 L17 12 L9 16.5 Z" fill="var(--pen)"></path>
    </svg>
    <span>{person.siteTitle}</span>
  </a>
  <nav aria-label="Main">
    <ul>
      {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      <li><a href={contact.resume} download="Harvey_Phan_Resume.pdf">Resume<span class="pdf">&nbsp;(PDF)</span></a></li>
    </ul>
  </nav>
  <ThemeToggle />
</header>
  <!-- The page as a route: a red line fills as you scroll, with the robot marker at its tip. -->
  <div class="route-progress" aria-hidden="true"><span class="line"></span><span class="tip"></span></div>
</div>

<style>
  .header-shell {
    view-transition-name: site-header;
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--paper) 84%, transparent);
    backdrop-filter: blur(10px) saturate(1.15);
    -webkit-backdrop-filter: blur(10px) saturate(1.15);
    border-bottom: 1px solid color-mix(in srgb, var(--grid) 80%, transparent);
  }

  .route-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 3px;
    pointer-events: none;
  }

  .route-progress .line {
    position: absolute;
    inset: 0;
    background: var(--pen);
    transform-origin: 0 50%;
    transform: scaleX(0);
    animation: route-grow linear both;
    animation-timeline: scroll(root);
  }

  .route-progress .tip {
    position: absolute;
    top: -4px;
    left: 0;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--pen);
    box-shadow: 0 0 0 3px var(--paper);
    animation: route-tip linear both;
    animation-timeline: scroll(root);
  }

  @keyframes route-grow {
    to {
      transform: scaleX(1);
    }
  }

  @keyframes route-tip {
    to {
      transform: translateX(calc(100vw - 14px));
    }
  }

  @supports not (animation-timeline: scroll()) {
    .route-progress {
      display: none;
    }
  }

  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 24px;
    padding-block: 12px;
  }

  nav {
    margin-left: auto;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-family: var(--font-ui);
    font-size: 1.3125rem;
    font-weight: 600;
    letter-spacing: 0.005em;
    text-decoration: none;
  }

  .wordmark-glyph {
    width: 26px;
    height: 26px;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 22px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-ui);
    font-size: 1.0625rem;
    font-weight: 500;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  nav a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  @media (max-width: 640px) {
    /* Two-row header on phones: let it scroll away instead of covering the page. */
    .header-shell {
      position: static;
    }

    .site-header {
      padding-block: 12px 4px;
    }

    /* Wordmark and theme toggle share the first row; the links get their own. */
    .site-header :global(.theme-toggle) {
      margin-left: auto;
    }

    nav {
      order: 3;
      width: 100%;
      margin-left: 0;
    }

    nav ul {
      gap: 0 16px;
      font-size: 1rem;
    }

    .pdf {
      display: none;
    }
  }
</style>
