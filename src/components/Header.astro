---
import ThemeToggle from './ThemeToggle.astro';
import { contact, person } from '../data/profile';

const nav = [
  { label: 'Work', href: '/#work' },
  { label: 'Research', href: '/#research' },
  { label: 'Experience', href: '/#experience' },
  { label: 'People', href: '/#people' },
];
---

<div class="header-shell">
<header class="site-header wrap">
  <a class="wordmark" href="/" aria-label={`${person.siteTitle}, home`}>
    <svg class="wordmark-glyph" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"></circle>
      <path d="M9 7.5 L17 12 L9 16.5 Z" fill="var(--pen)"></path>
    </svg>
    <span>{person.siteTitle}</span>
  </a>
  <nav aria-label="Main">
    <ul>
      {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      <li><a href={contact.resume} download="Harvey_Phan_Resume.pdf">Resume<span class="pdf">&nbsp;(PDF)</span></a></li>
    </ul>
  </nav>
  <button type="button" class="palette-btn" data-palette-open aria-label="Open the command palette" aria-keyshortcuts="Meta+K Control+K">
    <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path d="M13 13 L17.5 17.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
    <span class="pb-label">Jump to</span>
    <kbd data-kbd>⌘K</kbd>
  </button>
  <ThemeToggle />
</header>
  <!-- The page as a route: a red line fills as you scroll, with the robot marker at its tip. -->
  <div class="route-progress" aria-hidden="true" data-route-progress><span class="line"></span><span class="tip"></span></div>
</div>

<script>
  // Show Ctrl+K instead of ⌘K off Apple platforms.
  if (!/Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent)) {
    for (const k of document.querySelectorAll('[data-kbd]')) k.textContent = 'Ctrl K';
  }
</script>

<script>
  // Driven by scroll position in JavaScript so it moves in every browser, not only those with
  // CSS scroll-driven animations. Hidden until the script runs.
  const bar = document.querySelector<HTMLElement>('[data-route-progress]');
  if (bar) {
    const root = document.documentElement;
    // One style write per scroll event; browsers already align scroll events to frames.
    const update = () => {
      const max = root.scrollHeight - window.innerHeight;
      const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      bar.style.setProperty('--p', p.toFixed(4));
    };
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    new ResizeObserver(update).observe(document.body);
    update();
    bar.dataset.ready = '';
  }
</script>

<style>
  .header-shell {
    view-transition-name: site-header;
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--paper) 84%, transparent);
    backdrop-filter: blur(10px) saturate(1.15);
    -webkit-backdrop-filter: blur(10px) saturate(1.15);
    border-bottom: 1px solid color-mix(in srgb, var(--grid) 80%, transparent);
  }

  .route-progress {
    --p: 0;
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 3px;
    pointer-events: none;
    display: none;
  }

  .route-progress[data-ready] {
    display: block;
  }

  .route-progress .line {
    position: absolute;
    inset: 0;
    background: var(--pen);
    transform-origin: 0 50%;
    transform: scaleX(var(--p));
  }

  .route-progress .tip {
    position: absolute;
    top: -4px;
    left: 0;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--pen);
    box-shadow: 0 0 0 3px var(--paper);
    transform: translateX(calc(var(--p) * (100vw - 14px)));
  }

  .palette-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 8px 0 12px;
    border: 1.5px solid var(--grid);
    border-radius: var(--radius);
    background: transparent;
    color: var(--ink);
    font-family: var(--font-ui);
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
  }

  .palette-btn:hover {
    border-color: var(--ink);
  }

  .palette-btn svg {
    width: 16px;
    height: 16px;
    color: var(--graphite);
  }

  .palette-btn kbd {
    padding: 1px 6px;
    border: 1px solid var(--grid);
    border-bottom-width: 2px;
    border-radius: 4px;
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--graphite);
    background: var(--paper);
  }

  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 24px;
    padding-block: 12px;
  }

  nav {
    margin-left: auto;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-family: var(--font-ui);
    font-size: 1.3125rem;
    font-weight: 600;
    letter-spacing: 0.005em;
    text-decoration: none;
  }

  .wordmark-glyph {
    width: 26px;
    height: 26px;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 22px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-ui);
    font-size: 1.0625rem;
    font-weight: 500;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  nav a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  @media (max-width: 640px) {
    /* Two-row header on phones: let it scroll away instead of covering the page. */
    .header-shell {
      position: static;
    }

    .site-header {
      padding-block: 12px 4px;
    }

    /* Wordmark and theme toggle share the first row; the links get their own. */
    .site-header :global(.theme-toggle) {
      margin-left: auto;
    }

    nav {
      order: 3;
      width: 100%;
      margin-left: 0;
    }

    nav ul {
      gap: 0 16px;
      font-size: 1rem;
    }

    .pdf {
      display: none;
    }

    .palette-btn {
      margin-left: auto;
      min-width: 44px;
      justify-content: center;
      padding: 0;
    }

    .palette-btn .pb-label,
    .palette-btn kbd {
      display: none;
    }

    .site-header :global(.theme-toggle) {
      margin-left: 0;
    }
  }
</style>
