---
// A compact bar that floats off the top edge, sized to its content, on a translucent blurred surface.
// On phones it opens a full-height panel whose links arrive one after another.
import Icon from './Icon.astro';
import { contact, person } from '../data/profile';

const path = Astro.url.pathname;
const home = path === '/';
const nav = [
  { label: 'Work', href: '/#work', section: 'work', current: path.startsWith('/work/') },
  { label: 'Research', href: '/#research', section: 'research', current: false },
  { label: 'Experience', href: '/#experience', section: 'experience', current: false },
  { label: 'People', href: '/#people', section: 'people', current: false },
  { label: 'Lab', href: '/lab/', section: '', current: path.startsWith('/lab') },
];
---

<header class="site-nav" data-nav data-home={home ? '' : undefined}>
  <nav class="pill" aria-label="Main">
    <a class="brand title-4" href="/" aria-label={`${person.siteTitle}, home`}>{person.name}</a>
    <ul class="links">
      {
        nav.map((n) => (
          <li>
            <a class="title-4" href={n.href} data-section={n.section || undefined} aria-current={n.current ? 'page' : undefined}>
              {n.label}
            </a>
          </li>
        ))
      }
    </ul>
    <button type="button" class="icon-btn" data-palette-open aria-label="Search the site" aria-keyshortcuts="Meta+K Control+K">
      <Icon name="search" />
    </button>
    <a class="btn btn-sm btn-primary cv" href={contact.resume} download="Harvey_Phan_Resume.pdf">Resume</a>
    <button type="button" class="icon-btn toggle" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label="Open the menu">
      <span class="bars" aria-hidden="true"><span></span><span></span></span>
    </button>
  </nav>

  <div class="panel-menu" id="mobile-menu" data-menu hidden>
    <ul>
      {
        nav.map((n, i) => (
          <li style={`--i:${i}`}>
            <a class="heading-4" href={n.href}>{n.label}</a>
          </li>
        ))
      }
      <li style={`--i:${nav.length}`}>
        <a class="heading-4" href={`mailto:${contact.email}`}>Email me</a>
      </li>
    </ul>
    <a class="btn btn-primary menu-cv" href={contact.resume} download="Harvey_Phan_Resume.pdf"><Icon name="download" />Download resume</a>
  </div>
</header>

<script>
  const root = document.querySelector<HTMLElement>('[data-nav]');
  if (root) {
    // Mobile menu: a full-height panel; the icon morphs between its two states.
    const toggle = root.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
    const menu = root.querySelector<HTMLElement>('[data-menu]')!;
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close the menu' : 'Open the menu');
      root.classList.toggle('is-open', open);
      if (open) {
        menu.hidden = false;
        requestAnimationFrame(() => menu.classList.add('is-in'));
        menu.querySelector('a')?.focus();
      } else {
        menu.classList.remove('is-in');
        menu.hidden = true;
      }
      document.documentElement.style.overflow = open ? 'hidden' : '';
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    matchMedia('(min-width: 768px)').addEventListener('change', (m) => m.matches && setOpen(false));

    // Home: the link for the section in view is marked current.
    if (root.hasAttribute('data-home')) {
      const links = [...root.querySelectorAll<HTMLAnchorElement>('.links a[data-section]')];
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            for (const a of links) {
              if (a.dataset.section === e.target.id) a.setAttribute('aria-current', 'location');
              else a.removeAttribute('aria-current');
            }
          }
        },
        { rootMargin: '-45% 0px -50% 0px' },
      );
      for (const a of links) {
        const s = document.getElementById(a.dataset.section!);
        if (s) io.observe(s);
      }
    }
  }
</script>

<style>
  /* No view-transition name here: it would make the bar its own backdrop root, and the blur
     would stop seeing the page behind it. */
  .site-nav {
    position: fixed;
    top: var(--space-200);
    left: 0;
    right: 0;
    z-index: 40;
    display: flex;
    justify-content: center;
    padding-inline: var(--space-200);
    pointer-events: none;
  }

  .pill {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: var(--space-50);
    max-width: 100%;
    padding: var(--space-50) var(--space-50) var(--space-50) var(--space-200);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background: rgb(24 24 24 / 0.72);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    backdrop-filter: blur(16px) saturate(140%);
  }

  .brand {
    margin-right: var(--space-100);
    white-space: nowrap;
    text-decoration: none;
  }

  .links {
    display: flex;
    gap: var(--space-25);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: var(--space-75) var(--space-100);
    border-radius: var(--radius-full);
    color: var(--text-2);
    text-decoration: none;
    transition:
      color var(--dur-fade) var(--ease),
      background-color var(--dur-fade) var(--ease);
  }

  .links a[aria-current] {
    color: var(--text);
    background: var(--surface-3);
  }

  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--text-2);
    cursor: pointer;
    transition:
      color var(--dur-fade) var(--ease),
      background-color var(--dur-fade) var(--ease),
      transform var(--dur-fade) var(--ease);
  }

  .icon-btn :global(.icon) {
    width: 18px;
    height: 18px;
  }

  .icon-btn:active {
    transform: scale(0.98);
  }

  .cv {
    margin-left: var(--space-50);
  }

  @media (hover: hover) and (pointer: fine) {
    .links a:hover,
    .icon-btn:hover {
      color: var(--text);
      background: var(--surface-3);
    }
  }

  /* ---------- the menu toggle: two lines that become a cross ---------- */

  .toggle {
    display: none;
    color: var(--text);
  }

  .bars {
    position: relative;
    width: 18px;
    height: 12px;
  }

  .bars span {
    position: absolute;
    left: 0;
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform var(--dur-move) var(--ease);
  }

  .bars span:first-child {
    top: 2px;
  }

  .bars span:last-child {
    top: 8px;
  }

  .is-open .bars span:first-child {
    transform: translateY(3px) rotate(45deg);
  }

  .is-open .bars span:last-child {
    transform: translateY(-3px) rotate(-45deg);
  }

  /* ---------- the phone panel ---------- */

  .panel-menu {
    pointer-events: auto;
    position: fixed;
    inset: 0;
    z-index: -1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-900) var(--space-300) var(--space-400);
    background: rgb(0 0 0 / 0.9);
    -webkit-backdrop-filter: blur(24px);
    backdrop-filter: blur(24px);
  }

  .panel-menu[hidden] {
    display: none;
  }

  .panel-menu ul {
    display: grid;
    gap: var(--space-75);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .panel-menu a:not(.btn) {
    display: flex;
    align-items: center;
    min-height: 48px;
    text-decoration: none;
  }

  .panel-menu li {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity var(--dur-move) var(--ease),
      transform var(--dur-move) var(--ease);
    transition-delay: calc(var(--i) * 60ms);
  }

  .panel-menu.is-in li {
    opacity: 1;
    transform: none;
  }

  .menu-cv {
    width: 100%;
  }

  @media (max-width: 767px) {
    .links,
    .cv,
    .icon-btn[data-palette-open] {
      display: none;
    }

    .toggle {
      display: inline-grid;
    }

    .site-nav {
      justify-content: stretch;
    }

    .pill {
      width: 100%;
      justify-content: space-between;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel-menu li {
      transform: none;
      transition-property: opacity;
      transition-delay: 0ms;
    }

    .bars span {
      transition: none;
    }
  }
</style>
